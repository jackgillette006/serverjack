#!/usr/bin/env bash
# serverjack bootstrap -- installs a specific released version with no git
# checkout required. Rendered from this template by scripts/build-release.sh,
# which fills in the three @...@ placeholders below and publishes the result
# as the "serverjack-bootstrap.sh" asset on each GitHub release.
#
#   curl -fsSL https://github.com/jackgillette006/serverjack/releases/latest/download/serverjack-bootstrap.sh | bash
#
# Also works downloaded and run directly:
#   curl -fsSLO https://github.com/jackgillette006/serverjack/releases/latest/download/serverjack-bootstrap.sh
#   less serverjack-bootstrap.sh   # inspect it first
#   bash serverjack-bootstrap.sh
#
# What it does:
#   1. Refuses to run as root, and refuses if this account already has a
#      serverjack install it does not recognize as its own (a git checkout,
#      or an existing managed install) -- no silent takeover.
#   2. Downloads the release archive embedded below (or the one named by
#      --version), verifies its sha256 against the digest embedded below (or,
#      for --version, against that release's own SHA256SUMS).
#   3. Extracts it to ~/.local/share/serverjack/releases/<version>/, points
#      ~/.local/share/serverjack/current at it (atomic symlink swap), and
#      writes ~/.local/share/serverjack/install.json recording the channel.
#   4. Execs that release's bin/serverjack-setup with your arguments and
#      terminal intact. That is the guided part -- prerequisites, Tailscale
#      install/sign-in, who may reach it, one-time root steps, all asked on
#      /dev/tty -- and it finishes by running install.sh itself: ttyd/fzf
#      downloads, the env file, the systemd user units, tailscale serve.
#
# Flags:
#   --version X.Y.Z   install this exact released version instead of the one
#                      this bootstrap was built for (downloads that tag's
#                      archive and SHA256SUMS and verifies against them)
# Any other flag (--no-serve, --tcp, --unix, --port, --https-port, --title,
# ...) is passed straight through to serverjack-setup, which answers the
# matching guided question with it instead of asking (see `bash
# bin/serverjack-setup --help` after install, or the README, for the full
# list) and forwards it on to install.sh in turn.
#
# No confirmation prompt of ITS OWN: refuse_if_existing_install() below is
# what stands between this stage and silently replacing something, and it
# fails closed with no prompt to bypass -- a fresh install here only ever
# ADDS new, not-yet-existing files. serverjack-setup, which runs right
# after, is the interactive part: it prompts on /dev/tty for what install.sh
# itself never asks (Tailscale, who may reach it, the one-time root steps),
# unless flags above already answered a given question -- see its own
# header for exactly what and why. Read this script first (the "download
# and inspect" instructions above) if you want to review it before it runs.
#
# Everything below is inside a function; main() is the LAST line of this
# file, called only after every function is fully defined. That is
# deliberate: if this script is piped into bash and the download is cut off
# partway through, bash hits an unterminated function body and aborts with a
# syntax error before main() is ever reached -- a truncated transfer cannot
# half-run an install.
set -Eeuo pipefail

EMBEDDED_VERSION="@VERSION@"
EMBEDDED_ARCHIVE_URL="@ARCHIVE_URL@"
EMBEDDED_ARCHIVE_SHA256="@ARCHIVE_SHA256@"
DEFAULT_BASE_URL="https://github.com/jackgillette006/serverjack/releases/download"

say() { printf '\033[1m%s\033[0m\n' "$*"; }

usage() {
  # Not `sed`-extracted from this file's own header: piped in as `curl | bash`,
  # $0 is just "bash", not a readable path to this script.
  cat <<'EOF'
serverjack-bootstrap.sh [--version X.Y.Z] [install.sh flags...]

  --version X.Y.Z   install this exact released version (default: the one
                     this bootstrap was built for)

Any other flag is passed through to the installed release's serverjack-setup,
which answers the matching guided question with it instead of asking
(--no-serve, --tcp, --unix, --port N, --https-port N, --title NAME, ...),
then forwards it on to install.sh in turn. See the top of this file, or the
README, for what those do.
EOF
  exit "${1:-0}"
}

# Every network fetch goes through here. HTTPS-only and no redirect may leave
# it -- UNLESS SERVERJACK_RELEASE_BASE_URL is set AND literally starts with
# "http://" (a test/enterprise-mirror hook, see the container test in
# tests/managed-install.sh and CONTRIBUTING.md); that is an explicit,
# unambiguous opt-in into plain HTTP the operator set themselves, so an
# internal mirror without TLS is their call, not a default weakened here.
# Merely SETTING the variable used to drop the pin regardless of its own
# scheme, including an https:// mirror -- which meant a compromised or
# misconfigured https mirror could 302 a download down to plain http and
# curl would silently follow, exactly what --proto-redir exists to refuse.
fetch() {
  if [[ ${SERVERJACK_RELEASE_BASE_URL:-} == http://* ]]; then
    curl -fsSL "$@"
  else
    curl -fsSL --proto '=https' --proto-redir '=https' "$@"
  fi
}

refuse_root() {
  if [[ $(id -u) -eq 0 ]]; then
    cat >&2 <<'EOF'
Do not run this as root.

serverjack installs entirely inside an ordinary user account (systemd --user
units, ~/.local, ~/.config) and never needs root itself, beyond two one-time
steps install.sh prints for you to paste with sudo afterwards. Running it as
root would create a root-owned terminal service -- the opposite of what this
is for.

Run it as the account that should own serverjack instead, e.g. log in as
that user (or `su - youruser`) and re-run:
  curl -fsSL https://github.com/jackgillette006/serverjack/releases/latest/download/serverjack-bootstrap.sh | bash
EOF
    exit 1
  fi
}

# "This phase: refuse with instructions; phase C may add migration" -- so this
# deliberately does not try to reconcile or move an existing install.
#
# The one exception is install.json carrying "state": "installing" -- that
# means a PREVIOUS bootstrap run staged a release and handed off to its
# install.sh, which then failed (a bad download, a transient network error,
# ttyd/fzf unreachable, ...) before ever clearing that marker (install.sh
# does that itself once it actually succeeds -- see its own comment on this).
# That is a half-finished install, not an existing one: refusing it would
# leave the account stuck forever, since nothing else can complete or clear
# it. Treat it as resumable and let this run redo the whole thing.
refuse_if_existing_install() {
  local share="$HOME/.local/share/serverjack"
  if [[ -f "$share/install.json" ]]; then
    local state
    state=$(python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("state",""))
except Exception:
    print("")' < "$share/install.json" 2>/dev/null || true)
    if [[ $state == installing ]]; then
      say "Resuming an install that did not finish last time (install.sh failed) -- retrying."
      return 0
    fi
    cat >&2 <<EOF
serverjack is already installed here as a managed release ($share).

This bootstrap only performs a fresh install and refuses to silently take
over an existing one. To update, roll back or inspect it instead:
  ~/.local/bin/serverjack-ctl status
  ~/.local/bin/serverjack-ctl update
EOF
    exit 3
  fi
  local unit="$HOME/.config/systemd/user/serverjack.service"
  if [[ -f $unit ]]; then
    cat >&2 <<EOF
serverjack already has a user systemd unit installed here ($unit), but no
$share/install.json -- most likely an existing git-checkout install (or one
this bootstrap does not recognize). Refusing to install a second, conflicting
copy.

If this is a git checkout you want to keep using, update it directly:
  cd <that checkout> && git pull --ff-only && bash install.sh

If you want to replace it with a managed release install, remove the
existing one first (its own uninstall.sh, or serverjack-ctl uninstall for a
managed install), then re-run this bootstrap.
EOF
    exit 3
  fi
}

# Resolves what to install into TARGET_VERSION / TARGET_ARCHIVE_URL /
# TARGET_SUMS_URL / TARGET_SHA256 (the last is empty when it must instead be
# looked up in a downloaded SHA256SUMS, i.e. whenever --version names a
# release other than the one this bootstrap was built for).
resolve_target() {
  local base_url=${SERVERJACK_RELEASE_BASE_URL:-$DEFAULT_BASE_URL}
  base_url=${base_url%/}
  if [[ -n $OPT_VERSION ]]; then
    TARGET_VERSION=$OPT_VERSION
    TARGET_ARCHIVE_URL="$base_url/v$TARGET_VERSION/serverjack-$TARGET_VERSION.tar.gz"
    TARGET_SUMS_URL="$base_url/v$TARGET_VERSION/SHA256SUMS"
    TARGET_SHA256=""
  else
    TARGET_VERSION=$EMBEDDED_VERSION
    TARGET_SUMS_URL="$base_url/v$TARGET_VERSION/SHA256SUMS"
    TARGET_SHA256=$EMBEDDED_ARCHIVE_SHA256
    if [[ -n ${SERVERJACK_RELEASE_BASE_URL:-} ]]; then
      # A mirror override still applies to the embedded version -- construct
      # its URL the same way instead of trusting the GitHub URL baked in above.
      TARGET_ARCHIVE_URL="$base_url/v$TARGET_VERSION/serverjack-$TARGET_VERSION.tar.gz"
    else
      TARGET_ARCHIVE_URL=$EMBEDDED_ARCHIVE_URL
    fi
  fi
  [[ -n $TARGET_VERSION && -n $TARGET_ARCHIVE_URL ]] \
    || { echo "internal error: could not resolve a release to install" >&2; exit 1; }
}

# Downloads the archive to a fresh temp dir and verifies its sha256, either
# against the pinned TARGET_SHA256 or, when that is empty, against a freshly
# downloaded SHA256SUMS (only reached for an explicit --version, exactly like
# install.sh's own verify() falls back to a project sums file). Sets
# ARCHIVE_TMP and DOWNLOAD_TMPDIR (the caller removes DOWNLOAD_TMPDIR).
download_and_verify() {
  local tmp; tmp=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
  DOWNLOAD_TMPDIR=$tmp
  # Belt and braces against every early `exit 1` below leaking this
  # directory (and the archive in it) on a failed/corrupted/truncated
  # download -- the caller's own `rm -rf "$DOWNLOAD_TMPDIR"` after a SUCCESS
  # only ever ran on the success path. Double-quoted so $tmp is substituted
  # now, not when the trap fires (it is `local` to this function, and would
  # be unset by the time the whole script actually exits otherwise).
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  ARCHIVE_TMP="$tmp/$(basename "$TARGET_ARCHIVE_URL")"

  say "Downloading serverjack $TARGET_VERSION"
  echo "  $TARGET_ARCHIVE_URL"
  if ! fetch -o "$ARCHIVE_TMP" "$TARGET_ARCHIVE_URL"; then
    echo "download failed: $TARGET_ARCHIVE_URL" >&2
    echo "nothing was installed." >&2
    exit 1
  fi
  # A failed/partial transfer that curl still exits 0 on (rare, but -f alone
  # doesn't cover every case) must not be treated as a real archive.
  [[ -s $ARCHIVE_TMP ]] || { echo "downloaded archive is empty: $TARGET_ARCHIVE_URL" >&2; exit 1; }

  local want=$TARGET_SHA256
  if [[ -z $want ]]; then
    local sums_tmp="$tmp/SHA256SUMS"
    if ! fetch -o "$sums_tmp" "$TARGET_SUMS_URL"; then
      echo "could not download $TARGET_SUMS_URL to verify the archive -- refusing to install an unverified download" >&2
      exit 1
    fi
    want=$(awk -v f="$(basename "$ARCHIVE_TMP")" '$2==f{print $1}' "$sums_tmp" | head -1)
    [[ -n $want ]] || { echo "$(basename "$ARCHIVE_TMP") is not listed in $TARGET_SUMS_URL -- refusing to install" >&2; exit 1; }
  fi
  local got
  got=$(sha256sum "$ARCHIVE_TMP" | awk '{print $1}')
  if [[ $got != "$want" ]]; then
    echo "checksum mismatch for $(basename "$ARCHIVE_TMP"): got $got, want $want -- refusing to install a corrupted or tampered archive" >&2
    exit 1
  fi
  say "Checksum OK ($got)"
}

# Extracts ARCHIVE_TMP to ~/.local/share/serverjack/releases/<version>/ and
# atomically swaps "current" to point at it. Sets RELEASE_DIR. Writes
# install.json with "state": "installing" -- this process is about to exec
# install.sh (see main()), which replaces it outright and so has no way to
# come back afterward and confirm success itself; install.sh clears that
# marker once it actually finishes (see the matching comment there).
# refuse_if_existing_install() treats the marker as a resumable half-install
# rather than an existing one, so a failed install.sh run (bad ttyd/fzf
# download, killed midway, ...) can always be completed by a second
# `curl | bash` instead of leaving the account permanently stuck.
stage_and_activate() {  # $@ = install_args to persist (see write_install_json/finding 4)
  local share="$HOME/.local/share/serverjack"
  local releases="$share/releases"
  RELEASE_DIR="$releases/$TARGET_VERSION"
  mkdir -p "$releases"
  # A leftover partial extraction from an earlier failed attempt at the same
  # version must not be trusted; start clean.
  rm -rf "$RELEASE_DIR"
  mkdir -p "$RELEASE_DIR"
  tar -xzf "$ARCHIVE_TMP" -C "$RELEASE_DIR" --strip-components=1

  local current="$share/current"
  if [[ -e $current && ! -L $current ]]; then
    echo "$current exists and is not a symlink -- refusing to overwrite it" >&2
    exit 1
  fi
  local tmp_link="$share/.current.$$"
  ln -s "releases/$TARGET_VERSION" "$tmp_link"
  mv -T "$tmp_link" "$current"

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local tmp_json; tmp_json=$(mktemp "$share/.install.json.XXXXXX")
  python3 - "$TARGET_VERSION" "$now" "$@" > "$tmp_json" <<'PY'
import json
import sys

version, installed_at = sys.argv[1], sys.argv[2]
install_args = sys.argv[3:]
json.dump({"channel": "release", "version": version, "installed_at": installed_at,
           "previous": None, "install_args": install_args, "state": "installing"},
          sys.stdout, indent=2)
print()
PY
  mv -f "$tmp_json" "$share/install.json"
}

main() {
  OPT_VERSION=
  local -a install_args=()
  while (( $# )); do
    case "$1" in
      --version)      OPT_VERSION=${2:?--version needs X.Y.Z}; shift ;;
      --version=*)     OPT_VERSION=${1#*=} ;;
      -h|--help)      usage 0 ;;
      *)              install_args+=("$1") ;;
    esac
    shift
  done
  if [[ -n $OPT_VERSION && ! $OPT_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]; then
    echo "--version must look like X.Y.Z, got: $OPT_VERSION" >&2
    exit 1
  fi

  # Only what THIS stage itself uses: fetching/verifying/staging the release
  # and its own lock. Deliberately NOT tmux (or anything else install.sh
  # needs) -- finding and offering to install actual missing prerequisites,
  # tmux included, is exactly what bin/serverjack-setup does next; a hard
  # requirement here would make phase C's whole guided-prerequisites step
  # unreachable on a fresh machine that doesn't have tmux yet.
  for c in curl sha256sum tar python3 systemctl flock; do
    command -v "$c" >/dev/null 2>&1 || { echo "missing required command: $c" >&2; exit 1; }
  done

  refuse_root
  refuse_if_existing_install
  resolve_target

  local share="$HOME/.local/share/serverjack"
  mkdir -p "$share"
  local lock="$share/.lock"
  exec 9>"$lock"
  if ! flock -n 9; then
    say "Waiting for another serverjack install/update to finish..."
    flock 9
  fi
  # Re-check now that the lock is held: the two checks above ran before we
  # could serialize against a concurrent bootstrap run that got here first
  # and finished while we were downloading/confirming.
  refuse_if_existing_install

  download_and_verify
  # ${install_args[@]+"${install_args[@]}"}, not a bare "${install_args[@]}":
  # on bash older than 4.4, expanding an EMPTY array with "${arr[@]}" under
  # `set -u` raises "unbound variable" -- and install_args is empty on the
  # ordinary case (no extra flags at all, e.g. a bare bootstrap with no
  # --no-serve). Nothing here documents a bash floor, so this can't assume
  # 4.4+. The `+` form sidesteps it: it tests whether the array is SET, not
  # whether it's non-empty, which bash gets right in every version.
  stage_and_activate ${install_args[@]+"${install_args[@]}"}
  rm -rf "$DOWNLOAD_TMPDIR"

  say "Installed serverjack $TARGET_VERSION -> $RELEASE_DIR (current -> releases/$TARGET_VERSION)"
  say "Handing off to the guided setup"
  # Release the lock and exec: from here on this IS bin/serverjack-setup,
  # with the user's own arguments and terminal (stdin/stdout/stderr, job
  # control for a sudo prompt, /dev/tty for its own questions) preserved
  # exactly as if they had run it themselves -- it runs install.sh itself at
  # the end. Any flag already answering a question serverjack-setup would
  # otherwise ask means it never needs to touch /dev/tty for that one (see
  # its own header comment), so this exec works the same whether install_args
  # settles everything (`curl | bash -s -- --no-serve`, fully unattended) or
  # settles nothing (a bare `curl | bash`, fully guided).
  exec 9>&-
  exec bash "$share/current/bin/serverjack-setup" ${install_args[@]+"${install_args[@]}"}
}

main "$@"
