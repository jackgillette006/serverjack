<title>{title}</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080f0e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icon-180.png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<style>{css}</style></head><body><main>
<h1>{glyph}serverjack <small>{title}</small></h1>
<p class="tagline">Jack into your server.</p>
{error}
{body}
<p class="foot">Opening a session puts you in a terminal attached to that tmux session. Use the browser's back button to return here (the session keeps running).</p>
<script>
(function(){{
  // Desktop: "Open" pops the session out in its own window and this page
  // stays put. Phones: same tab (a pile of browser tabs is worse there).
  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
  if (touch) document.body.classList.add('touch');
  function popout(href, name) {{
    var w = window.open(href, 'serverjack-' + name, 'popup=yes,width=1000,height=650');
    if (w) {{ w.focus(); return true; }} return false;   // blocked => caller falls back to navigating
  }}
  document.addEventListener('click', function (e) {{
    var a = e.target.closest('a.open, a[data-open=popout]'); var menu = e.target.closest('details.menu');
    if (a) {{
      var name = a.dataset.name || a.closest('.sess').querySelector('a.open').dataset.name;
      var wantPop = a.dataset.open === 'popout' || (!touch && !a.dataset.open);
      if (wantPop && popout('/s/' + encodeURIComponent(name) + '?popout=1', name)) e.preventDefault();
      if (menu) menu.removeAttribute('open');
      return;
    }}
    var c = e.target.closest('[data-copy]');
    if (c) {{
      var t = c.dataset.copy, l = c.querySelector('.lbl') || c, old = l.textContent;
      var done = function () {{ l.textContent = 'Copied'; setTimeout(function () {{ l.textContent = old; }}, 1200); }};
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, function () {{ prompt('Copy this:', t); }});
      else prompt('Copy this:', t);
      return;
    }}
    if (!menu) document.querySelectorAll('details.menu[open]').forEach(function (d) {{ d.removeAttribute('open'); }});
  }});
}})();
</script>
</main></body></html>
"""

