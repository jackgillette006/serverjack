PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{title}</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080f0e">
<meta name="color-scheme" content="dark">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
{pwa_links}
<style>{css}</style></head><body class="{fx_class}">
<div id="crt" aria-hidden="true"></div><div id="sbbg" aria-hidden="true"></div><main>
<h1>{glyph}serverjack{title_small}</h1>
<p class="tagline">Jack into your server.</p>
<p class="sysline">{sysline}</p>
{error}
{body}
<p class="foot">To leave a session, use the logo at the top left of its bar. Leaving never stops it: it keeps running until you kill it from its ⋯ menu here.
<button class="fxt" id="fxt" type="button">CRT fx: on</button> &middot; <span class="ver">serverjack v{version}</span></p>
<script>
(function(){{
  // Desktop: "Open" pops the session out in its own window and this page
  // stays put. Phones: same tab (a pile of browser tabs is worse there).
  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
  if (touch) document.body.classList.add('touch');
  // CRT effects: the server put .fx on <body> (so the power-on plays before any
  // script runs); localStorage overrides it either way and the toggle writes it.
  var fxb = document.getElementById('fxt'), ls = null;
  try {{ ls = localStorage.getItem('sj-fx'); }} catch (e) {{}}
  function fxSet(on, save) {{
    document.body.classList.toggle('fx', on);
    fxb.textContent = 'CRT fx: ' + (on ? 'on' : 'off');
    if (save) try {{ localStorage.setItem('sj-fx', on ? '1' : '0'); }} catch (e) {{}}
  }}
  fxSet(ls === '0' ? false : ls === '1' || document.body.classList.contains('fx'), false);
  fxb.onclick = function () {{ fxSet(!document.body.classList.contains('fx'), true); }};
  // Leaving through one of our own links: play the power-off, then navigate.
  function powerOff(go) {{
    if (!document.body.classList.contains('fx')) return go();
    var done = false, fire = function () {{ if (!done) {{ done = true; go(); }} }};
    document.body.classList.add('off');
    document.body.addEventListener('animationend', fire, {{once: true}});
    setTimeout(fire, 130);
  }}
  function popout(href, name) {{
    var w = window.open(href, 'serverjack-' + name, 'popup=yes,width=1000,height=650');
    if (w) {{ w.focus(); return true; }} return false;   // blocked => caller falls back to navigating
  }}
  // Confirmations live in data-confirm, never in an inline onsubmit built
  // from a session/shortcut name. Listening on the document catches forms a
  // button reaches through form="..." too, since submit bubbles.
  document.addEventListener('submit', function (e) {{
    var f = e.target, m = f && f.dataset && f.dataset.confirm;
    if (m && !confirm(m)) e.preventDefault();
  }});
  document.addEventListener('click', function (e) {{
    var a = e.target.closest('a.open, a[data-open=popout]'); var menu = e.target.closest('details.menu');
    if (a) {{
      // Ctrl/Cmd/Shift/Alt-click (or a non-primary button): the browser's own
      // new tab or window on the link's real href, not our pop-up.
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button) return;
      var name = a.dataset.name || a.closest('.sess').querySelector('a.open').dataset.name;
      var wantPop = a.dataset.open === 'popout' || (!touch && !a.dataset.open);
      if (wantPop && popout('/s/' + encodeURIComponent(name) + '?popout=1', name)) e.preventDefault();
      else if (a.href) {{ e.preventDefault(); powerOff(function () {{ location.href = a.href; }}); }}
      if (menu) menu.removeAttribute('open');
      return;
    }}
    var c = e.target.closest('[data-copy]');
    if (c) {{
      // The label to go back to is read once: reading it on every click made
      // a second tap inside the 1.2s save "Copied" as the label for good.
      var t = c.dataset.copy, l = c.querySelector('.lbl') || c;
      if (!l.dataset.label) l.dataset.label = l.textContent;
      var done = function () {{
        clearTimeout(l._sjt); l.textContent = 'Copied';
        l._sjt = setTimeout(function () {{ l.textContent = l.dataset.label; }}, 1200);
      }};
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, function () {{ prompt('Copy this:', t); }});
      else prompt('Copy this:', t);
      return;
    }}
    // ssh:// hands off to another app: close the menu so the tap shows.
    if (menu && e.target.closest('a[data-open=ssh]')) {{ menu.removeAttribute('open'); return; }}
    if (!menu) document.querySelectorAll('details.menu[open]').forEach(function (d) {{ d.removeAttribute('open'); }});
  }});
  // "start at boot": the checkbox lives in an option row but belongs (form=)
  // to a hidden form of its own, because the row is already inside the card's
  // big form and forms don't nest. Ticking it posts immediately; the Start
  // row's checkbox first copies whatever the directory picker says.
  document.addEventListener('change', function (e) {{
    var cb = e.target.closest && e.target.closest('input.autostart');
    if (!cb || !cb.form) return;
    if (cb.dataset.picker && cb.form.elements.dir) {{
      var card = cb.closest('details.tool');
      var input = card && card.querySelector('.dirpick input[name=dir]');
      // A folder name means what Start would use (DIRPICK_JS); null: pick one first.
      var v = !input ? '' : input.dirValue ? input.dirValue() : input.value.trim();
      if (v === null) {{ cb.checked = !cb.checked; return; }}
      cb.form.elements.dir.value = v;
    }}
    cb.form.submit();
  }});
  // Start a session: Shell shows the command box; an agent hides it and
  // explains what it runs instead (its own command, fixed, in the directory
  // above). Delegated so the one radio checked on load is synced too.
  var cmdwrap = document.getElementById('cmdwrap'), toolhint = document.getElementById('toolhint');
  function syncStart() {{
    var checked = document.querySelector('input[name=what]:checked');
    document.querySelectorAll('.seg .pill').forEach(function (p) {{
      p.classList.toggle('on', p.querySelector('input').checked);
    }});
    if (!checked || checked.value === 'shell') {{
      cmdwrap.hidden = false;
      toolhint.hidden = true;
    }} else {{
      cmdwrap.hidden = true;
      toolhint.textContent = 'Runs ';
      var code = document.createElement('code');
      code.textContent = checked.dataset.run || '';
      toolhint.appendChild(code);
      toolhint.appendChild(document.createTextNode(' in the directory above.'));
      toolhint.hidden = false;
    }}
  }}
  document.addEventListener('change', function (e) {{
    if (e.target.name === 'what') syncStart();
  }});
  syncStart();
}})();
</script>
<script>{dirpick_js}</script>
<script>{land_js}</script>
<script>{flows_js}</script>
</main></body></html>
"""

# The landing page's ⋯ menus, as their own plain (not .format()-ed) script:
#  - one open at a time (also native: <details name="sj-menu">), and closing
#    one folds Rename and puts the original name back;
#  - Escape closes the innermost open part (Rename, then the menu) and gives
#    focus back to its summary; focus moving out of a menu closes it, and so
#    does a press anywhere outside it (pointerdown: iOS does not deliver a
#    tap on plain page background as a click on document);
#  - a menu that would open below the bottom of the screen opens upward
#    instead, or scrolls itself into view when there is no room either way.
LAND_JS = r"""
(function () {
  'use strict';
  function visibleBottom() {
    var vv = window.visualViewport;
    return vv ? vv.offsetTop + vv.height : innerHeight;
  }
  function visibleTop() {
    var vv = window.visualViewport, sb = document.getElementById('sbbg');
    return (vv ? vv.offsetTop : 0) + (sb ? sb.offsetHeight : 0);
  }
  // Downward if it fits, else upward if that fits, else down and scrolled in.
  // again: an open menu changed size (Rename unfolding, an error under its
  // field). It keeps its direction then -- a flip moved the field the user
  // just tapped across the screen, and replayed the entrance animation (a
  // blink) -- and is scrolled into view instead. Only an upward list that
  // has grown above the page itself, where no scrolling reaches it, turns
  // downward, without the animation.
  function place(d, again) {
    var list = d.querySelector('.menu-list');
    if (!list) return;
    if (again) {
      if (list.classList.contains('up')) {
        if (list.getBoundingClientRect().top >= visibleTop() + 8) return;
        list.scrollIntoView({ block: 'nearest' });
        if (list.getBoundingClientRect().top >= visibleTop()) return;
        list.style.animation = 'none';
        list.classList.remove('up');
      }
      list.scrollIntoView({ block: 'nearest' });
      return;
    }
    list.style.animation = '';
    list.classList.remove('up');
    var r = list.getBoundingClientRect();
    if (r.bottom <= visibleBottom() - 8) return;
    var cb = (list.offsetParent || d).getBoundingClientRect();
    if (cb.top - 4 - r.height >= visibleTop() + 8) { list.classList.add('up'); return; }
    list.scrollIntoView({ block: 'nearest' });
  }
  // An open menu re-placed whenever its size changes, whatever changed it.
  var ro = window.ResizeObserver ? new ResizeObserver(function (es) {
    es.forEach(function (en) {
      var d = en.target.closest('details.menu');
      if (d && d.open) place(d, true);
    });
  }) : null;
  function reset(ren) {
    var i = ren.querySelector('input[name=new]');
    if (i) i.value = i.defaultValue;
  }
  document.addEventListener('toggle', function (e) {   // toggle doesn't bubble
    var d = e.target;
    if (!d.matches) return;
    if (d.matches('details.menu')) {
      var list = d.querySelector('.menu-list');
      if (d.open) {
        document.querySelectorAll('details.menu[open]').forEach(function (o) {
          if (o !== d) o.open = false;
        });
        place(d);
        if (ro && list) ro.observe(list);
      } else {
        var ren = d.querySelector('details.ren');
        if (ren) { ren.open = false; reset(ren); }
        if (list) {
          if (ro) ro.unobserve(list);
          list.classList.remove('up'); list.style.animation = '';
        }
      }
    } else if (d.matches('details.ren')) {
      if (!d.open) reset(d);
      var m = d.closest('details.menu');
      if (m && m.open) place(m, true);
    }
  }, true);
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape' || e.defaultPrevented) return;
    var a = document.activeElement;
    var d = (a && a.closest && a.closest('details.ren[open]')) || document.querySelector('details.menu[open]');
    if (!d) return;
    d.open = false;
    var s = d.querySelector('summary');
    if (s) s.focus();
  });
  document.addEventListener('focusout', function (e) {
    var d = e.target.closest && e.target.closest('details.menu[open]');
    // No relatedTarget: an iOS tap, a confirm() or an app switch -- not "left".
    if (d && e.relatedTarget && !d.contains(e.relatedTarget)) d.open = false;
  });
  document.addEventListener('pointerdown', function (e) {
    var inside = e.target.closest && e.target.closest('details.menu');
    document.querySelectorAll('details.menu[open]').forEach(function (d) {
      if (d !== inside) d.open = false;
    });
  });
})();

// The session list keeps itself current. It used to be a snapshot from
// render(): on a desktop the list tab is the hub that stays open (Open pops
// sessions out), and the home-screen app resumes without reloading, so dots,
// ages and the rows themselves went stale, and Open on a session that had
// gone loaded an error copy of this page (in a pop-up, on desktop).
//  - /api/sessions every 15s while visible (the terminal page's cadence),
//    and whenever the page comes back (visibilitychange, focus, a
//    back/forward-cache restore), plus once ~1s after load: the session you
//    just left is usually still "attached" when the server renders this page,
//    because the old page's terminal socket hasn't closed yet.
//  - Rows are patched in place by name (dot, facts, command and path). Rows
//    that are gone are removed and new ones are copied in from a fresh render
//    of this page -- but not while a menu is open or focus is in a row, so a
//    half-typed rename is never lost.
//  - Open on a row the last poll already knew was gone says so instead, in
//    the row's place.
//  - The agent cards (a server started or stopped elsewhere) and the machine
//    line come from that same fresh render: at most once a minute, when the
//    list changed, and when the page comes back. A card that is open or has
//    focus is left as it is.
//  - Rows that come and go above what you are looking at don't move it, in
//    the browsers without scroll anchoring too (Safari): see steady().
(function () {
  'use strict';
  var h2 = document.getElementById('sessions');
  if (!h2) return;
  var gone = {}, gen = 0, again = false, skew = 0, fails = 0, last = 0, inflight = false, importing = false;
  var pageAt = Date.now(), wantPage = false;
  // WebKit doesn't anchor scrolling here (it even claims overflow-anchor):
  // a row added or removed above the Start card moved the field being typed
  // in from under the finger, 65px a row, and so did a note under the
  // Sessions heading. steady(fn) runs a change and scrolls back by however
  // far what you are looking at moved: the focused field, else the first
  // thing on screen that is still there. Every engine gets this one
  // behaviour: the page turns the browsers' own anchoring off (CSS), so the
  // two can never both correct the same move.
  function steady(fn) {
    var a = document.activeElement, marks = [];
    if (a && a !== document.body && a.closest && a.closest('main')) marks.push(a);
    Array.prototype.some.call(document.querySelectorAll('main > *'), function (el) {
      var r = el.getBoundingClientRect();
      if (r.bottom > 0 && r.height) marks.push(el);
      return marks.length > 4;
    });
    var tops = marks.map(function (el) { return el.getBoundingClientRect().top; });
    try { return fn(); } finally {
      for (var i = 0; i < marks.length; i++) {
        if (!marks[i].isConnected) continue;
        var dy = marks[i].getBoundingClientRect().top - tops[i];
        if (Math.abs(dy) >= 1) window.scrollBy(0, dy);
        break;
      }
    }
  }
  window.sjSteady = steady;
  function rows() { return Array.prototype.slice.call(document.querySelectorAll('.sess[data-session]')); }
  function find(name) {
    var r = rows();
    for (var i = 0; i < r.length; i++) if (r[i].dataset.session === name) return r[i];
    return null;
  }
  // session_age() in Python, against the server's clock (its Date header).
  function age(created) {
    if (!created) return '';
    var s = Math.max(0, Math.floor(Date.now() / 1000 + skew) - created);
    if (s >= 86400) return 'up ' + Math.floor(s / 86400) + 'd';
    if (s >= 3600) return 'up ' + Math.floor(s / 3600) + 'h';
    if (s >= 60) return 'up ' + Math.floor(s / 60) + 'm';
    return 'up <1m';
  }
  function paint(row, s) {
    var on = !!s.attached, state = on ? 'attached' : 'not attached';
    var dot = row.querySelector('.dot');
    if (dot && dot.getAttribute('aria-label') !== state) {
      dot.classList.toggle('on', on);
      dot.setAttribute('aria-label', state);
      dot.title = state;
    }
    // session_facts() in Python
    var f = row.querySelector('.facts');
    var rest = [s.windows > 1 ? s.windows + ' windows' : '', age(s.created)]
      .filter(function (x) { return x; }).join(' \u00b7 ');
    if (f && f.dataset.k !== (on ? '1' : '0') + rest) {
      f.dataset.k = (on ? '1' : '0') + rest;
      f.textContent = '';
      if (on) {
        var wrap = document.createElement('span'), b = document.createElement('b');
        wrap.setAttribute('aria-hidden', 'true');
        b.className = 'att'; b.textContent = 'attached';
        wrap.appendChild(b);
        if (rest) wrap.appendChild(document.createTextNode(' \u00b7 '));
        f.appendChild(wrap);
      }
      f.appendChild(document.createTextNode(rest));
      if (s.created) f.title = 'started ' + new Date(s.created * 1000).toLocaleString();
    }
    var w = row.querySelector('.where'), wt = '\u00a0\u00b7 ' + s.cmd + ' \u00b7 ' + s.path;
    if (w && w.textContent !== wt) w.textContent = wt;
  }
  // Only an open menu or a text box in a row (a half-typed rename) holds
  // rows still. Mere focus must not: a desktop click on Open leaves focus on
  // that link for as long as the list tab lives, which froze the list for
  // good in exactly the hub case this is for.
  function busy() {
    if (document.querySelector('details.menu[open]')) return true;
    var a = document.activeElement;
    return !!(a && a.matches && a.matches('input, textarea, select') &&
              a.closest('.sess[data-session]'));
  }
  // A row going away with focus in it would drop focus to <body>; keep the
  // keyboard user's place at the Sessions heading instead (without a scroll).
  function drop(row) {
    if (row.contains(document.activeElement)) {
      h2.setAttribute('tabindex', '-1');
      try { h2.focus({ preventScroll: true }); } catch (e) { h2.focus(); }
    }
    row.remove();
  }
  // A line right under the Sessions heading: "x has ended", or "can't reach".
  function note(text, cls, kind) {
    steady(function () {
      var n = document.getElementById('sessnote');
      if (!text) { if (n && (!kind || n.dataset.kind === kind)) n.remove(); return; }
      if (!n) {
        n = document.createElement('div');
        n.id = 'sessnote';
        n.setAttribute('role', 'status');
        h2.parentNode.insertBefore(n, h2.nextSibling);
      }
      n.className = cls; n.dataset.kind = kind; n.dataset.at = Date.now(); n.textContent = text;
    });
  }
  // Where a row with nothing before it goes: under the heading and every
  // note right under it -- ours (#sessnote) and the page's own one-shot note
  // or error, which the form flows move there (FLOWS_JS place()).
  function anchor() {
    var a = h2;
    while (a.nextElementSibling && a.nextElementSibling.matches('#sessnote, .flash, .err')) {
      a = a.nextElementSibling;
    }
    return a;
  }
  function placeholder() {
    var ph = document.getElementById('nosess'), any = rows().length > 0;
    if (any && ph) ph.remove();
    if (!any && !ph) {
      ph = document.createElement('div');
      ph.className = 'empty'; ph.id = 'nosess'; ph.textContent = 'No sessions running.';
      var a = document.querySelector('.sess.sessmsg') || anchor();   // after a gone row's line
      a.parentNode.insertBefore(ph, a.nextSibling);
    }
  }
  // The agent cards and the machine line, from a fresh render (doc).
  function freshen(doc) {
    var sl = doc.querySelector('.sysline'), mine = document.querySelector('.sysline');
    if (sl && mine && mine.innerHTML !== sl.innerHTML) mine.innerHTML = sl.innerHTML;
    document.querySelectorAll('details.tool[id]').forEach(function (t) {
      if (t.open || t.contains(document.activeElement) || t.querySelector('form[data-busy]')) return;
      var f = doc.getElementById(t.id), a = t.querySelector('summary'), b = f && f.querySelector('summary');
      if (!a || !b || a.innerHTML === b.innerHTML) return;
      f = document.importNode(f, true);
      f.open = false;
      t.replaceWith(f);
      if (window.sjWireDirpicks) window.sjWireDirpicks(f);
    });
  }
  // A fresh render of this page: agent cards and the machine line always,
  // and, given the list, the rows it has that this page doesn't.
  function fromPage(list) {
    if (importing) return;
    importing = true; pageAt = Date.now();
    fetch('/', { cache: 'no-store' }).then(function (r) { return r.ok ? r.text() : ''; })
      .then(function (html) {
        if (!html || busy()) return;
        var doc = new DOMParser().parseFromString(html, 'text/html'), fresh = {};
        steady(function () {
          freshen(doc);
          if (!list) return;
          doc.querySelectorAll('.sess[data-session]').forEach(function (r) { fresh[r.dataset.session] = r; });
          var prev = null;
          list.forEach(function (s) {
            var cur = find(s.name);
            if (!cur && fresh[s.name]) {
              cur = document.adoptNode(fresh[s.name]);
              var after = prev || anchor();
              after.parentNode.insertBefore(cur, after.nextSibling);
              paint(cur, s);
            }
            if (cur) prev = cur;
          });
          placeholder();
        });
      })
      .catch(function () {})
      .then(function () { importing = false; });
  }
  function sync(list) {
    var by = {};
    list.forEach(function (s) { by[s.name] = s; });
    rows().forEach(function (r) { if (by[r.dataset.session]) paint(r, by[r.dataset.session]); });
    if (busy()) return;
    var dropped = false;
    steady(function () {
      rows().forEach(function (r) { if (!by[r.dataset.session]) { drop(r); dropped = true; } });
      placeholder();
    });
    var missing = list.some(function (s) { return !find(s.name); });
    if (missing || dropped || wantPage || Date.now() - pageAt > 60000) {
      wantPage = false;
      fromPage(missing ? list : null);
    }
  }
  // The form flows change the list in place (Kill, Rename) and say so with
  // "sj:sessions". A poll already on its way then describes the list from
  // before, and acting on it would drop a row just renamed: its answer is
  // dropped and the list asked for again.
  document.addEventListener('sj:sessions', function () { gen++; });
  function refresh() {
    if (inflight) return;
    inflight = true; last = Date.now();
    var g = gen;
    fetch('/api/sessions', { cache: 'no-store' }).then(function (r) {
      var d = Date.parse(r.headers.get('Date') || '');
      if (d) skew = d / 1000 - Date.now() / 1000;
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function (list) {
      if (g !== gen) { again = true; return; }
      // What this poll saw go: the rows on the page that it doesn't list. A
      // row that turned up since (a Rename in place swaps one in) was never
      // seen to go, so its Open is left alone.
      var known = list.map(function (s) { return s.name; });
      gone = {};
      rows().forEach(function (r) { if (known.indexOf(r.dataset.session) < 0) gone[r.dataset.session] = 1; });
      fails = 0;
      note('', '', 'down');
      var n = document.getElementById('sessnote');     // "x has ended" has been read by now
      if (n && n.dataset.kind === 'ended' && Date.now() - n.dataset.at > 20000) n.remove();
      sync(list);
    }).catch(function () {
      // twice in a row, so a phone waking up before its network doesn't flash it
      if (++fails >= 2) note("Can't reach serverjack right now; this list may be out of date.", 'err', 'down');
    }).then(function () {
      inflight = false;
      if (again) { again = false; refresh(); }
    });
  }
  // focus and visibilitychange usually arrive together: one fetch for both
  function soon() {
    if (document.hidden) return;
    if (Date.now() - pageAt > 10000) wantPage = true;     // back after a while: the cards too
    if (Date.now() - last > 1000) refresh();
  }
  setTimeout(refresh, 1200);
  setInterval(function () { if (!document.hidden) refresh(); }, 15000);
  document.addEventListener('visibilitychange', soon);
  addEventListener('focus', soon);
  addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    document.body.classList.remove('off');   // left mid power-off: don't come back black
    wantPage = true;
    refresh();
  });
  // Runs before the page's own click handler (capture), so a session the
  // last poll knew was gone is never opened -- least of all in a pop-up.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a.open, a[data-open=here], a[data-open=popout]');
    var row = a && a.closest('.sess[data-session]');
    if (!row || !gone[row.dataset.session]) return;
    e.preventDefault(); e.stopPropagation();
    var m = a.closest('details.menu');
    if (m) m.open = false;
    // Said in the row's own place (FLOWS_JS rowNote()): the line under the
    // heading may be a screenful away from the row tapped.
    var text = '\u201c' + row.dataset.session + '\u201d has ended.';
    steady(function () {
      if (window.sjRowNote) window.sjRowNote(row, text);
      else { note(text, 'flash', 'ended'); drop(row); }
      placeholder();
    });
    refresh();
  }, true);
})();
"""

START_CARD = """<h2 id="start">Start a session</h2>
<div class="card"><form class="row" id="startform" method="post" action="/start" autocomplete="off">
  <div class="seg">{what_options}</div>
  {dirpicker}
  <input id="name" name="name" aria-label="Session name" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Name (optional), e.g. 3d-lab" value="{name}">
  <div id="cmdwrap">
    <textarea id="cmd" name="cmd" aria-label="Command" rows="2" autocapitalize="off" spellcheck="false"
      placeholder="Optional command, e.g. sudo apt install ffmpeg">{cmd}</textarea>
    <details class="inline"{save_open}><summary>Save as a shortcut</summary>
      <div class="save"><input type="checkbox" id="save" name="save" value="1"{save_checked}><label for="save">Keep this command in Shortcuts</label></div>
      <input name="label" maxlength="60" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Shortcut name" placeholder="Shortcut name (optional), e.g. Update packages" value="{label}">
    </details>
  </div>
  <p class="hint" id="toolhint" hidden></p>
  <button class="btn wide" type="submit">Start</button>
  <p class="hint" id="starthint">Runs in a real terminal, so sudo prompts work, and leaves you at a prompt when it finishes. Leave Name blank to name it after the command and folder.</p>
</form>
<details class="inline ddchange"{dd_open}><summary>Starts in {default_dir_show} &middot; change</summary>
  {dd_err}<form class="row" method="post" action="/prefs">
    {default_dirpicker}
    <button class="btn sec wide" type="submit">Save</button>
  </form>
</details></div>"""

# The landing page's form flows, loaded LAST: after the page's own script
# (menus, copy buttons, the Start card's Shell/agent switch, and the confirm()
# listener whose cancel this checks for) and DIRPICK_JS. All of it is an
# enhancement: with scripts off every form still posts and redirects.
#  - The address bar: an error page is the answer to a POST, and ?done= notes
#    are one-shot, so the history entry becomes a plain GET of "/". The one
#    piece of view state kept is ?edit_sc= (the shortcut editor is open), so
#    a reload keeps the editor and its Cancel link is a real navigation.
#  - Notes (?done=) and card errors move next to the card they are about.
#  - The Start card's typed fields survive the page's OTHER forms (change the
#    default directory, a shortcut, start at boot, ...): stashed in
#    sessionStorage on the way out, put back on the next load, once.
#  - One submit per form until the page changes (a double tap used to run a
#    command twice or land on "already exists" for your own new session).
#  - Kill and Rename go through /api/kill and /api/rename and update the row in
#    place: no reload, no lost scroll position, errors under the field.
FLOWS_JS = r"""
(function () {
  'use strict';
  var start = document.getElementById('startform');
  var DRAFT = 'sj-start-draft', DRAFT_TTL = 120000;

  if (history.replaceState) {
    var q = new URLSearchParams(location.search);
    ['done', 'n', 'open', 'k', 'dir_note', 'note', 'ended'].forEach(function (k) { q.delete(k); });
    // The editor's state is the page's, whatever the URL said: an edit that
    // came back with an error keeps it, a shortcut that is gone drops it.
    var ed = document.querySelector('#addsc input[name=id]');
    if (ed) q.set('edit_sc', ed.value); else q.delete('edit_sc');
    var url = '/' + (q.toString() ? '?' + q.toString() : '') + location.hash;
    if (url !== location.pathname + location.search + location.hash) history.replaceState(null, '', url);
  }
  // With this script on, the "Keep this command" box alone decides: unticking
  // it after typing a shortcut name (which ticked it) means don't keep it.
  if (start && !start.elements.namedItem('save_ui')) {
    var su = document.createElement('input');
    su.type = 'hidden'; su.name = 'save_ui'; su.value = '1';
    start.appendChild(su);
  }

  // A note or error that names a section or card (data-at) goes inside or
  // right under it, and the page lands there.
  function place(el) {
    var t = el.dataset.at && document.getElementById(el.dataset.at);
    if (!t) return;
    if (t.tagName === 'H2') t.parentNode.insertBefore(el, t.nextSibling);
    else if (t.querySelector('.tbody')) t.querySelector('.tbody').insertBefore(el, t.querySelector('.tbody').firstChild);
    else if (t.tagName === 'DETAILS') t.insertBefore(el, t.querySelector('summary').nextSibling);
    else t.parentNode.insertBefore(el, t);
    t.scrollIntoView({block: 'start'});
  }
  document.querySelectorAll('main > .flash[data-at], main > .err[data-at]').forEach(place);
  // Not focused: that would open the folder suggestions over its Save button.
  var dd = document.querySelector('.ddchange[open] .err');
  if (dd) dd.scrollIntoView({block: 'center'});

  function field(n) { return start && start.elements.namedItem(n); }
  function stash() {
    if (!start) return;
    var w = start.querySelector('input[name=what]:checked'), save = field('save');
    var d = {t: Date.now(), what: w ? w.value : 'shell', dir: field('dir').value,
             name: field('name').value, cmd: field('cmd').value, label: field('label').value,
             save: !!(save && save.checked), open: !!start.querySelector('details.inline[open]')};
    try {
      if (d.what === 'shell' && !d.dir && !d.name && !d.cmd && !d.label && !d.save) sessionStorage.removeItem(DRAFT);
      else sessionStorage.setItem(DRAFT, JSON.stringify(d));
    } catch (e) {}
  }
  function restore() {
    var d = null;
    try { d = JSON.parse(sessionStorage.getItem(DRAFT) || 'null'); sessionStorage.removeItem(DRAFT); } catch (e) {}
    if (!d || !start || !(Date.now() - d.t < DRAFT_TTL)) return;
    // A re-render of the Start card's own error already carries its fields.
    if (field('cmd').value || field('name').value || field('dir').value || field('label').value) return;
    start.querySelectorAll('input[name=what]').forEach(function (r) { if (r.value === d.what) r.checked = true; });
    field('dir').value = d.dir || ''; field('name').value = d.name || '';
    field('cmd').value = d.cmd || ''; field('label').value = d.label || '';
    if (field('save')) field('save').checked = !!d.save;
    var det = start.querySelector('details.inline');
    if (det && d.open) det.open = true;
  }
  // Re-run the Shell/agent switch for whatever radio is checked now: after a
  // restore, and after Back (Chrome restores a checked radio without a change
  // event, which left two pills lit and the command box showing for an agent).
  function syncStart() {
    var r = start && start.querySelector('input[name=what]:checked');
    if (r) r.dispatchEvent(new Event('change', {bubbles: true}));
  }
  // The shell hint (sudo prompts, naming after the command) is about shells.
  var hint = document.getElementById('starthint');
  document.addEventListener('change', function (e) {
    if (e.target.name === 'what' && hint) hint.hidden = e.target.value !== 'shell';
  });
  // Naming the shortcut is asking for it: tick the box, so what will happen shows.
  document.addEventListener('input', function (e) {
    if (field('save') && e.target === field('label') && e.target.value.trim()) field('save').checked = true;
  });
  // Leaving for one of the page's other forms or its own links: keep the draft.
  // Capture phase -- start at boot submits from its own change listener.
  document.addEventListener('change', function (e) {
    if (e.target.classList && e.target.classList.contains('autostart')) stash();
  }, true);
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (a && a.origin === location.origin && a.pathname === '/') stash();
  }, true);
  restore();
  syncStart();

  function unbusy(f) {
    delete f.dataset.busy;
    clearTimeout(f._sjT);
    var b = f._sjBtn;
    if (!b) return;
    b.disabled = false; b.classList.remove('busy'); b.removeAttribute('aria-busy');
    if (b.dataset.label) { b.textContent = b.dataset.label; delete b.dataset.label; }
  }
  function busy(f, b) {
    f.dataset.busy = '1';
    f._sjT = setTimeout(function () { unbusy(f); }, 20000);   // a request that never came back
    if (!b) return;
    f._sjBtn = b;
    b.classList.add('busy'); b.setAttribute('aria-busy', 'true');
    if (f === start) { b.dataset.label = b.textContent; b.textContent = 'Starting…'; }
    // Not synchronously: a submitter disabled inside the submit event is left
    // out of the form data, and an agent card's buttons carry their route there.
    setTimeout(function () { b.disabled = true; }, 0);
  }
  addEventListener('pageshow', function (e) {
    document.querySelectorAll('form[data-busy]').forEach(unbusy);
    if (e.persisted) document.querySelectorAll('.flash, .sessmsg').forEach(function (n) { n.remove(); });
    syncStart();
  });

  function post(url, data) {
    return fetch(url, {method: 'POST', body: new URLSearchParams(data), credentials: 'same-origin',
                       cache: 'no-store'})
      .then(function (r) {
        return r.json().catch(function () { return {error: 'serverjack answered ' + r.status + '.'}; });
      });
  }
  function cardOf(name, root) {
    var a = Array.prototype.filter.call((root || document).querySelectorAll('.sess a.open[data-name]'),
                                        function (x) { return x.dataset.name === name; })[0];
    return a ? a.closest('.sess') : null;
  }
  function inlineErr(f, msg) {
    var p = f.parentNode.querySelector('.err');
    if (!msg) { if (p) p.remove(); return; }
    if (!p) {
      p = document.createElement('p'); p.className = 'err'; p.setAttribute('role', 'alert');
      f.parentNode.appendChild(p);
    }
    p.textContent = msg;
  }
  function fetchPage() {
    return fetch('/', {cache: 'no-store', credentials: 'same-origin'})
      .then(function (r) { return r.text(); })
      .then(function (html) { return new DOMParser().parseFromString(html, 'text/html'); });
  }
  // An agent card names its server's session (Stop's form, Open's link), so
  // after a Kill or Rename in place it would act on a name that is gone, and
  // still say "running" after a Kill. The cards that name the session are
  // swapped for fresh ones from doc (fetched when not given), staying open
  // or closed as they were, with their directory pickers wired up.
  function namesSession(t, name) {
    return Array.prototype.some.call(t.querySelectorAll('input[name=session]'), function (i) {
      return i.value === name;
    }) || Array.prototype.some.call(t.querySelectorAll('a[href^="/s/"]'), function (a) {
      try { return decodeURIComponent(a.getAttribute('href').slice(3)) === name; } catch (x) { return false; }
    });
  }
  function refreshTools(name, doc) {
    var stale = Array.prototype.filter.call(document.querySelectorAll('details.tool[id]'), function (t) {
      return namesSession(t, name);
    });
    if (!stale.length) return Promise.resolve();
    return (doc ? Promise.resolve(doc) : fetchPage()).then(function (doc) {
      stale.forEach(function (t) {
        var fresh = doc.getElementById(t.id), open = t.open;
        if (!fresh) return;
        fresh = document.importNode(fresh, true);
        t.replaceWith(fresh);
        fresh.open = open;
        if (window.sjWireDirpicks) window.sjWireDirpicks(fresh);
      });
    });
  }
  // The renamed row, fresh from the server: the name is in a dozen places in
  // it (links, hidden fields, the SSH command), so re-rendering beats patching.
  function refreshCard(oldName, newName) {
    var card = cardOf(oldName);
    return fetchPage()
      .then(function (doc) {
        var fresh = cardOf(newName, doc);
        if (!card || !fresh) throw new Error('no row');
        fresh = document.importNode(fresh, true);
        card.replaceWith(fresh);
        document.dispatchEvent(new Event('sj:sessions'));      // the live list (LAND_JS)
        var s = fresh.querySelector('details.menu > summary');
        if (s) s.focus({preventScroll: true});
        return refreshTools(oldName, doc);
      })
      .catch(function () {
        stash();
        location.replace('/?done=renamed&n=' + encodeURIComponent(newName) + '#sessions');
      });
  }
  function rename(e, f) {
    e.preventDefault();
    var input = f.elements.namedItem('new'), old = f.elements.namedItem('name').value;
    var b = f.querySelector('button');
    f.dataset.busy = '1'; b.disabled = true;
    post('/api/rename', {name: old, 'new': input.value})
      .then(function (r) {
        if (r.error) { inlineErr(f, r.error); input.focus(); return; }
        inlineErr(f, '');
        return refreshCard(old, r.name);
      }, function () { inlineErr(f, 'Couldn’t reach serverjack. Try again.'); })
      .then(function () { delete f.dataset.busy; b.disabled = false; });
  }
  // A row that has gone (killed here, or found ended when opened) leaves a
  // line in its place for a few seconds: said where the tap was, the list
  // still one card (the line is a row of it), and a keyboard user's place
  // kept on the next row instead of falling to <body>.
  function rowsLeft() {
    return Array.prototype.map.call(document.querySelectorAll('.sess a.open[data-name]'),
                                    function (a) { return a.closest('.sess'); });
  }
  function rowNote(card, text) {
    document.querySelectorAll('.sess.sessmsg').forEach(function (x) { x.remove(); });
    var n = document.createElement('div'), had = card.contains(document.activeElement);
    n.className = 'card sess sessmsg'; n.setAttribute('role', 'status'); n.dataset.live = '1';
    n.textContent = text;
    var all = rowsLeft(), i = all.indexOf(card), next = all[i + 1] || all[i - 1];
    card.replaceWith(n);
    if (had) {
      var to = next && next.querySelector('details.menu > summary');
      if (!to) { to = n; n.tabIndex = -1; }
      try { to.focus({preventScroll: true}); } catch (x) { to.focus(); }
    }
    setTimeout(function () {
      n.classList.add('out');
      setTimeout(function () {
        if (!n.parentNode) return;
        if (n.contains(document.activeElement)) {
          var h = document.getElementById('sessions');
          if (h) { h.tabIndex = -1; try { h.focus({preventScroll: true}); } catch (x) { h.focus(); } }
        }
        // the live list's steady(): what you are looking at stays put
        (window.sjSteady || function (fn) { fn(); })(function () { n.remove(); });
      }, 320);
    }, 6000);
    return n;
  }
  window.sjRowNote = rowNote;
  function kill(e, f) {
    e.preventDefault();
    var name = f.elements.namedItem('name').value, card = f.closest('.sess');
    f.dataset.busy = '1';
    post('/api/kill', {name: name})
      .then(function (r) {
        if (r.error || !card) throw new Error(r.error || 'no row');
        var n = rowNote(card, 'Killed “' + name + '”.');
        document.dispatchEvent(new Event('sj:sessions'));
        // #nosess: the same placeholder the session list's own refresh puts
        // up, so the two can never show it twice.
        if (!document.querySelector('.sess a.open[data-name]') && !document.getElementById('nosess')) {
          var em = document.createElement('div');
          em.className = 'empty'; em.id = 'nosess'; em.textContent = 'No sessions running.';
          n.parentNode.insertBefore(em, n.nextSibling);
        }
        // Killed already: a card that can't be refreshed is only out of date
        // (and its Stop says so), so this is not waited for.
        refreshTools(name).catch(function () {});
      })
      .catch(function () { delete f.dataset.busy; stash(); f.submit(); });   // the plain POST
  }
  // Rename: open the field focused and selected, in the same tap (iOS raises
  // the keyboard only for a focus() made inside the user's own gesture).
  document.addEventListener('click', function (e) {
    var s = e.target.closest && e.target.closest('details.ren > summary');
    if (!s) return;
    e.preventDefault();
    var d = s.parentNode;
    d.open = !d.open;
    var i = d.open && d.querySelector('input[name=new]');
    if (i) { i.focus(); i.select(); }
  });
  // A rename error is about that attempt: it goes when Rename or its menu
  // folds away, rather than greeting the next one.
  document.addEventListener('toggle', function (e) {   // toggle doesn't bubble
    var d = e.target;
    if (!d.open && d.matches && d.matches('details.ren, details.menu')) {
      d.querySelectorAll('details.ren .err').forEach(function (p) { p.remove(); });
    }
  }, true);

  // After the page's confirm() listener: a cancelled Kill is defaultPrevented.
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (e.defaultPrevented || !f || f.tagName !== 'FORM') return;
    if (f.dataset.busy) { e.preventDefault(); return; }
    var act = f.getAttribute('action');
    if (act === '/rename') return rename(e, f);
    if (act === '/kill') return kill(e, f);
    if (f === start) { try { sessionStorage.removeItem(DRAFT); } catch (x) {} }
    else stash();
    busy(f, e.submitter || f.querySelector('[type=submit]'));
  });
})();
"""

