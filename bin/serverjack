/* ---- screen-text view (glass over the terminal) */
#screen{{position:absolute;inset:0;z-index:30;background:var(--glass-bg);
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  display:flex;flex-direction:column}}
#screen[hidden]{{display:none}}
.sbar{{flex:none;min-height:44px;display:flex;align-items:stretch;gap:2px;
  border-bottom:1px solid var(--glass-border);padding-top:env(safe-area-inset-top)}}
.sbar span{{flex:1 1 auto;display:flex;align-items:center;padding:0 14px;color:var(--text-muted);
  font:500 12px/16px var(--font-mono);min-width:0}}
#screen-text{{flex:1 1 auto;margin:0;padding:12px;overflow:auto;
  font:13px/1.45 var(--font-mono);white-space:pre-wrap;word-break:break-all;
  user-select:text;-webkit-user-select:text;color:var(--text-primary)}}
