def load_tools():
    """The visible tool list, plus an error string if tools.json is unusable
    (a bad config must not take the page down)."""
    tools = [dict(t) for t in BUILTIN_TOOLS]
    by_id = {t["id"]: t for t in tools}
    error = None
    try:
        with open(TOOLS_FILE) as f:
            data = json.load(f)
        if not isinstance(data, list):
            raise ValueError("expected a JSON list of tool objects")
        for entry in data:
            if not isinstance(entry, dict) or not entry.get("id"):
                raise ValueError('every entry needs an "id"')
            tid = entry["id"]
            if tid in by_id:
                by_id[tid].update(entry)
            else:
                t = dict(entry)
                t.setdefault("label", tid)
                t.setdefault("bin", tid)
                by_id[tid] = t
                tools.append(t)
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        error = f"Ignoring {TOOLS_FILE}: {e}"
        sys.stderr.write(error + "\n")

    tools = [t for t in tools if not t.get("hidden")]
    want = os.environ.get("SERVERJACK_TOOLS", "").strip()
    if want:
        # Tolerate the old "claude=Claude Code,codex=Codex" spelling.
        ids = [x.split("=")[0].strip() for x in want.split(",")]
        by_id = {t["id"]: t for t in tools}
        tools = [by_id[i] for i in ids if i in by_id]
    return tools, error


def _nvm_bins():
    """nvm keeps node -- and every CLI `npm install -g` puts beside it -- in a
    versioned directory that only nvm.sh adds to PATH, so a user unit never
    sees it. Offer them all, the `nvm alias default` one first, then newest."""
    root = os.path.expanduser("~/.nvm/versions/node")
    try:
        vers = [d for d in os.listdir(root)
                if os.path.isdir(os.path.join(root, d, "bin"))]
    except OSError:
        return []
    vers.sort(key=lambda v: [int(p) if p.isdigit() else -1
                             for p in v.lstrip("v").split(".")], reverse=True)
    try:
        with open(os.path.expanduser("~/.nvm/alias/default")) as f:
            default = f.read().strip()
    except OSError:
        default = ""
    for cand in (default, "v" + default):
        if cand in vers:
            vers.remove(cand)
            vers.insert(0, cand)
            break
    return [os.path.join(root, v, "bin") for v in vers]


def _tool_path():
    """PATH_ENV plus every existing directory a tool declares in "paths"
    (shell globs allowed), plus nvm's node directories. Coding CLIs like to
    install into a private bin dir that only .bashrc adds to PATH; serverjack
    runs from a systemd unit and never sees that."""
    out = PATH_ENV.split(":")
    extra = []
    for t in load_tools()[0]:
        for pat in t.get("paths") or []:
            extra.extend(sorted(glob.glob(os.path.expanduser(str(pat)))))
    extra.extend(_nvm_bins())
    for d in extra:
        if d and d not in out and os.path.isdir(d):
            out.append(d)
    return ":".join(out)


# tools.json is read once at startup, so this is computed once too.
TOOL_PATH = _tool_path()


def find_tool(tid):
    for t in load_tools()[0]:
        if t["id"] == tid:
            return t
    return None


def tool_kinds():
    """Session kinds for the "new session" forms: a plain shell, plus every
    installed tool that has a `run` command. kind -> (command, label)."""
    kinds = {"shell": (None, "Shell")}
    for t in load_tools()[0]:
        if t.get("run") and shutil.which(t.get("bin") or t["id"], path=TOOL_PATH):
            kinds[t["id"]] = (t["run"], t.get("label") or t["id"])
    return kinds


def run_check(cmd, timeout=15):
    """True/False from a command's exit status, None if it wouldn't answer."""
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, timeout=timeout,
                           cwd=HOME, env={**os.environ, "PATH": TOOL_PATH})
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None


def daemon_pid(daemon):
    """The daemon's pid if its pidfile names a live process, else None."""
    path = os.path.expanduser(daemon.get("pidfile") or "")
    if not path:
        return None
    try:
        with open(path) as f:
            data = json.load(f)
        pid = int(data["pid"] if isinstance(data, dict) else data)
    except (OSError, ValueError, KeyError, TypeError):
        return None
    try:
        os.kill(pid, 0)
    except PermissionError:          # someone else's process: still running
        return pid
    except OSError:
        return None
    return pid


# Logged-in is the slow bit: a login check shells out, and a CLI that hangs
# (no network, an update prompt) would hold the whole page until the timeout.
# So its answer is cached for STATE_TTL and served stale-while-revalidate:
# once an entry is old, the page still gets it at once and one background
# thread per tool asks again. Only a tool never checked before (or one whose
# cache a button just cleared) is checked inline, because the card's one
# button needs a real answer -- and one check at a time per tool: requests
# that arrive while it runs wait for that same check instead of starting
# their own (three tabs reloading after an Update cost one check, not
# three). The server also starts every tool's check as it comes up
# (warm_login_cache()), so the first page after a restart rarely waits for
# one at all. Two exceptions, both so the card is right the moment a flow
# finishes rather than a minute later:
#   * Installed is a PATH lookup, microseconds, so it is never cached.
#   * While a login-<id> or install-<id> session is still running its
#     command, an answer is used only while it is under FLOW_TTL old -- a
#     render in the middle of the flow (Back to the list, another tab) must
#     not pin the old answer, and a burst of renders still shares one check.
#     An answer from during the flow is not kept once the flow ends: the
#     next render asks again, so the card turns Ready straight away.
# /api/status never asks at all: it reports no login state (status()).
# clear_tool_cache() bumps a generation number, so a background check that
# started before a button was pressed cannot write back its older answer.
_STATE_CACHE = {}          # tid -> (expires, logged_in)
_STATE_GEN = {}            # tid -> generation, bumped by clear_tool_cache()
_STATE_BUSY = {}           # tid -> threading.Event of the check in flight for it
_STATE_FLOW = set()        # tids whose cached answer came from during a login/install
_STATE_LOCK = threading.Lock()
STATE_TTL = 60
FLOW_TTL = 3
LOGIN_CHECK_TIMEOUT = 5


def clear_tool_cache(tid=None):
    with _STATE_LOCK:
        tids = set(_STATE_CACHE) | set(_STATE_BUSY) if tid is None else {tid}
        for t in tids:
            _STATE_CACHE.pop(t, None)
            # a check already running answers its own waiters, but the next
            # request starts a fresh one rather than waiting for it
            _STATE_BUSY.pop(t, None)
            _STATE_FLOW.discard(t)
            _STATE_GEN[t] = _STATE_GEN.get(t, 0) + 1


def _check_login(tool):
    return run_check(tool["login_check"], timeout=LOGIN_CHECK_TIMEOUT)


def _run_login_check(tool, gen, ev, flow=False):
    """Run the check, cache it (unless clear_tool_cache() came in between)
    and hand it to whoever waits on ev. Returns the answer. flow: asked
    while a login/install session runs."""
    tid, val = tool["id"], None
    try:
        val = _check_login(tool)
    finally:
        with _STATE_LOCK:
            if _STATE_BUSY.get(tid) is ev:
                del _STATE_BUSY[tid]
            if _STATE_GEN.get(tid, 0) == gen:
                _STATE_CACHE[tid] = (time.time() + STATE_TTL, val)
                (_STATE_FLOW.add if flow else _STATE_FLOW.discard)(tid)
        ev.val = val
        ev.set()
    return val


def _login_flow_open(tid, panes):
    """True while a login-<tid> / install-<tid> session (auto_name may have
    added -2, -3 ...) is still running its command."""
    for kind in ("login-", "install-"):
        base = re.sub(r"[^A-Za-z0-9_-]+", "-", kind + tid).strip("-")
        pat = re.compile(re.escape(base) + r"(-[0-9]+)?")
        for s in panes:
            if pat.fullmatch(s["name"]) and not pane_exited(s.get("cmd", ""), s.get("pid")):
                return True
    return False


def logged_in_state(tool, panes):
    """The tool's login_check answer, cached as described above."""
    tid = tool["id"]
    flow = _login_flow_open(tid, panes)
    now = time.time()
    with _STATE_LOCK:
        hit = _STATE_CACHE.get(tid)
        if hit and not flow and tid in _STATE_FLOW:
            hit = None                          # from a flow that has finished: ask again
        gen = _STATE_GEN.get(tid, 0)
        ev = _STATE_BUSY.get(tid)
        # hit[0] is when the answer goes stale: checked at hit[0] - STATE_TTL
        if hit and hit[0] - STATE_TTL + (FLOW_TTL if flow else STATE_TTL) > now:
            return hit[1]
        spawn = mine = False
        if ev is None:
            ev = _STATE_BUSY[tid] = threading.Event()
            spawn = bool(hit) and not flow
            mine = not spawn
    if hit and not flow:                        # stale: served now, refreshed once
        if spawn:
            threading.Thread(target=_run_login_check, args=(tool, gen, ev),
                             name="login-check", daemon=True).start()
        return hit[1]
    if mine:
        return _run_login_check(tool, gen, ev, flow)
    ev.wait(LOGIN_CHECK_TIMEOUT + 1)            # the check in flight, not one of our own
    return getattr(ev, "val", None)


def warm_login_cache():
    """Every tool's login check, started as the server comes up, so the
    first page after a restart (an Update reloads every open one) finds the
    answers made or on their way instead of asking from scratch."""
    try:
        tools = load_tools()[0]
        if tools:
            tool_states(tools)
    except Exception as e:      # a warm-up must never take the server down
        sys.stderr.write(f"login check warm-up: {e}\n")


def tool_state(tool, names=None, login=True):
    """Everything the page needs to decide which one button to show.
    names: server_panes(), when the caller already has it. login=False
    skips the login check (logged_in is then None)."""
    tid = tool["id"]
    if names is None:
        names = server_panes()
    installed = shutil.which(tool.get("bin") or tid, path=TOOL_PATH) is not None
    logged_in = None
    if login and installed and tool.get("login_check"):
        logged_in = logged_in_state(tool, names)

    needs = tool.get("needs")
    needs_ok = True
    if needs == "node":
        needs_ok = bool(shutil.which("node", path=TOOL_PATH) and shutil.which("npm", path=TOOL_PATH))

    sess = (tool.get("server") or {}).get("session") or ""
    # Instances: the sessions serverjack started as this tool's server (see
    # server_instances()). "exited": the session is there but the command
    # has died into the fallback shell (e.g. Claude refusing an untrusted
    # directory); the error is on screen and the server can be started again.
    instances = server_instances(tool, names)
    states = {i["state"] for i in instances}
    state = "on" if "on" in states else ("exited" if "exited" in states else "off")
    return {
        "id": tid, "label": tool.get("label") or tid,
        "installed": installed, "logged_in": logged_in, "needs_ok": needs_ok,
        "daemon_running": daemon_pid(tool["daemon"]) is not None if tool.get("daemon") else False,
        "server_running": state == "on", "server_state": state,
        "server_session": instances[0]["session"] if instances else sess,
        "servers": instances,
    }


def tool_states(tools, login=True):
    """States for a whole list, checked in parallel: the page then costs about
    one login check, not one per tool."""
    if not tools:
        return []
    names = server_panes()
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(tools)) as ex:
        return list(ex.map(lambda t: tool_state(t, names, login), tools))


# ----------------------------------------------------------------- tmux ----

def _tmux_arg(a):
    """tmux reads ANY argument that ends in ";" as a command separator --
    "~/odd;" or the "\\;" closing a pasted `find ... -exec rm {} \\;` lose
    it, and the rest of the line becomes a second, broken tmux command. A
    backslash before that last ";" is tmux's own escape for a literal one.
    A bare ";" is left alone: that one is meant as a separator."""
    return a[:-1] + "\\;" if a.endswith(";") and a != ";" else a


def tmux(*args, check=False):
    if any(isinstance(a, str) and "\0" in a for a in args):
        # No session name or path holds a NUL byte, and subprocess raises on
        # one: a %00 in a URL (/s/%00, ?n=) is just a session that isn't there.
        r = subprocess.CompletedProcess(["tmux", *args], 1, "", "embedded NUL byte")
        if check:
            r.check_returncode()
        return r
    return subprocess.run(
        ["tmux", *map(_tmux_arg, args)], capture_output=True, text=True, check=check,
        env={**os.environ, "PATH": PATH_ENV},
    )


def sessions():
    # "id" is tmux's own #{session_id} ($3): it survives a rename and is never
    # reused, so the terminal page can tell "renamed" (follow it) from "ended".
    fmt = "\t".join([
        "#{session_name}", "#{session_windows}", "#{session_attached}",
        "#{session_created}", "#{pane_current_command}", "#{pane_current_path}",
        "#{session_id}",
    ])
    r = tmux("list-sessions", "-F", fmt)
    out = []
    if r.returncode != 0:
        return out                       # no server running: no sessions
    for line in r.stdout.splitlines():
        name, windows, attached, created, cmd, path, sid = (line.split("\t") + [""] * 7)[:7]
        out.append({
            "name": name, "windows": int(windows or 0),
            "attached": attached not in ("", "0"),
            "created": int(created or 0), "cmd": cmd,
            "path": path.replace(HOME, "~", 1), "id": sid,
        })
    return out


def windows(name):
    """The session's tmux windows, in index order. tmux windows are a property
    of the session, not of a client: selecting one moves every attached client,
    which is exactly what a phone and a desktop looking at the same session
    should do."""
    fmt = "\t".join(["#{window_index}", "#{window_name}", "#{window_active}",
                     "#{pane_current_command}"])
    r = tmux("list-windows", "-t", f"={name}", "-F", fmt)
    out = []
    if r.returncode != 0:
        return out
    for line in r.stdout.splitlines():
        idx, wname, active, cmd = (line.split("\t") + [""] * 4)[:4]
        if not idx.isdigit():
            continue
        out.append({"index": int(idx), "name": wname, "active": active == "1", "cmd": cmd})
    return out


def session_mouse(name):
    """Whether tmux mouse mode is on for the session (then xterm's own wheel
    reports reach tmux and the page must not scroll it a second time)."""
    r = tmux("show-options", "-A", "-v", "-t", f"={name}:", "mouse")
    return r.returncode == 0 and r.stdout.strip() == "on"


_SCROLL_ACC = {}      # session -> rows not yet turned into a page (alternate-screen panes)


def scroll_session(name, lines):
    """Scroll the pane's history from outside tmux. Positive = older.

    A pane on the alternate screen (Claude Code, less, vim, htop ...) has no
    tmux history, so copy mode would show nothing and just trap the keys:
    those get PageUp/PageDown, which such apps understand, one page per half
    a screen of travel. Everything else enters copy mode (leaving it again at
    the bottom, like a mouse wheel would) and moves by that many lines."""
    n = max(-200, min(200, lines))
    if not n:
        return
    r = tmux("display-message", "-p", "-t", f"={name}:", "#{alternate_on} #{pane_height}")
    alt, height = "0", 24
    if r.returncode == 0:
        parts = r.stdout.split()
        if len(parts) == 2 and parts[1].isdigit():
            alt, height = parts[0], max(int(parts[1]), 4)
    if alt == "1":
        acc = _SCROLL_ACC.get(name, 0) + n
        page = max(height // 2, 2)
        pages = int(acc / page)              # truncates toward zero
        _SCROLL_ACC[name] = acc - pages * page
        if pages:
            tmux("send-keys", "-t", f"={name}:", "-N", str(abs(pages)), "PageUp" if pages > 0 else "PageDown")
        return
    _SCROLL_ACC.pop(name, None)
    if n > 0:
        tmux("copy-mode", "-e", "-t", f"={name}:")
    tmux("send-keys", "-t", f"={name}:", "-X", "-N", str(abs(n)), "scroll-up" if n > 0 else "scroll-down")


def screen_text(name, lines=300):
    """Plain text of the session's active pane, last <lines> lines, wrapped
    lines joined. Used by the phone 'Copy' view where native selection works."""
    r = tmux("capture-pane", "-p", "-J", "-t", f"={name}:", "-S", f"-{int(lines)}")  # "=name:" = exact session, its current pane
    return r.stdout if r.returncode == 0 else ""


def session_exists(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


SHELLS = ("bash", "sh", "zsh", "fish", "dash")


def _shell_has_terminal(pid):
    """True when process <pid> (a pane's own process) owns its terminal's
    foreground process group -- i.e. nothing is running in front of it.
    None when /proc can't say. tpgid is field 8 of /proc/<pid>/stat; the
    command name in field 2 can hold spaces and parentheses, so the fields
    are counted from after the last ')'."""
    try:
        pid = int(pid)
        with open(f"/proc/{pid}/stat") as f:
            stat_line = f.read()
        return int(stat_line[stat_line.rindex(")") + 2:].split()[5]) == pid
    except (OSError, ValueError, IndexError):
        return None


def pane_exited(cmd, pid=None):
    """Whether a pane has dropped to a plain shell: the command a server or
    tool session was started for has exited (see command_args()).

    tmux names the pane's foreground process group, so "a shell" alone is
    not proof -- a session started by serverjack 1.5.0 kept a `bash -lc`
    wrapper in front of the command, and a tool may itself be a shell
    script. It only counts when the pane's own process is the one holding
    the terminal, which is exactly the state `exec bash -l` leaves behind.
    Without /proc to ask, the name is all there is."""
    if cmd not in SHELLS:
        return False
    owns = _shell_has_terminal(pid) if pid else None
    return True if owns is None else owns


def session_idle(name):
    """True when the session's pane is sitting at a plain shell, i.e. the
    command a server/tool session was started for has exited."""
    r = tmux("display-message", "-p", "-t", f"={name}:",
             "#{pane_current_command}\t#{pane_pid}")
    if r.returncode != 0:
        return False
    cmd, _, pid = r.stdout.strip("\n").partition("\t")
    return pane_exited(cmd, pid)


# ---------- server instances
#
# A server serverjack starts is marked with two tmux session options:
# @sj_server = the tool id, @sj_dir = the directory it was started in
# (percent-encoded: the listing below is tab- and line-separated, and a
# directory name can hold either). User options survive
# rename-session, so a server is still found after a rename, two project
# directories with the same basename get two servers, and an interactive
# session that merely happens to be called claude-remote-<x> is never taken
# for one -- or stopped by the card's Stop. A third, @sj_pane, holds the id
# of the pane the server runs in: a window opened beside it (prefix+c, the
# window tabs) or a split becomes the session's *active* pane, and a server
# judged by that plain shell read as exited -- so Start, Remove and
# autostart replaced a live server.

SERVER_MARK, SERVER_DIR_MARK, SERVER_PANE_MARK = "@sj_server", "@sj_dir", "@sj_pane"


def server_panes():
    """Every tmux session, cut down to what the agent cards need: its name,
    the server marks, and the command, pid and directory of the pane that
    matters -- a marked server's own pane (@sj_pane), wherever the active one
    is, else the session's first pane (an older server's, or a session's
    original one). "gone": the marked pane no longer exists, i.e. the server
    is not running whatever the rest of the session does.
    [] when no tmux server is running."""
    fmt = "\t".join(["#{session_name}", "#{pane_id}", "#{pane_current_command}", "#{pane_pid}",
                     "#{pane_current_path}", "#{" + SERVER_MARK + "}",
                     "#{" + SERVER_DIR_MARK + "}", "#{" + SERVER_PANE_MARK + "}"])
    r = tmux("list-panes", "-a", "-F", fmt)
    out, by_name = [], {}
    if r.returncode != 0:
        return out
    # Sessions in order, each one's windows and panes in index order: the
    # first line of a session is its first pane.
    for line in r.stdout.splitlines():
        name, pane, cmd, pid, path, mark, mdir, mpane = (line.split("\t") + [""] * 8)[:8]
        s = by_name.get(name)
        if s is None:
            s = by_name[name] = {"name": name, "cmd": cmd, "pid": pid, "path": path,
                                 "mark": mark, "mark_dir": unquote(mdir), "gone": bool(mpane)}
            out.append(s)
        if mpane and pane == mpane:
            s.update(cmd=cmd, pid=pid, path=path, gone=False)
    return out


def _legacy_server(tool, p):
    """A server started by serverjack 1.5.0 or older carries no marks. Such
    a session is still adopted when its name is the one that version gave
    it AND it was started with this server's exact command -- command_args()
    has always put that in the session's environment, and an interactive
    session holds the tool's run command there instead."""
    server = tool.get("server") or {}
    want = server_session_name(server, p["path"] or HOME)
    if p["name"] != want:
        return False
    r = tmux("show-environment", "-t", f"={p['name']}:", "SERVERJACK_CMD")
    return r.returncode == 0 and r.stdout.strip() == "SERVERJACK_CMD=" + server["cmd"].strip()


def server_instances(tool, panes):
    """The sessions that are this tool's server, as
    [{"session", "dir" (~ form), "state": "on"|"exited"}]."""
    server = tool.get("server") or {}
    if not server.get("session") or not server.get("cmd"):
        return []
    out = []
    for p in panes:
        if p["mark"]:
            if p["mark"] != tool["id"]:
                continue
            d = p["mark_dir"] or p["path"]
        elif _legacy_server(tool, p):
            d = p["path"]
        else:
            continue
        out.append({"session": p["name"], "dir": _dir_show(d) if d else "~",
                    "state": ("exited" if p.get("gone") or pane_exited(p["cmd"], p["pid"])
                              else "on")})
    return out


def same_dir(a, b):
    """Two directories, in ~ or absolute form, name the same place."""
    return _auto_dir(a) == _auto_dir(b)


def start_server(tool, cwd):
    """Start the tool's server in cwd (an absolute path). Returns
    (session name, error, started). A running instance -- for a per-dir
    server, one in this same directory -- is left alone and reported with
    error "already running"; one that exited into its shell is replaced.
    Shared by the card's Start button and autostart."""
    server = tool.get("server") or {}
    insts = server_instances(tool, server_panes())
    if server.get("per_dir"):
        insts = [i for i in insts if same_dir(i["dir"], cwd)]
    for i in insts:
        if i["state"] == "on":
            return i["session"], "already running", False
    for i in insts:                       # exited into its shell: replace it
        tmux("kill-session", "-t", f"={i['session']}")
    # Same-basename directories (~/a/app, ~/b/app) or an unrelated session
    # that already has the name: the next free one, "<name>-2".
    name = auto_name(server_session_name(server, cwd))
    err = create_command_session(name, cwd, server["cmd"],
                                 marks={SERVER_MARK: tool["id"],
                                        SERVER_DIR_MARK: quote(cwd, safe="/")},
                                 pane_mark=SERVER_PANE_MARK)
    return name, err, err is None


def server_session_name(server, cwd):
    """tmux session name for a server started in cwd: the configured name, or
    for per-directory servers "<name>-<dirname>"."""
    base = server.get("session") or "server"
    if not server.get("per_dir"):
        return base
    tail = re.sub(r"[^A-Za-z0-9_-]+", "-", os.path.basename(cwd.rstrip("/")) or "root").strip("-")
    return f"{base}-{tail or 'root'}"


def auto_name(base="shell"):
    """First free name: base, base-2, base-3 ..."""
    base = re.sub(r"[^A-Za-z0-9_-]+", "-", base).strip("-") or "shell"
    if not session_exists(base):
        return base
    n = 2
    while session_exists(f"{base}-{n}"):
        n += 1
    return f"{base}-{n}"


CMD_WRAPPERS = ("sudo", "env", "nohup", "nice", "time")
# A wrapper's options that take the NEXT word as their value: "sudo -u
# postgres psql" runs psql, not "postgres". Short forms only -- a long option
# ("--user=postgres") carries its value in the same word anyway.
WRAPPER_VALUE_FLAGS = {
    "sudo": ("-u", "-g", "-h", "-p", "-C", "-D", "-r", "-t", "-U", "-T"),
    "nice": ("-n",),
    "env": ("-u", "-C", "-S"),
    "time": ("-f", "-o"),
}


def default_session_name(kind, cwd, cmd=None):
    """The name a session gets when nothing was typed: "<type>-<directory>",
    either half optional. Type: the tool id for an agent session; for a shell
    session, the command `cmd` actually runs (basename only): wrappers like
    sudo/env/nohup/nice/time are skipped, and so are their options (with the
    value of one that takes a value) and any VAR=value assignment -- so
    "sudo apt install ffmpeg" names itself after "apt", "sudo -u nobody true"
    after "true", "env FOO=1 printenv FOO" after "printenv" -- or "shell" if
    nothing sensible remains (or there's no command at all). Directory: cwd's
    basename, omitted when cwd is HOME. The combined base is sanitized with
    auto_name's own rules and made unique the same way it already makes any
    base unique."""
    if kind == "shell":
        kind_part = "shell"
        try:
            words = shlex.split(cmd or "")
        except ValueError:              # an unbalanced quote must never stop a start
            words = (cmd or "").split()
        wrapper, skip = None, False
        for word in words:
            if skip:                    # the value of a wrapper option like sudo -u
                skip = False
                continue
            base = os.path.basename(word)
            if base in CMD_WRAPPERS:
                wrapper = base
                continue
            if word.startswith("-"):    # an option, not the command
                skip = wrapper is not None and word in WRAPPER_VALUE_FLAGS.get(wrapper, ())
                continue
            if re.match(r"[A-Za-z_][A-Za-z0-9_]*=", word):    # FOO=1 before the command
                continue
            kind_part = base
            break
    else:
        kind_part = kind
    cwd = (cwd or HOME).rstrip("/")
    dir_part = "" if cwd == HOME.rstrip("/") else os.path.basename(cwd)
    base = "-".join(p for p in (kind_part, dir_part) if p).lower()
    return auto_name(base[:60])


def taken_msg(name):
    """validate_name()'s duplicate-name error. Context-free on purpose: the
    landing page adds an "Open" button next to it, a rename says something
    else entirely (see rename_session())."""
    return f"A session called “{name}” already exists."


def validate_name(name, required=True, base="shell"):
    name = name.strip()
    if not name:
        if required:
            return None, "Give the session a name."
        return auto_name(base), None
    if any(c in name for c in ":.\t\n") or len(name) > 60:
        return None, "Session names can't contain ':' or '.' (tmux rule) or be longer than 60 chars."
    # tmux reads "=$x" (how every lookup here targets a session by exact
    # name) as the session *id* $x: a "$x" session could be created, then
    # never opened, killed or renamed -- and "$3" would hit session id 3.
    # Must be checked before session_exists(), which misreads it the same way.
    if name.startswith("$"):
        return None, "Session names can't start with “$” (tmux reads that as a session id)."
    if session_exists(name):
        return None, taken_msg(name)
    return name, None


def rename_session(old, new):
    """Rename a session. Returns (new name, error). The same name rules as a
    new session apply, duplicates included -- tmux would happily make two
    sessions ambiguous by prefix otherwise. A browser attached to the old
    name is moved on by the page's own "that session is gone" handling within
    ~15s."""
    old = (old or "").strip()
    if not old or not session_exists(old):
        return None, f"No session called “{old}” (it may have exited)."
    typed = (new or "").strip()
    if typed == old:
        return old, None            # no-op, and validate_name would call it a duplicate
    new, err = validate_name(typed, required=True)
    if err:
        if err == taken_msg(typed):     # the new-session wording would make no sense here
            err = f"Another session is already called “{typed}”. Pick a different name."
        return None, err
    # "--": the new name is a bare positional argument, so tmux's getopt would
    # read "-x" as a flag ("unknown flag -x") -- although creating "-x" works,
    # since there the name is -s's value.
    r = tmux("rename-session", "-t", f"={old}", "--", new)
    if r.returncode != 0:
        return None, (r.stderr or r.stdout).strip() or "tmux rename-session failed"
    return new, None


# ---------- prefs: small owner-editable settings (currently just the
# default directory the picker falls back to). Reuses save_private_json()
# (defined below, in the shortcuts section) for the same atomic-write,
# mode-600, no-predictable-tmpname treatment shortcuts.json and
# autostart.json get -- a default dir is not a secret, but there is no
# reason to treat it any less carefully than the files beside it.

def load_prefs():
    """The saved prefs dict, or {} for a missing or unusable prefs.json --
    same malformed-file tolerance as load_tools(): a missing file is the
    normal "nothing set yet" case, and a present-but-broken one is ignored
    (with a logged error) rather than taking the page down."""
    try:
        with open(PREFS_FILE) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            raise ValueError("expected a JSON object")
        return data
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        sys.stderr.write(f"Ignoring {PREFS_FILE}: {e}\n")
        return {}


def save_prefs(data):
    save_private_json(PREFS_FILE, data)


def default_dir():
    """The directory an empty picker, a relative typed path, and a new
    session's default name all fall back to: prefs.json's "default_dir",
    else $SERVERJACK_DEFAULT_DIR, else HOME. Always an existing absolute
    realpath -- validate_default_dir() checked that at save time, but this
    re-checks too, so a prefs.json entry that pointed at a directory since
    removed quietly falls back instead of breaking the picker."""
    d = (load_prefs().get("default_dir") or "").strip()
    if not d:
        d = (os.environ.get("SERVERJACK_DEFAULT_DIR") or "").strip()
    if d:
        d = os.path.expanduser(d)
        if os.path.isdir(d):
            return os.path.realpath(d)
    return HOME


def validate_default_dir(raw):
    """(realpath, None) or (None, error) for saving a new default_dir.
    Unlike a new session's directory, this is never created: silently
    creating one just because someone fat-fingered the default-dir field
    would be a much worse surprise here than the same typo in an ordinary
    new-session directory, where "start a shell in a new project dir" is
    the whole point. A relative typed path resolves against the *current*
    default dir, same as everywhere else in the picker."""
    d = (raw or "").strip()
    if not d:
        return None, "Give a directory."
    return resolve_dir(d, must_exist=True)


def resolve_dir(dir_value, dir_custom=None, must_exist=False):
    """(realpath, None) or (None, error): the directory a session starts in.
    The .dirpick combobox posts one "dir" field, typed or picked from its
    suggestions. dir_custom is accepted only for backward compatibility (old
    API callers, a hand-built form): when present it takes priority over
    dir_value, same as the picker's old select+typed-override pair did. An
    empty picker, and a relative typed path, both resolve against
    default_dir() -- the owner's chosen default, not always HOME.

    This only resolves; it never touches the disk. A path that doesn't exist
    yet is returned as-is and created by ensure_dir(), which
    create_session() and create_command_session() call right before tmux
    starts -- so a start that fails on its name (or anything else) leaves no
    stray folder behind, and the folder appears only when a session really
    starts in it. must_exist=True is for things saved for later (a shortcut,
    a boot entry): there a missing directory is a typo to report, not a
    folder to invent. Errors name the path in its ~ form, the way the picker
    shows it."""
    base = default_dir()
    d = (dir_custom or "").strip() or (dir_value or "").strip() or base
    d = os.path.expanduser(d)
    if not os.path.isabs(d):
        d = os.path.join(base, d)
    try:
        d = os.path.realpath(d)
    except (OSError, ValueError):       # e.g. an embedded NUL byte
        return None, "Not a directory."
    if os.path.isdir(d):
        return d, None
    if must_exist or os.path.lexists(d):
        return None, f"Not a directory: {_dir_show(d)}"
    return d, None


def ensure_dir(d):
    """None, or an error: create d (and any missing parents) if it isn't
    there yet. The one place a typed new folder becomes real -- see
    resolve_dir()."""
    if os.path.isdir(d):
        return None
    try:
        os.makedirs(d)
    except OSError as e:
        return f"Couldn't create {_dir_show(d)}: {e.strerror or e}"
    return None


def command_args(cmd):
    """tmux arguments that run one command line in front of a login shell.

    The command goes in through the environment, never interpolated into the
    script, so there are no quoting games. The login shell afterwards is the
    point of the whole thing: a sudo prompt can ask for a password, and
    whatever the command printed last -- an error, a login URL, a QR code --
    is still on screen when it exits, instead of the session vanishing.

    Debian's /etc/profile resets PATH for every login shell, which is exactly
    what `bash -lc` below starts -- so a tool that's only reachable via
    TOOL_PATH (nvm's bin dir, a tool's private "paths" entry) would report
    "installed" from tool_kinds() and then fail to start with "command not
    found". Fixed by re-exporting TOOL_PATH as the very first thing the
    login shell does, after its own startup files (and their PATH reset)
    have already run and before the command is looked up -- so a plain
    PATH lookup of the unmodified command text finds it. Deliberately does
    NOT rewrite `cmd` to an absolute path: the echoed "$ <cmd>" line and the
    pane's reported process name are user-facing (and, for the demo GIF,
    public), and a resolved path would bake in TOOL_PATH's actual location
    -- a throwaway fixture directory, someone's home directory -- instead of
    just naming the tool. shutil.which(..., path=TOOL_PATH) is still how
    tool_kinds() decides a tool is "installed" in the first place; it just
    isn't used here to change what gets run."""
    cmd = cmd.strip()
    # set -m, in both shells: job control gives each command its own process
    # group and makes it the terminal's foreground group. tmux names a pane
    # after that group, so the pane reports the command itself (claude,
    # sleep ...), not one of these wrappers -- which is how a server that is
    # running is told from one that has exited (pane_exited()) -- and a ^C
    # reaches only the command. The inner `bash -lc` needs its own: without
    # it the command shares the inner shell's group and the pane says
    # "bash" for as long as the command runs.
    inner = f'set -m; export PATH={shlex.quote(TOOL_PATH)}:"$PATH"; eval "$SERVERJACK_CMD"'
    return ["-n", (cmd.split() or ["cmd"])[0], "-e", "SERVERJACK_CMD=" + cmd,
            'set -m; printf "\\$ %s\\n" "$SERVERJACK_CMD"; bash -lc '
            + shlex.quote(inner) + '; '
            'rc=$?; echo; echo "[exited with status $rc]"; exec bash -l']


def create_command_session(name, cwd, cmd, marks=None, pane_mark=None):
    """A session that runs one command in front of a login shell. marks:
    tmux user options to set on it in the same tmux call, so no listing
    ever sees the session without them (see start_server()). pane_mark: a
    user option set to the new pane's id, the pane the command runs in.
    Creates cwd first if it is a new folder (see resolve_dir())."""
    err = ensure_dir(cwd)
    if err:
        return err
    extra = []
    for key, value in (marks or {}).items():
        extra += [";", "set-option", "-t", f"={name}:", key, value]
    if pane_mark:
        extra += [";", "set-option", "-F", "-t", f"={name}:", pane_mark, "#{pane_id}"]
    r = tmux("new-session", "-d", "-s", name, "-c", cwd, "-e", f"PATH={TOOL_PATH}",
             *command_args(cmd), *extra)
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip() or "tmux new-session failed"
    return None


def create_session(kind, name, cwd, command=None):
    """kind: 'shell' or a tool id from tool_kinds(). command: for shells, a
    command line to run first (the user typed it; it IS meant to be run)."""
    kinds = tool_kinds()
    if kind not in kinds:
        return "Unknown session type."
    err = ensure_dir(cwd)               # a new folder, typed on purpose: see resolve_dir()
    if err:
        return err
    cmd, _label = kinds[kind]
    args = ["new-session", "-d", "-s", name, "-c", cwd, "-e", f"PATH={TOOL_PATH}"]
    if cmd or (command and command.strip()):
        args += command_args(cmd or command)
    r = tmux(*args)
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip() or "tmux new-session failed"
    return None


# ---------- shortcuts: user-defined one-click commands, stored as JSON


def save_private_json(path, items):
    """Atomically save owner-only configuration without a predictable temp
    filename. Shortcut commands can contain credentials, and autostart entries
    expose project paths, so neither file should inherit a permissive umask."""
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    safe_dir(CONFIG_DIR, "config dir")
    fd, tmp = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", dir=CONFIG_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(items, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def clean_cmd(cmd):
    """A typed command line, ready to run. Browsers submit every newline in a
    <textarea> as CRLF (the urlencoded form serializer does that on every
    engine), and bash splits words on newlines only -- so each line but the
    last ran with a stray "\\r" glued to its last word ("cd: $'projects\\r':
    No such file or directory"). A lone CR becomes a newline too rather than
    vanishing, or two old-Mac-style lines would run as one."""
    return (cmd or "").replace("\r\n", "\n").replace("\r", "\n").strip()


def load_shortcuts():
    """The saved shortcuts. Commands are cleaned on the way in, so one saved
    with CRLF line endings before clean_cmd() existed runs correctly too
    (shortcuts.json itself is rewritten the next time anything is saved).
    The file is documented and hand-edited, so an id, label or dir written
    as a number is read as text: the page links to /?edit_sc=<id> and
    compares ids with the form's strings."""
    try:
        with open(SHORTCUTS_FILE) as f:
            data = json.load(f)
        items = [x for x in data if isinstance(x, dict) and x.get("id") and x.get("cmd")]
    except (OSError, ValueError):
        return []
    for x in items:
        x["cmd"] = clean_cmd(str(x["cmd"]))
        for k in ("id", "label", "dir"):
            if x.get(k) is not None and not isinstance(x[k], str):
                x[k] = str(x[k])
    return [x for x in items if x["cmd"]]


def save_shortcuts(items):
    save_private_json(SHORTCUTS_FILE, items)


def _shortcut_label(label, cmd):
    """The label as stored: what was typed, else the command's first word."""
    return ((label or "").strip() or cmd.split()[0])[:60]


def wants_save(f):
    """Does a Start (or /run) form ask to keep its command as a shortcut?
    With the page script on, the form carries save_ui and the "Keep this
    command" box alone decides: typing a shortcut name ticks it, and
    unticking it afterwards means no. Without the script nothing ticks the
    box for you, so a typed shortcut name counts as asking -- it used to be
    thrown away unless the box was ticked too."""
    if f.get("save_ui"):
        return bool(f.get("save"))
    return bool(f.get("save")) or bool(f.get("label", "").strip())


def add_shortcut(label, cmd, cwd):
    """Append one shortcut. Returns the label it was saved under."""
    cmd = clean_cmd(cmd)
    label = _shortcut_label(label, cmd)
    items = load_shortcuts()
    sid = f"{int(time.time())}-{len(items)}"
    items.append({"id": sid, "label": label, "cmd": cmd, "dir": cwd})
    save_shortcuts(items)
    return label


def update_shortcut(sid, label, cmd, cwd):
    """Edit one shortcut in place: same id, same position in the list.
    Returns (label, None), or (None, error) for an id that isn't a saved
    shortcut -- including the built-in Update row, which can't be edited."""
    cmd = clean_cmd(cmd)
    items = load_shortcuts()
    for x in items:
        if x["id"] == sid and sid != UPDATE_ID:
            x.update(label=_shortcut_label(label, cmd), cmd=cmd, dir=cwd)
            save_shortcuts(items)
            return x["label"], None
    return None, "That shortcut no longer exists."


def shortcut_session_name(sc, cwd):
    """A shortcut run is named after the shortcut ("Disk usage" -> disk-usage,
    then disk-usage-2), not its command's first word: two shortcuts that both
    start with `cd` or `docker` would otherwise share one name family, and the
    tab strip would never say which shortcut a session came from. A label
    with nothing usable in it (all punctuation or emoji) falls back to the
    command, as a Start with no name does."""
    base = re.sub(r"[^a-z0-9_-]+", "-", (sc.get("label") or "").lower()).strip("-")[:60]
    return auto_name(base) if base else default_session_name("shell", cwd, sc["cmd"])


# ---------- the one built-in shortcut: update serverjack itself
#
# install.sh restarts the serverjack unit at the end. The unit is KillMode=
# process, so the tmux server (and this session) outlive the restart: the
# command finishes in front of its login shell like any other, and the browser
# reconnects to the same session as soon as the new process is listening.

UPDATE_ID = "builtin-update"
# Absolute path: this runs inside a login shell in a fresh tmux session, not
# necessarily with the unit's own PATH, and install.sh puts serverjack-ctl
# at exactly this path for a managed install.
SERVERJACK_CTL_PATH = os.path.join(HOME, ".local", "bin", "serverjack-ctl")
if CHANNEL == "release":
    UPDATE_CMD = shlex.quote(SERVERJACK_CTL_PATH) + " update"
    UPDATE_WHAT = ("Downloads and verifies the latest release, switches to it, and rolls "
                   "back if it doesn't come up; the terminal reconnects when it restarts.")
else:
    UPDATE_CMD = f"cd {shlex.quote(REPO)} && git pull --ff-only && bash install.sh"
    UPDATE_WHAT = ("Pulls the latest commit and re-runs the installer, which restarts "
                   "serverjack; the terminal reconnects when it restarts.")


def update_cmd_show():
    """UPDATE_CMD as the Update row displays it: the same command with the
    home directory written as ~, like every other path on the page. Display
    only -- UPDATE_CMD (quoted, absolute) is what runs."""
    if CHANNEL == "release":
        return _dir_show(SERVERJACK_CTL_PATH) + " update"
    return f"cd {_dir_show(REPO)} && git pull --ff-only && bash install.sh"


def update_available():
    """A15: CHANNEL == "release" only means this process physically lives
    under ~/.local/share/serverjack/releases/ (_install_channel() decides
    that from realpath alone) -- NOT that ~/.local/bin/serverjack-ctl
    actually exists there. A tarball someone extracted by hand into
    releases/<v>/ (never run through the bootstrap or install.sh) is
    exactly that case: the Update row used to show anyway and launch a
    command that doesn't exist. Gate it on the binary UPDATE_CMD actually
    runs being present and executable."""
    if CHANNEL == "release":
        return os.access(SERVERJACK_CTL_PATH, os.X_OK)
    return CHANNEL == "git"


# ---------- autostart: servers and daemons to bring up when serverjack starts
#
# One entry per thing to start: {"tool": id, "kind": "server"|"daemon",
# "dir": path}. "dir" only means anything for a server (it decides the session
# name for per_dir servers, and the directory it runs in). The entry means
# "make sure this is running when serverjack starts" -- so stopping something
# from the page removes its entry, and a deliberate stop does not come back
# after a restart.

def _auto_dir(d):
    d = os.path.expanduser(d or HOME)
    try:
        return os.path.realpath(d)
    except ValueError:                  # an embedded NUL byte (a hand-edited file)
        return d


def load_autostart():
    try:
        with open(AUTOSTART_FILE) as f:
            data = json.load(f)
        return [x for x in data if isinstance(x, dict) and x.get("tool")
                and x.get("kind") in ("server", "daemon")]
    except (OSError, ValueError):
        return []


def save_autostart(items):
    save_private_json(AUTOSTART_FILE, items)


def _auto_match(e, tid, kind, cwd):
    if e.get("tool") != tid or e.get("kind") != kind:
        return False
    if kind != "server":
        return True
    return _auto_dir(e.get("dir")) == _auto_dir(cwd)


def autostart_on(tid, kind, cwd=None):
    return any(_auto_match(e, tid, kind, cwd) for e in load_autostart())


def set_autostart(tid, kind, cwd, on, per_dir=True):
    """per_dir=False: a server that only ever runs once keeps one entry,
    whichever directory it was ticked in, so ticking replaces it and
    unticking removes it."""
    items = [e for e in load_autostart() if not _auto_match(e, tid, kind, cwd)
             and (per_dir or kind != "server" or e.get("tool") != tid or e.get("kind") != kind)]
    if on:
        e = {"tool": tid, "kind": kind}
        if kind == "server":
            e["dir"] = _auto_dir(cwd)
        items.append(e)
    save_autostart(items)


def drop_autostart(pred):
    """Remove every entry pred() says yes to (a Stop from the page)."""
    items = load_autostart()
    keep = [e for e in items if not pred(e)]
    if len(keep) != len(items):
        save_autostart(keep)


def autostart_start_one(e):
    """Start one autostart entry if it isn't already up. Returns a log line."""
    t = find_tool(e.get("tool") or "")
    if not t:
        return f"autostart: no such tool {e.get('tool')!r}, skipped"
    tid = t["id"]
    if e["kind"] == "daemon":
        daemon = t.get("daemon") or {}
        if not daemon.get("start"):
            return f"autostart: {tid} has no daemon, skipped"
        if daemon_pid(daemon) is not None:
            return f"autostart: {tid} daemon already running"
        r = subprocess.run(daemon["start"], shell=True, capture_output=True, text=True,
                           timeout=120, cwd=HOME, env={**os.environ, "PATH": TOOL_PATH})
        if r.returncode != 0:
            tail = ((r.stderr or "") + (r.stdout or "")).strip().splitlines()[-1:] or [""]
            return f"autostart: {tid} daemon start failed ({r.returncode}) {tail[0]}"
        return f"autostart: started {tid} daemon"

    server = t.get("server") or {}
    if not server.get("cmd") or not server.get("session"):
        return f"autostart: {tid} has no server, skipped"
    cwd = _auto_dir(e.get("dir"))
    if not os.path.isdir(cwd):
        return f"autostart: {tid} server directory is gone: {cwd}"
    name, err, _started = start_server(t, cwd)
    if err == "already running":
        return f"autostart: {tid} server “{name}” already running"
    if err:
        return f"autostart: {tid} server “{name}” failed: {err}"
    return f"autostart: started {tid} server “{name}” in {cwd}"


def autostart_boot():
    """Run the autostart list once, a little after startup. The delay is for
    boot: network-online.target is not the same thing as DNS answering, and
    every one of these commands wants the network."""
    items = load_autostart()
    if not items:
        return
    time.sleep(AUTOSTART_DELAY)
    for e in items:
        try:
            line = autostart_start_one(e)
        except (OSError, subprocess.SubprocessError) as exc:
            line = f"autostart: {e.get('tool')} {e.get('kind')} failed: {exc}"
        sys.stderr.write(line + "\n")
    clear_tool_cache()


def dir_choices():
    seen = []
    for root in DIR_ROOTS:
        if os.path.isdir(root) and root not in seen:
            seen.append(root)
        try:
            for e in sorted(os.scandir(root), key=lambda e: e.name.lower()):
                if e.is_dir() and not e.name.startswith(".") and e.path not in seen:
                    seen.append(e.path)
        except OSError:
            pass
    return seen


# ------------------------------------------------------- directory search --
# Backs GET /api/dirs?q= (the .dirpick combobox's only data source, see
# DIRPICK_JS). Three modes, chosen by the shape of q:
#   ""            the old dropdown's own list: HOME, then DIR_ROOTS and their
#                  first-level children, in DIR_ROOTS order (dir_choices()).
#   has a "/", or starts with "~"
#                  path completion: split into parent + partial last
#                  component and list the parent's matching child dirs. This
#                  is how any path gets reached, DIR_ROOTS or not.
#   otherwise      name search over a cached recursive index of DIR_ROOTS
#                  (dir_index()), so "3d-lab" finds a directory by that name
#                  no matter how deep it is nested.
_DIR_INDEX_CACHE = None   # (built_at, entries, truncated); see dir_index()


def _dir_walk(dirpath, root, depth, deadline, entries, truncated):
    """Depth-first into dirpath (already known to exist), appending
    (abs_path, depth, root) for every non-hidden, non-pruned subdirectory,
    stopping at DIR_DEPTH, DIR_INDEX_CAP or the wall-clock deadline.
    truncated is a one-element list used as an outparam."""
    if truncated[0]:
        return
    if time.time() > deadline:
        truncated[0] = True
        return
    try:
        children = sorted(os.scandir(dirpath), key=lambda e: e.name.lower())
    except OSError:
        return
    for e in children:
        if len(entries) >= DIR_INDEX_CAP:
            truncated[0] = True
            return
        if time.time() > deadline:
            truncated[0] = True
            return
        if e.name.startswith(".") or e.name in DIR_PRUNE:
            continue
        try:
            if not e.is_dir(follow_symlinks=False):
                continue
        except OSError:
            continue
        entries.append((e.path, depth, root))
        if depth < DIR_DEPTH:
            _dir_walk(e.path, root, depth + 1, deadline, entries, truncated)


def _index_roots():
    """DIR_ROOTS, plus the current default_dir() when it is not already
    reachable from one of them -- so a default dir picked from outside
    SERVERJACK_DIRS still gets indexed and turns up in a name search, not
    just in _dir_search_empty()'s own explicit "default dir first" list.
    "Reachable" covers both directions: the default dir already being one of
    DIR_ROOTS or nested under one (the usual case -- HOME is always a
    DIR_ROOTS entry, and that's the fallback), or a DIR_ROOTS entry being
    nested under the default dir instead, which would make indexing it
    separately just re-walk that root's own content a second time under a
    different root tag (and, since dir_index()'s DIR_DEPTH cap is relative
    to whichever root reached a path, at a different depth -- see
    _dir_walk())."""
    d = default_dir()
    roots = list(DIR_ROOTS)
    for r in roots:
        if (d == r or d.startswith(r.rstrip(os.sep) + os.sep)
                or r.startswith(d.rstrip(os.sep) + os.sep)):
            return roots
    return roots + [d]


def dir_index():
    """(entries, truncated). entries is every directory under
    _index_roots(), as (abs_path, depth, root) -- depth 0 is a root entry
    itself -- hidden names, DIR_PRUNE names and anything past DIR_DEPTH left
    out. Rebuilt at most once every DIR_INDEX_TTL seconds (module-level
    cache), so a default dir changed via /prefs can take up to that long to
    show up in a name search."""
    global _DIR_INDEX_CACHE
    now = time.time()
    if _DIR_INDEX_CACHE is not None and now - _DIR_INDEX_CACHE[0] < DIR_INDEX_TTL:
        return _DIR_INDEX_CACHE[1], _DIR_INDEX_CACHE[2]
    entries = []
    truncated = [False]
    deadline = now + DIR_INDEX_BUDGET
    for root in _index_roots():
        if not os.path.isdir(root):
            continue
        if len(entries) >= DIR_INDEX_CAP:
            truncated[0] = True
            break
        entries.append((root, 0, root))
        if DIR_DEPTH > 0:
            _dir_walk(root, root, 1, deadline, entries, truncated)
        if truncated[0]:
            break
    _DIR_INDEX_CACHE = (now, entries, truncated[0])
    return entries, truncated[0]


def _dir_rank(path, root, q):
    """None (no match) or a rank: 0 exact basename, 1 basename prefix,
    2 basename substring, 3 substring of the path relative to its root --
    the fallback that lets an ancestor's name surface a deep result too.
    Ranks 0-2 are "name matches"; _dir_search_name() sorts those ahead of
    every rank-3 "path match" and, within each group, by nesting depth
    first (least nested first) with this rank only breaking ties at the
    same depth -- see its docstring."""
    base = os.path.basename(path).lower()
    q = q.lower()
    if base == q:
        return 0
    if base.startswith(q):
        return 1
    if q in base:
        return 2
    if q in os.path.relpath(path, root).lower():
        return 3
    return None


def _path_depth(path):
    """How many components an absolute path has below the filesystem root
    -- "/" -> 0, "/home" -> 1, "/home/plongriss/projects" -> 3. Deliberately
    NOT the (path, depth, root) tuples dir_index() itself hands back: those
    depths are relative to whichever SERVERJACK_DIRS root indexed a path
    (and stay that way -- see DIR_DEPTH capping in _dir_walk()), so the same
    real directory could otherwise sort differently depending on which root
    happened to reach it first. Ranking needs an absolute, root-independent
    depth instead: "~ is shallower than ~/projects" has to hold regardless
    of which configured root a match came from."""
    return len([p for p in path.rstrip(os.sep).split(os.sep) if p])


def _dir_search_name(q):
    """Least-nested-first: every match is a shallower-depth-wins comparison
    first, and only a rank (exact/prefix/substring/name-vs-path) breaks a
    tie at the same depth. Concretely, two buckets:
      - "name" matches (rank 0-2, the query is in the basename itself),
        sorted by (depth, rank, path) -- so a shallow prefix match like
        ~/foo-bar always outranks a deeper exact match like
        ~/a/b/foo, and exact only beats prefix beats substring among
        matches at the very same depth.
      - "path" matches (rank 3, the query is only in an ancestor's name --
        i.e. this is some matching folder's child), sorted by (depth, path)
        and placed AFTER every name match regardless of depth, so drilling
        into a matching folder's children never pushes a real name match
        down the list.
    A path can be indexed more than once (two SERVERJACK_DIRS roots where
    one is nested under the other both walk it), so keep each path's best
    (lowest) rank rather than letting it appear twice -- depth is a
    property of the path itself (_path_depth()), not of which root found
    it, so there is nothing to pick between there."""
    entries, truncated = dir_index()
    best = {}
    for path, _depth, root in entries:
        rank = _dir_rank(path, root, q)
        if rank is None:
            continue
        cur = best.get(path)
        if cur is None or rank < cur:
            best[path] = rank
    scored = []
    for path, rank in best.items():
        bucket = 1 if rank == 3 else 0     # 0: name match, 1: path-only match
        scored.append((bucket, _path_depth(path), rank, path.lower(), path))
    scored.sort(key=lambda t: t[:4])
    return [p for *_, p in scored[:15]], truncated


def _expand_home(q):
    """A ~-prefix expansion keyed to this module's own HOME, not
    os.path.expanduser()'s (the real process environment / passwd database) --
    the two coincide outside tests, where HOME is computed from
    os.path.expanduser("~") once at import time, but a test overriding HOME
    directly (the pattern the rest of this file's tests already use) needs
    dir search to actually follow it."""
    if q.startswith("~/"):
        return HOME + q[1:]
    if q == "~":
        return HOME
    return q


def _dir_search_path(q):
    if q.rstrip("/") == "~":
        parent, partial = HOME, ""
    else:
        expanded = _expand_home(q)
        if not os.path.isabs(expanded):     # relative: against the default dir, as resolve_dir() does
            expanded = os.path.join(default_dir(), expanded)
        parent, partial = os.path.split(expanded)
        parent = parent or "/"
    partial = partial.lower()
    out = []
    try:
        for e in sorted(os.scandir(parent), key=lambda e: e.name.lower()):
            if e.name.startswith(".") or not e.name.lower().startswith(partial):
                continue
            try:
                if not e.is_dir(follow_symlinks=False):
                    continue
            except OSError:
                continue
            out.append(e.path)
            if len(out) >= 15:
                break
    except OSError:
        return [], False
    return out, False


def _dir_search_empty():
    """The default dir and its own first-level children first (so the
    common case -- starting a session right where you usually do -- needs
    no typing at all), then HOME, then dir_choices()'s own order for
    whatever isn't already listed -- exactly the old dropdown's list, just
    with ~ moved up front (dir_choices() itself is untouched: dir_options()
    used to do this same reordering). When the default dir IS HOME (the
    common case before anyone ever changes it), this is unchanged from
    before default dirs existed: HOME, then its children, then the rest."""
    d = default_dir()
    head = [d]
    try:
        for e in sorted(os.scandir(d), key=lambda e: e.name.lower()):
            if e.is_dir() and not e.name.startswith("."):
                head.append(e.path)
    except OSError:
        pass
    seen = set(head)
    out = list(head)
    for p in [HOME] + dir_choices():
        if p not in seen:
            out.append(p)
            seen.add(p)
    return out, False


def _dir_show(path):
    return path.replace(HOME, "~", 1) if path == HOME or path.startswith(HOME + os.sep) else path


def _dir_create(q):
    """The folder submitting q as typed would create -- resolve_dir()'s own
    answer, so the two can't disagree -- or None when that folder already
    exists, q is empty, or q names something that isn't a directory. The
    picker offers it as an explicit "+ New folder" row, so a new folder is a
    choice you can see rather than a side effect of a search term. ~ is
    expanded against this module's HOME first, like the rest of dir search
    (_expand_home()); outside tests that is resolve_dir()'s own answer."""
    if not q.strip():
        return None
    d, err = resolve_dir(_expand_home(q.strip()))
    if err or os.path.isdir(d):
        return None
    return {"path": d, "show": _dir_show(d)}


def dir_search(q):
    """Body of GET /api/dirs?q=. Returns (http_status, json_obj): "dirs",
    the existing matches, and "create", the new folder a submit of q would
    make (see _dir_create()), present only when there is one."""
    if len(q) > 512:
        return 400, {"error": "query too long"}
    if not q:
        dirs, truncated = _dir_search_empty()
    elif "/" in q or q.startswith("~"):
        dirs, truncated = _dir_search_path(q)
    else:
        dirs, truncated = _dir_search_name(q)
    out = {"q": q, "dirs": [{"path": p, "show": _dir_show(p)} for p in dirs],
           "truncated": truncated}
    create = _dir_create(q)
    if create:
        out["create"] = create
    return 200, out


def system_stats():
    """Load, memory, free disk and uptime, straight from the kernel. Every
    value is optional: anything this platform doesn't answer is left out, and
    both callers (the muted line under the tagline and /api/status) just skip
    what isn't there. Cheap enough to do per request -- no caching."""
    out = {}
    try:
        out["load"] = [round(x, 2) for x in os.getloadavg()]
    except (OSError, AttributeError):
        pass
    try:
        info = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.split()[0])          # kB
        total, avail = info.get("MemTotal", 0), info.get("MemAvailable")
        if total and avail is not None:
            out["mem_used_pct"] = round(100.0 * (total - avail) / total)
    except (OSError, ValueError, IndexError):
        pass
    try:
        out["disk_free_gb"] = round(shutil.disk_usage(HOME).free / 1e9, 1)
    except OSError:
        pass
    try:
        with open("/proc/uptime") as f:
            out["uptime_s"] = int(float(f.read().split()[0]))
    except (OSError, ValueError, IndexError):
        pass
    return out


def human_uptime(s):
    d, rem = divmod(int(s), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m"


def human_free(gb):
    return f"{gb / 1000:.1f} TB" if gb >= 1000 else f"{gb:.0f} GB"


def system_line():
    """load 0.42 · mem 61% · 1.2 TB free · up 12d 4h -- whatever we could get."""
    s = system_stats()
    bits = []
    if s.get("load"):
        bits.append(f"load {s['load'][0]:.2f}")
    if s.get("mem_used_pct") is not None:
        bits.append(f"mem {s['mem_used_pct']}%")
    if s.get("disk_free_gb") is not None:
        bits.append(f"{human_free(s['disk_free_gb'])} free")
    if s.get("uptime_s") is not None:
        bits.append("up " + human_uptime(s["uptime_s"]))
    return " &middot; ".join(bits)


def status():
    """The dashboard summary behind /api/status. Counts only -- no session
    names, no directories, not even the agents' labels: a tile on a wall-
    mounted dashboard should say how busy the box is, and this route is the one
    thing SERVERJACK_ALLOW cannot check an identity on."""
    names = sessions()
    tools = load_tools()[0]
    agents = []
    # No login checks: nothing here reports them, and this route answers
    # anyone SERVERJACK_ALLOW lets through without an identity.
    for st in tool_states(tools, login=False):
        agents.append({
            "id": st["id"], "installed": st["installed"],
            "servers_running": sum(1 for i in st["servers"] if i["state"] == "on"),
            "daemon_running": st["daemon_running"],
        })
    servers_on = sum(a["servers_running"] for a in agents)
    daemons_on = sum(1 for a in agents if a["daemon_running"])
    parts = [f"{servers_on} server" + ("s" if servers_on != 1 else ""),
             f"{daemons_on} daemon" + ("s" if daemons_on != 1 else "")]
    out = {
        "sessions": len(names),
        "attached": sum(1 for s in names if s["attached"]),
        "agents": agents,
        "agents_summary": " · ".join(parts),
        "version": VERSION,
        "channel": CHANNEL,
    }
    out.update(system_stats())
    return out


def session_facts(s):
    """The short half of a session row's meta line, as HTML: "attached" (as a
    word, not just the dot's colour, and first so a phone's ellipsis can't
    cut it), the window count when there is more than one, and the age. The
    path and command follow it and are what a narrow row gives up first.
    "attached" is aria-hidden because the dot already says it to a screen
    reader. paint() in LAND_JS rebuilds the same thing in place."""
    rest = " · ".join(x for x in (
        f"{s['windows']} windows" if s["windows"] > 1 else "",
        session_age(s["created"])) if x)
    att = ""
    if s["attached"]:
        att = '<span aria-hidden="true"><b class="att">attached</b>' + (" &middot; " if rest else "") + "</span>"
    return att + esc(rest).replace(" · ", " &middot; ")


def session_age(created, now=None):
    """How long a session has existed, in the word the sysline already uses
    for the machine ("up 12d 4h"), to one unit so it fits a phone's row:
    "up <1m", "up 5m", "up 3h", "up 2d". It is the session's age, not its
    last activity -- a bare "5m ago" read as the latter. The landing page's
    script computes the same string in place (age() in LAND_JS), so the two
    must stay in step."""
    if not created:
        return ""
    s = max(0, int(time.time() if now is None else now) - int(created))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"up {s // n}{unit}"
    return "up <1m"


# ------------------------------------------------------------ self-check ---
#
# `--check` (also spelled `--doctor`): a read-only "why won't this start"
# pass, meant to be run by hand after a reboot or before wiring the unit up
# for the first time. Every check only reads state -- unlike safe_dir() above
# (which is allowed to fix a stray mode bit, because it is about to bind a
# socket there anyway), self_check() never repairs anything. Each line is
# printed as ok/warn/fail; the process exits non-zero the moment any line is
# "fail". A "warn" is something worth a look but not a reason this won't run.

def _bin_version(name, path, flag="--version"):
    """First line of `<name> <flag>`, or None if it's not on PATH at all."""
    exe = shutil.which(name, path=path)
    if not exe:
        return None
    try:
        r = subprocess.run([exe, flag], capture_output=True, text=True, timeout=5)
        out = ((r.stdout or "") + (r.stderr or "")).strip().splitlines()
        return out[0] if out else exe
    except (OSError, subprocess.SubprocessError):
        return exe


def _listen_target_busy():
    """True if something is already listening where we would bind, False if
    it's free, None if we couldn't tell. Not a failure either way -- a
    running serverjack is the expected reason it's busy -- just context for
    "why won't the unit start"."""
    try:
        if LISTEN == "tcp":
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            try:
                s.settimeout(1)
                return s.connect_ex(BIND) == 0
            finally:
                s.close()
        return os.path.exists(WEB_SOCK)
    except OSError:
        return None


def self_check():
    """(lines, ok). lines are (level, text) pairs, level in ok/warn/fail."""
    lines = []

    def add(level, text):
        lines.append((level, text))

    v = sys.version_info
    add("ok" if v >= (3, 9) else "fail",
        f"python {v.major}.{v.minor}.{v.micro}"
        + ("" if v >= (3, 9) else " -- serverjack needs 3.9 or newer"))

    tmux_v = _bin_version("tmux", PATH_ENV, "-V")
    add("ok" if tmux_v else "fail",
        f"tmux: {tmux_v}" if tmux_v else "tmux not found on PATH")

    ttyd_v = _bin_version("ttyd", PATH_ENV)
    add("ok" if ttyd_v else "fail",
        f"ttyd: {ttyd_v}" if ttyd_v
        else "ttyd not found on PATH (install.sh puts it in ~/.local/bin)")

    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if not xdg:
        add("warn", "XDG_RUNTIME_DIR not set -- falling back to /tmp/serverjack-<uid> "
                    "(still locked to 0700 and owner-checked, but set it if you can)")
    else:
        try:
            mode = stat.S_IMODE(os.stat(xdg).st_mode)
            add("ok" if mode == 0o700 else "warn", f"XDG_RUNTIME_DIR={xdg} mode {mode:04o}")
        except OSError as e:
            add("fail", f"XDG_RUNTIME_DIR={xdg}: {e}")

    try:
        st = os.stat(CONFIG_DIR)
        mode = stat.S_IMODE(st.st_mode)
        owned = st.st_uid == os.getuid()
        add("ok" if (mode == 0o700 and owned) else "warn",
            f"config dir {CONFIG_DIR} mode {mode:04o}" + ("" if owned else " (not owned by us)"))
    except FileNotFoundError:
        add("ok", f"config dir {CONFIG_DIR} does not exist yet (created on first save)")
    except OSError as e:
        add("warn", f"config dir {CONFIG_DIR}: {e}")

    env_file = os.path.join(CONFIG_DIR, "env")
    if os.path.exists(env_file):
        try:
            mode = stat.S_IMODE(os.stat(env_file).st_mode)
            add("ok" if mode == 0o600 else "warn",
                f"env file {env_file} mode {mode:04o}"
                + ("" if mode == 0o600 else " (tighten with chmod 600 -- systemd reads it)"))
        except OSError as e:
            add("warn", f"env file {env_file}: {e}")
    else:
        add("ok", f"env file {env_file} not present (read by systemd, not this process)")

    try:
        r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            name = (json.loads(r.stdout).get("Self") or {}).get("DNSName", "").rstrip(".")
            add("ok", f"tailscale reachable ({name or 'no DNS name yet'})")
        else:
            add("warn", "tailscale installed but not answering (tailscaled down?) -- "
                        "optional, only needed for tailnet identity")
    except FileNotFoundError:
        add("warn", "tailscale not on PATH -- optional, only needed for tailnet identity")
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        add("warn", f"tailscale status failed: {e}")

    busy = _listen_target_busy()
    where = f"{BIND[0]}:{BIND[1]}" if LISTEN == "tcp" else WEB_SOCK
    if busy is None:
        add("warn", f"could not tell whether {where} is free")
    elif busy:
        add("ok", f"{where} already has a listener (fine if that's a running serverjack)")
    else:
        add("ok", f"{where} is free")

    ok = not any(level == "fail" for level, _ in lines)
    return lines, ok


# ----------------------------------------------------------------- html ----

# ---------------------------------------------------------------- theme ----
#
# One token block, shared by the landing page and the terminal wrapper. Colours,
# spacing, radii and focus come from docs/design/DESIGN.md; system fonts only, no
# webfonts, no external assets -- the page has to work offline and anywhere.

TOKENS = """
:root{
  --bg-primary:#080f0e; --bg-secondary:#111815; --surface:#1a2420; --surface-alt:#232e28;
  --border:#2f3f36; --border-soft:#1f2a25;
  --text-primary:#e6f7e9; --text-secondary:#9fb3a8; --text-muted:#93a79d;
  --accent:#39ff88; --accent-dim:#1ed06a; --on-accent:#04140c;
  --warning:#ffc857; --danger:#ff5f56; --info:#58a6ff; --agent-purple:#c678ff;
  --accent-wash:rgb(57 255 136 / .10); --danger-wash:rgb(255 95 86 / .12);
  --space-1:4px; --space-2:8px; --space-3:16px; --space-4:24px; --space-5:32px; --space-6:48px;
  --radius-xs:4px; --radius-sm:8px; --radius-md:12px; --radius-lg:16px; --radius-xl:24px;
  --font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --font-ui:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --glass-bg:rgb(17 24 21 / .82); --glass-border:rgb(159 179 168 / .18); --glass-blur:18px;
  --focus-ring:0 0 0 3px rgb(57 255 136 / .24);
}
"""


def _token(name):
    """A single value out of TOKENS, e.g. _token("bg-primary") -> "#080f0e".
    The only place that reads the raw CSS text -- everything else that wants
    a token color (the terminal theme below, in particular) goes through
    this, so TOKENS stays the one place these colors are hand-typed."""
    m = re.search(r"--" + re.escape(name) + r":\s*([^;]+);", TOKENS)
    if not m:
        raise SystemExit(f"serverjack: token --{name} missing from TOKENS")
    return m.group(1).strip()


def _hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _term_theme():
    """The terminal's xterm.js color theme, generated from TOKENS instead of
    hand-typed -- this used to be duplicated in bin/serverjack-ttyd, this
    function is now the only place it is written out. Printed as JSON by
    `python3 bin/serverjack --print-theme`, which bin/serverjack-ttyd calls
    to get the value it hands ttyd as -t theme=... (a server option, not a
    URL query -- ttyd clients too old to read a ?theme=... query, which is
    how this used to be delivered, would otherwise silently ignore it).
    TERM_THEME is None (so --print-theme prints nothing) when
    SERVERJACK_TERM_THEME=off, or when TTYD_EXTRA_ARGS already sets its own
    -t theme=... (TTYD_EXTRA_ARGS_HAS_THEME, from
    _ttyd_extra_args_has_theme()): the point of detecting that is to let the
    user's own theme apply instead of bin/serverjack-ttyd adding a second,
    conflicting -t theme=... after it. See docs/design/DESIGN.md's
    "Terminal theme" section for the full key-by-key mapping and reasoning.

    Most keys reuse an app token outright. `cyan`/`brightCyan` and the plain
    `bright*` tints have no matching semantic role in the app UI -- xterm.js
    wants all 16 ANSI slots filled, so those are hand-picked here instead of
    derived, kept in this one function rather than retyped anywhere else."""
    accent = _token("accent")
    r, g, b = _hex_rgb(accent)
    return {
        "background": _token("bg-primary"),
        "foreground": _token("text-primary"),
        "cursor": accent,
        # The background token, not the accent: xterm.js paints the
        # non-blinking block cursor as a solid `cursor`-colored cell with the
        # character drawn in `cursorAccent` on top. Setting the two equal
        # (the bug this replaced) drew the glyph in the same color as its
        # own background -- invisible while the cursor sat on it.
        "cursorAccent": _token("bg-primary"),
        "selectionBackground": f"rgba({r},{g},{b},0.3)",
        "black": _token("surface-alt"),
        "red": _token("danger"),
        "green": accent,
        "yellow": _token("warning"),
        "blue": _token("info"),
        "magenta": _token("agent-purple"),
        "cyan": "#56d4c8",           # terminal-only: no app token for cyan
        "white": _token("text-secondary"),
        "brightBlack": "#3f5148",    # hand-picked tints below, not token-derived --
        "brightRed": "#ff7b72",      # standard ANSI hues stay recognizable but
        "brightGreen": "#6dffab",    # readable against --bg-primary, which reads
        "brightYellow": "#ffd479",   # xterm.js's own stock dark colors as
        "brightBlue": "#7fb8ff",     # near-invisible
        "brightMagenta": "#d896ff",
        "brightCyan": "#7ee8db",     # terminal-only, brightened tint of cyan above
        "brightWhite": _token("text-primary"),
    }


# TTYD_EXTRA_ARGS_HAS_THEME: a user's own -t/--client-option theme=... in
# TTYD_EXTRA_ARGS also skips generating this, the same as
# SERVERJACK_TERM_THEME=off -- see _ttyd_extra_args_has_theme() above for
# why (ttyd applies the URL query last, so ours would otherwise silently
# win over theirs).
TERM_THEME = None if (TERM_THEME_OFF or TTYD_EXTRA_ARGS_HAS_THEME) else _term_theme()
TERM_THEME_JSON = json.dumps(TERM_THEME) if TERM_THEME else None

