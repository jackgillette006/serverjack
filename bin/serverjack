I_EDIT = _svg('<path d="M4 20h4l10-10a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l4 4"/>')
I_PLUS = _svg('<path d="M12 5.5v13"/><path d="M5.5 12h13"/>', 18)
I_KEYBOARD = _svg('<rect x="2.5" y="6" width="19" height="12" rx="2"/>'
                  '<path d="M7 10h.01M11 10h.01M15 10h.01M17.5 10h.01M7.5 14h9"/>', 18)
I_CLOSE = _svg('<path d="M6.5 6.5l11 11"/><path d="M17.5 6.5l-11 11"/>', 18)
