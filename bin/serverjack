# hidden id (sc_id) that makes /shortcuts/add replace that entry in place.
ADD_SHORTCUT_CARD = """<details class="card" id="addsc"{addsc_open}><summary>{sc_title}</summary>
<form class="row" method="post" action="/shortcuts/add">{sc_id}
  <div><label for="sc_label">Name</label>
  <input id="sc_label" name="label" maxlength="60" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="e.g. Deploy" value="{sc_label}"></div>
  <div><label for="sc_cmd">Command to run</label>
  <textarea id="sc_cmd" name="cmd" rows="2" required autocapitalize="off" spellcheck="false" placeholder="e.g. ./deploy.sh &amp;&amp; docker compose logs -f">{sc_cmd}</textarea></div>
