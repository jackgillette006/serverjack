APP_JS = r"""
(function () {
  'use strict';
  var TERM = window.SJ.term, cur = window.SJ.name, TITLE = window.SJ.title;
  // The terminal is served by serverjack itself (it reverse-proxies ttyd), so
  // this URL goes through the same peer-uid and identity checks as the page.
  function termSrc(name) { return TERM + '?arg=' + encodeURIComponent(name); }
  var body = document.body, POP = body.classList.contains('popout');
  var frame = document.getElementById('frame'), tabs = document.getElementById('tabs');
  var pop = document.getElementById('pop'), err = document.getElementById('err');
  var isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || '') || /Mac OS X/.test(navigator.userAgent);
  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

  // ---- terminal helpers (same-origin frame, so we can reach into ttyd's page)
  function tdoc() { try { return frame.contentDocument; } catch (e) { return null; } }
  function textarea() { var d = tdoc(); return d && d.querySelector('.xterm-helper-textarea'); }
  function focusTerm() {
    var tries = 0;
    (function f() {
      var ta = textarea();
      if (ta) { ta.focus(); body.classList.remove('conn'); }
      else if (tries++ < 40) setTimeout(f, 100); else body.classList.remove('conn');
    })();
  }
  // ---- CRT effects. .fx arrives on <body> from the server so the power-on
  // plays before this script runs; localStorage overrides it, the toggle writes it.
  var fxb = document.getElementById('fxt'), fxls = null;
  try { fxls = localStorage.getItem('sj-fx'); } catch (e) {}
  function fxSet(on, save) {
    body.classList.toggle('fx', on);
    fxb.textContent = 'CRT fx: ' + (on ? 'on' : 'off');
    if (save) try { localStorage.setItem('sj-fx', on ? '1' : '0'); } catch (e) {}
  }
  fxSet(fxls === '0' ? false : fxls === '1' || body.classList.contains('fx'), false);
  fxb.onclick = function () { fxSet(!body.classList.contains('fx'), true); };
  function powerOff(go) {
    if (!body.classList.contains('fx')) return go();
    var done = false, fire = function () { if (!done) { done = true; go(); } };
    body.classList.add('off');
    body.addEventListener('animationend', fire, {once: true});
    setTimeout(fire, 130);
  }
  var KEYS = { Escape: 27, Tab: 9, ArrowUp: 38, ArrowDown: 40, ArrowLeft: 37, ArrowRight: 39,
               PageUp: 33, PageDown: 34, Enter: 13, Backspace: 8, Delete: 46, Home: 36, End: 35 };
  function sendKey(key, mods) {
    var ta = textarea(); if (!ta) return;
    mods = mods || {};
    var code = KEYS[key] || key.toUpperCase().charCodeAt(0);
    var init = { key: key, keyCode: code, which: code, bubbles: true, cancelable: true,
                 ctrlKey: !!mods.ctrl, shiftKey: !!mods.shift, altKey: !!mods.alt };
    var ev = new frame.contentWindow.KeyboardEvent('keydown', init);
    if (ev.keyCode !== code) {           // Safari ignores keyCode in the init dict
      Object.defineProperty(ev, 'keyCode', { get: function () { return code; } });
      Object.defineProperty(ev, 'which', { get: function () { return code; } });
    }
    ta.dispatchEvent(ev);
  }

  // ---- inside the frame: clipboard shortcuts + Ctrl-armed soft keys
  var ctrlArmed = false, swallowInput = false;
  function hook() {
    var d = tdoc(); if (!d || d.__sj) return; d.__sj = true;
    d.addEventListener('keydown', function (e) {
      if (!e.isTrusted) return;
      // Ctrl armed from the soft key row: next character goes as Ctrl+<char>
      if (ctrlArmed && e.key && e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
        e.preventDefault(); e.stopPropagation(); swallowInput = true;
        disarm(); sendKey(e.key.toLowerCase(), { ctrl: true }); return;
      }
      if (isMac || !e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
      // Windows/Linux: xterm.js only offers Ctrl+Shift+C/V. Make Ctrl+V paste
      // (stop xterm seeing it, so the browser's native paste fires xterm's
      // paste handler) and Ctrl+C copy when there is a selection, else SIGINT.
      if (e.key === 'v' || e.key === 'V') { e.stopPropagation(); return; }
      if (e.key === 'c' || e.key === 'C') {
        var copied = false;
        function seen(ev) { copied = ev.defaultPrevented; }   // xterm preventDefaults only when it copied a selection
        d.addEventListener('copy', seen);
        try { d.execCommand('copy'); } catch (_) {}
        d.removeEventListener('copy', seen);
        if (copied) { e.preventDefault(); e.stopPropagation(); }
      }
    }, true);
    // WebKit also fires keypress for Ctrl+V; xterm would turn it into ^V.
    d.addEventListener('keypress', function (e) {
      if (!isMac && e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey && (e.key === 'v' || e.key === 'V')) e.stopPropagation();
    }, true);
    d.addEventListener('beforeinput', function (e) {
      if (swallowInput) { e.preventDefault(); swallowInput = false; return; }
      if (ctrlArmed && e.inputType === 'insertText' && e.data && e.data.length === 1) {
        e.preventDefault(); disarm(); sendKey(e.data.toLowerCase(), { ctrl: true });
      }
    }, true);
  }
  // Feed text to the terminal exactly as a paste (xterm applies bracketed
  // paste when the app asked for it, so multi-line text is safe).
  function sendText(text) {
    var ta = textarea(), w = frame.contentWindow; if (!ta || !text) return false;
    try {
      var dt = new w.DataTransfer(); dt.setData('text/plain', text);
      var ev = new w.ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true });
      if (!ev.clipboardData) throw new Error('no clipboardData');
      ta.dispatchEvent(ev); return true;
    } catch (e) {
      // Older WebKit: InputEvent path (no bracketed paste, but text arrives)
      try { ta.dispatchEvent(new w.InputEvent('input', { data: text, inputType: 'insertText', bubbles: true })); return true; }
      catch (e2) { return false; }
    }
  }
  // Touch devices: stretch xterm's invisible textarea over the whole terminal
  // so touch-and-hold brings up the native Paste callout, and taps focus it.
  function touchCss() {
    var d = tdoc(); if (!d || !touch || d.getElementById('sj-touch')) return;
    var st = d.createElement('style'); st.id = 'sj-touch';
    // fixed + viewport units: the textarea's parent (.xterm-helpers) has no size, so % would collapse to 0
    st.textContent = '.xterm-helper-textarea{position:fixed!important;left:0!important;top:0!important;width:100vw!important;height:100vh!important;opacity:0!important;z-index:20!important;-webkit-user-select:text!important;user-select:text!important;caret-color:transparent}';
    (d.head || d.documentElement).appendChild(st);
  }
  // Finger swipe -> wheel events. xterm.js answers touch by scrolling its
  // own viewport, which is empty under tmux (tmux keeps the history), so a
  // swipe did nothing. Wheel events, though, reach tmux as mouse scroll when
  // `set -g mouse on`, and tmux opens its history. One wheel per row of
  // finger travel; a tap or a long-press (no travel) is left alone so the
  // native Paste callout still works.
  // Scrolling. xterm.js answers a swipe or a wheel by scrolling its own
  // viewport, which is empty under tmux (tmux keeps the history). So the page
  // scrolls tmux itself: rows go to POST /api/scroll, which enters copy mode
  // and moves by that many lines (and leaves copy mode at the bottom). That
  // needs no `mouse on`, so a mouse drag still selects text for copying. If
  // the session does have mouse mode on, xterm's own wheel reports already
  // reach tmux, so wheels pass through and swipes become wheel events.
  var MOUSE = false, scrollQ = 0, scrollT = null, wheelAcc = 0;
  function flushScroll() {
    scrollT = null; var n = scrollQ; scrollQ = 0; if (!n || !cur) return;
    fetch('/api/scroll', { method: 'POST', body: new URLSearchParams({ name: cur, lines: n }) }).catch(function () {});
  }
  function queueScroll(rows) { scrollQ += rows; if (!scrollT) scrollT = setTimeout(flushScroll, 40); }
  function pollMouse() {
    fetch('/api/scroll?name=' + encodeURIComponent(cur), { cache: 'no-store' })
      .then(function (r) { return r.json(); }).then(function (j) { MOUSE = !!j.mouse; }).catch(function () {});
  }
  function rowH() { var d = tdoc(), r = d && d.querySelector('.xterm-rows > div'); return (r && r.offsetHeight) || 18; }
  function onWheel(e) {
    if (MOUSE || e.ctrlKey) return;                       // mouse mode: xterm reports it; ctrl+wheel: browser zoom
    e.preventDefault(); e.stopPropagation();
    wheelAcc += e.deltaMode === 1 ? e.deltaY : e.deltaY / rowH();
    var n = Math.trunc(wheelAcc); if (n) { wheelAcc -= n; queueScroll(-n); }   // wheel down => newer
  }
  // Chromium hands the first wheel over an iframe to the parent document
  // (target = the iframe element) before it latches onto the frame.
  document.addEventListener('wheel', function (e) { if (e.target === frame) onWheel(e); }, { capture: true, passive: false });
  function scrollHooks() {
    var d = tdoc(); if (!d || d.__sjScroll) return; d.__sjScroll = true;
    var w = frame.contentWindow, lastY = null, acc = 0, moved = false;
    d.addEventListener('wheel', onWheel, { capture: true, passive: false });
    if (!touch) return;
    d.addEventListener('touchstart', function (e) {
      if (e.touches.length !== 1) { lastY = null; return; }
      lastY = e.touches[0].clientY; acc = 0; moved = false;
    }, { capture: true, passive: true });
    d.addEventListener('touchmove', function (e) {
      if (lastY === null || e.touches.length !== 1) return;
      var y = e.touches[0].clientY; acc += y - lastY; lastY = y;
      if (!moved && Math.abs(acc) < 8) return;            // a wobble during a long-press is not a swipe
      moved = true; e.preventDefault();
      var h = rowH(), target = d.querySelector('.xterm-screen') || d.querySelector('.xterm');
      while (Math.abs(acc) >= h) {
        var older = acc > 0; acc += older ? -h : h;       // finger down => older lines
        if (MOUSE && target) target.dispatchEvent(new w.WheelEvent('wheel', { deltaY: older ? -h : h, deltaMode: 0, bubbles: true, cancelable: true }));
        else queueScroll(older ? 1 : -1);
      }
    }, { capture: true, passive: false });
    d.addEventListener('touchend', function () { lastY = null; }, { capture: true, passive: true });
  }
  frame.addEventListener('load', function () { hook(); touchCss(); scrollHooks(); pollMouse(); focusTerm(); });

  // ---- soft key row
  var ctrlBtn = document.getElementById('ctrl');
  function disarm() { ctrlArmed = false; ctrlBtn.classList.remove('armed'); }
  function setKeys(on) { body.classList.toggle('keys', on); document.getElementById('keysbtn').classList.toggle('on', on);
    try { localStorage.setItem('sj-keys', on ? '1' : '0'); } catch (_) {} }
  var saved = null; try { saved = localStorage.getItem('sj-keys'); } catch (_) {}
  setKeys(saved === null ? touch : saved === '1');
  document.getElementById('keysbtn').onclick = function () { setKeys(!body.classList.contains('keys')); focusTerm(); };
  Array.prototype.forEach.call(document.querySelectorAll('#keys .k[data-k], #ctrl'), function (b) {
    b.addEventListener('pointerdown', function (e) {
      e.preventDefault();                       // keep focus (and the soft keyboard) on the terminal
      if (b.id === 'ctrl') { ctrlArmed = !ctrlArmed; ctrlBtn.classList.toggle('armed', ctrlArmed); return; }
      var mods = { ctrl: !!b.dataset.ctrl || ctrlArmed, shift: !!b.dataset.shift };
      if (ctrlArmed) disarm();
      sendKey(b.dataset.k, mods);
    });
  });

  // ---- Paste / Copy buttons
  function flash(btn, text) { var old = btn.textContent; btn.textContent = text; setTimeout(function () { btn.textContent = old; }, 1200); }
  document.getElementById('paste').addEventListener('pointerdown', function (e) { e.preventDefault(); });
  document.getElementById('paste').addEventListener('click', function () {
    var btn = this;
    // No clipboard API, or permission denied: touch-and-hold the terminal
    // brings up the browser's own Paste callout instead.
    if (!navigator.clipboard || !navigator.clipboard.readText) { flash(btn, 'hold to paste'); focusTerm(); return; }
    navigator.clipboard.readText().then(function (t) {
      if (!t) { flash(btn, 'empty'); return; }
      sendText(t); focusTerm();
    }).catch(function () { flash(btn, 'hold to paste'); focusTerm(); });
  });
  var screen = document.getElementById('screen'), screenText = document.getElementById('screen-text');
  function loadScreen() {
    return fetch('/api/screen?name=' + encodeURIComponent(cur) + '&lines=400', { cache: 'no-store' })
      .then(function (r) { return r.text(); })
      .then(function (t) {
        screenText.innerHTML = '';
        t.split('\n').forEach(function (line) {
          var d = document.createElement('div'); d.className = 'ln'; d.textContent = line || ' ';
          d.title = 'tap to copy this line';
          d.onclick = function () {
            var txt = line.trim(); if (!txt) return;
            var done = function () { d.classList.add('copied'); setTimeout(function () { d.classList.remove('copied'); }, 900); };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(done, function () {});
            else { var r = document.createRange(); r.selectNodeContents(d); var sel = getSelection(); sel.removeAllRanges(); sel.addRange(r); try { document.execCommand('copy'); done(); } catch (e) {} }
          };
          screenText.appendChild(d);
        });
        screenText.scrollTop = screenText.scrollHeight;
      });
  }
  document.getElementById('copy').addEventListener('pointerdown', function (e) { e.preventDefault(); });
  document.getElementById('copy').addEventListener('click', function () { screen.hidden = false; loadScreen(); });
  document.getElementById('screen-refresh').onclick = loadScreen;
  document.getElementById('screen-close').onclick = function () { screen.hidden = true; focusTerm(); };
  document.getElementById('screen-copy').onclick = function () {
    var btn = this;
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(screenText.textContent).then(function () { flash(btn, 'Copied'); }, function () { flash(btn, 'select text'); });
    else flash(btn, 'select text');
  };

  // ---- iOS: the soft keyboard doesn't shrink the layout viewport, so track
  // the visual viewport and size the page to it (keeps the key row visible).
  if (window.visualViewport) {
    var vv = window.visualViewport;
    function fit() {
      if (Math.abs(window.innerHeight - vv.height) < 2 && vv.offsetTop === 0) { body.style.height = ''; body.style.top = ''; return; }
      body.style.height = vv.height + 'px'; body.style.top = vv.offsetTop + 'px';
    }
    vv.addEventListener('resize', fit); vv.addEventListener('scroll', fit);
  }

  // ---- session tabs
  function pageUrl(name) { return '/s/' + encodeURIComponent(name) + (POP ? '?popout=1' : ''); }
  function setUrl(name) { history.replaceState(null, '', pageUrl(name)); document.title = name + ' · ' + TITLE; }
  function switchTo(name) {
    if (name === cur) { focusTerm(); return; }
    cur = name; WINS = []; closeWins(); body.classList.add('conn');
    frame.src = termSrc(name);
    setUrl(name); refresh();
  }

  // ---- tmux windows of the current session. They belong to the session, not
  // to this client: selecting one moves every attached client, which is what
  // you want when the phone and the desktop are on the same session.
  var WINS = [], winmenu = document.getElementById('winmenu');
  function closeWins() { winmenu.hidden = true; }
  function paintBadge() {
    var t = tabs.querySelector('.tab.on'); if (!t) return;
    var old = t.querySelector('.wb'); if (old) old.parentNode.removeChild(old);
    if (WINS.length < 2) return;
    var pos = 0; WINS.forEach(function (w, i) { if (w.active) pos = i + 1; });
    var b = document.createElement('span'); b.className = 'wb';
    b.textContent = '\u00b7 ' + pos + '/' + WINS.length;
    t.appendChild(b);
    t.title = WINS.length + ' windows \u2014 tap to switch';
  }
  function fillWins() {
    winmenu.innerHTML = '';
    WINS.forEach(function (w) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = w.active ? 'on' : '';
      if (w.active) b.setAttribute('aria-current', 'true');
      var i = document.createElement('span'); i.className = 'wi';
      i.textContent = (w.active ? '\u25b8' : '') + w.index;
      var n = document.createElement('span'); n.className = 'wn'; n.textContent = w.name;
      var c = document.createElement('span'); c.className = 'wc'; c.textContent = w.cmd || '';
      b.appendChild(i); b.appendChild(n); b.appendChild(c);
      b.onclick = function () { selectWin(w.index); };
      winmenu.appendChild(b);
    });
  }
  function openWins(anchor) {
    if (WINS.length < 2) { focusTerm(); return; }      // one window: nothing to pick
    if (!winmenu.hidden) { closeWins(); focusTerm(); return; }
    fillWins(); winmenu.hidden = false; winmenu.style.left = '0px';
    var r = anchor.getBoundingClientRect();
    winmenu.style.top = (r.bottom + 4) + 'px';
    winmenu.style.left = Math.max(4, Math.min(r.left, innerWidth - winmenu.offsetWidth - 8)) + 'px';
    var first = winmenu.querySelector('button.on') || winmenu.querySelector('button');
    if (first) first.focus();
  }
  function selectWin(index) {
    fetch('/api/window', { method: 'POST',
                           body: new URLSearchParams({ name: cur, index: index }) })
      .then(function () { closeWins(); focusTerm(); return loadWins(); })
      .catch(function () { closeWins(); });
  }
  function loadWins() {
    return fetch('/api/windows?name=' + encodeURIComponent(cur), { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : []; })
      .then(function (list) {
        WINS = Array.isArray(list) ? list : [];
        paintBadge();
        if (!winmenu.hidden) fillWins();
      }).catch(function () {});
  }
  function render(list) {
    tabs.innerHTML = '';
    var present = false;
    list.forEach(function (s) {
      if (s.name === cur) present = true;
      var b = document.createElement('button');
      b.className = 'tab' + (s.name === cur ? ' on' : '');
      b.textContent = s.name;
      b.title = s.cmd + ' · ' + s.path;
      b.onclick = function () {
        if (s.name === cur) openWins(b); else switchTo(s.name);
      };
      tabs.appendChild(b);
    });
    paintBadge();
    var on = tabs.querySelector('.on'); if (on) on.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    // current session gone (exited / killed elsewhere): move on instead of
    // sitting on a dead terminal
    if (!present && cur !== null) { if (list.length) { cur = null; switchTo(list[0].name); } else location.href = '/'; }
  }
  function refresh() {
    return fetch('/api/sessions', { cache: 'no-store' }).then(function (r) { return r.json(); })
      .then(render).then(loadWins).catch(function () {});
  }
  function syncKind() {
    var k = (pop.querySelector('input[name=kind]:checked') || {}).value || 'shell';
    pop.elements.name.required = (k !== 'shell');
    pop.elements.name.placeholder = (k === 'shell') ? 'auto (shell, shell-2, …)' : 'e.g. fit-app';
  }
  pop.addEventListener('change', syncKind); syncKind();
  document.getElementById('add').onclick = function () {
    pop.classList.toggle('open'); err.classList.remove('on');
    if (pop.classList.contains('open')) pop.elements.name.focus();
  };
  // Close means close: the session keeps running (kill it from its menu on
  // the landing page). Pop-out window: close it; normal tab: back to the list.
  document.getElementById('close').onclick = function () {
    if (POP) { window.close(); setTimeout(function () { location.href = '/'; }, 150); return; }
    powerOff(function () { location.href = '/'; });
  };
  pop.onsubmit = function (e) {
    e.preventDefault(); err.classList.remove('on');
    fetch('/api/new', { method: 'POST', body: new URLSearchParams(new FormData(pop)) })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.error) { err.textContent = j.error; err.classList.add('on'); return; }
        pop.classList.remove('open'); pop.reset();
        switchTo(j.name);
      })
      .catch(function () { err.textContent = 'request failed'; err.classList.add('on'); });
  };
  document.getElementById('popout').onclick = function () {
    // "popup" asks for a window without tabs/address bar. Named per session
    // so a second pop-out refocuses instead of attaching twice; this tab then
    // goes back to the list so it isn't attached too.
    var w = window.open('/s/' + encodeURIComponent(cur) + '?popout=1', 'serverjack-' + cur, 'popup=yes,width=1000,height=650');
    if (w) { w.focus(); location.href = '/'; }
  };
  if (touch) body.classList.add('touch');
  document.querySelector('#bar a.ib').onclick = function (e) {
    if (!POP) return;                 // normal tab: just go to the list
    e.preventDefault(); window.close();
    setTimeout(function () { location.href = '/'; }, 150);   // couldn't close (not script-opened): navigate
  };
  document.getElementById('handle').onclick = function () {
    body.classList.toggle('showbar');
    if (!body.classList.contains('showbar')) { pop.classList.remove('open'); focusTerm(); }
  };
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { pop.classList.remove('open'); closeWins(); }
  });
  document.addEventListener('click', function (e) {
    if (winmenu.hidden) return;
    if (!winmenu.contains(e.target) && !(e.target.closest && e.target.closest('#tabs .tab.on'))) closeWins();
  });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
  setInterval(refresh, 15000);
  body.classList.add('conn');
  refresh(); hook(); touchCss(); scrollHooks(); pollMouse(); focusTerm();
})();
"""


def esc(s):
    return html.escape(str(s), quote=True)


def term_href(name):                 # the wrapper page with the menu bar
    return f"/s/{quote(name, safe='')}"


def ttyd_src(name):                  # what the wrapper's frame loads
    # ttyd -a turns the single ?arg= into argv[1] for bin/tmux-attach.sh: the
    # session name. TERM_PATH is served by this same process (proxy_term).
    return f"{TERM_PATH}?arg={quote(name, safe='')}"


def js(obj):
    """JSON for a <script> block. A "</" anywhere inside would end the element
    early (the HTML parser does not know it is in a string), and "<!--" starts
    a script comment; both are escaped so no user-controlled name can break
    out into markup."""
    return json.dumps(obj).replace("</", "<\\/").replace("<!--", "<\\!--")


def kind_options():
    return "\n".join(
        f'<label><input type="radio" name="kind" value="{esc(k)}"{" checked" if i == 0 else ""}><span>{esc(label)}</span></label>'
        for i, (k, (_, label)) in enumerate(tool_kinds().items()))


def dir_options():
    """<option> list for every directory picker on the page. ~ always comes
    first and pre-selected -- dir_choices()'s own order (a real project dir
    first, ~ last) is untouched, only reordered here, so every picker on the
    page defaults to the same place."""
    dirs = dir_choices()
    ordered = [HOME] + [d for d in dirs if d != HOME]
    return "\n".join(
        f'<option value="{esc(d)}"{" selected" if d == HOME else ""}>'
        f'{esc(d.replace(HOME, "~", 1))}</option>'
        for d in ordered)


def note(text):
    return f'<p class="note">{text}</p>' if text else ""


# Attribute, not an inline handler: the page's delegated submit listener
# reads data-confirm. The {} is filled with esc()'d text by every caller.
CONFIRM = ' data-confirm="Stop {}?"'


def orow(label, note_text, buttons, hint="", cls=""):
    """One option row: what it is + the one-line difference, then the button."""
    left = ""
    if label or note_text:
        left = ('<div class="ol"><div class="olabel">' + label + "</div>"
                + (f'<p class="onote">{note_text}</p>' if note_text else "")
                + "</div>")
    return (f'<div class="orow{cls}">' + left + '<div class="ob">' + buttons + "</div>"
            + (f'<span class="hint">{hint}</span>' if hint else "") + "</div>")


def tool_card(t, st, dirs, open_=False):
    """One row of the agents accordion: a summary that is readable while
    collapsed, and a body with one option row per way of starting the tool."""
    tid = t["id"]
    hid = f'<input type="hidden" name="id" value="{esc(tid)}">'
    docs = (f'<a class="docs" href="{esc(t["docs"])}" target="_blank" rel="noopener">Docs &#8599;</a>'
            if t.get("docs") else "")
    daemon, server = t.get("daemon") or {}, t.get("server") or {}
    sstate = st.get("server_state", "off")
    ready = st["installed"] and st["logged_in"] is not False

    # ---- summary: label, state, and any server/daemon pills, all inline ----
    if not st["installed"]:
        state = '<span class="state off">Not installed</span>'
    elif not ready:
        state = '<span class="state warn">Installed &middot; not logged in</span>'
    else:
        bits = ["<b>Ready</b>"]
        if daemon:
            on = st["daemon_running"]
            bits.append(f'<i class="pill{" on" if on else ""}">'
                        f'{esc(daemon.get("label") or "Daemon")}: '
                        f'{"running" if on else "stopped"}</i>')
        if server and server.get("per_dir"):
            # One pill per instance, each naming its directory: "running" alone
            # would hide the fact that it only serves that one project.
            label = esc(server.get("label") or "Server")
            if not st["servers"]:
                bits.append(f'<i class="pill">{label}: stopped</i>')
            for inst in st["servers"]:
                cls = " on" if inst["state"] == "on" else " warn"
                word = "running" if inst["state"] == "on" else "exited"
                bits.append(f'<i class="pill{cls}">{label}: {word} &middot; {esc(inst["dir"])}</i>')
        elif server:
            word = {"on": "running", "exited": "exited", "off": "stopped"}[sstate]
            cls = {"on": " on", "exited": " warn", "off": ""}[sstate]
            bits.append(f'<i class="pill{cls}">{esc(server.get("label") or "Server")}: '
                        f'{word}</i>')
        state = '<span class="state">' + "".join(bits) + "</span>"

    out = [f'<details class="tool" id="tool-{esc(tid)}" name="agent"{" open" if open_ else ""}>',
           '<summary><span class="sumline">'
           f'<span class="name">{esc(st["label"])}</span>{state}</span>{I_CHEV}</summary>',
           '<div class="tbody">']

    # One form per tool: every button in it shares the directory picker and
    # says in its value which route it wants (see the module docstring). The
    # daemon and the server's Stop keep their own forms (no directory, and a
    # confirm of their own); their buttons sit in the option rows via form=.
    dirline = (f'<div class="dirline"><select name="dir">{dirs}</select>'
               '<input name="dir_custom" autocomplete="off" autocapitalize="off"'
               ' spellcheck="false" placeholder="\u2026or type a path (created if new)"></div>')

    def main_form(inner, with_dir=True):
        return ('<form method="post" action="/tools">' + hid
                + (dirline if with_dir else "") + inner + "</form>")

    # "start at boot". Same form= trick as Stop: the checkbox sits in the
    # option row, its form is hidden below. picker=True means "whatever the
    # directory picker says at the moment you tick it" (the Start rows).
    def autostart_box(fid, kind, cwd=None, picker=False):
        on = autostart_on(tid, kind, cwd)
        form = (f'<form method="post" action="/tools/autostart" id="{fid}" hidden>' + hid
                + f'<input type="hidden" name="kind" value="{kind}">'
                + f'<input type="hidden" name="dir" value="{esc(cwd or "")}"></form>')
        box = (f'<label class="ab" title="Start this when serverjack starts">'
               f'<input class="autostart" type="checkbox" form="{fid}" name="on" value="1"'
               + (" checked" if on else "") + (' data-picker="1"' if picker else "")
               + "> start at boot</label>")
        return form, box

    if not st["installed"]:
        if not st["needs_ok"]:
            out.append(note("Needs Node.js (node + npm), which isn\u2019t installed on this server."))
        elif t.get("install"):
            out.append('<form method="post" action="/tools/install">' + hid
                       + '<button class="btn sec wide" type="submit">Install</button></form>')
            out.append(note("Runs in a terminal so you can watch it: "
                            f'<code>{esc(t["install"])}</code>'))
            out.append(note(esc(t.get("install_note", ""))))
        else:
            out.append(note("No install command is configured for this tool."))

    elif not ready:
        out.append('<form method="post" action="/tools/login">' + hid
                   + '<button class="btn sec wide" type="submit">Log in</button></form>')
        out.append(note(esc(t.get("login_note", ""))))

    else:
        rows, aux = [], []

        for i, a in enumerate(t.get("actions") or []):
            label = esc(a.get("label") or a.get("cmd", ""))
            word = "Open" if a.get("dir") else "Run"
            rows.append(orow(label, esc(a.get("note", "")),
                             '<button class="btn sm sec" type="submit" name="do" '
                             f'value="/tools/action:{i}">{word}</button>'))

        if server and server.get("per_dir"):
            # One row per running/exited instance (Stop + Open), then a Start
            # row for the directory picked above.
            label = server.get("label") or "server"
            for n, inst in enumerate(st["servers"]):
                fid = f"f-{esc(tid)}-server-{n}"
                aux.append(f'<form method="post" action="/tools/server" id="{fid}" hidden'
                           + CONFIRM.format(esc(label)) + ">" + hid
                           + '<input type="hidden" name="action" value="stop">'
                           + f'<input type="hidden" name="session" value="{esc(inst["session"])}"></form>')
                href = esc(term_href(inst["session"]))
                aform, abox = autostart_box(f"a-{esc(tid)}-server-{n}", "server", inst["dir"])
                aux.append(aform)
                if inst["state"] == "on":
                    btns = (abox
                            + f'<button class="btn sm sec" type="submit" form="{fid}">Stop</button>'
                            f'<a class="btn sm sec" href="{href}">Open</a>')
                    rows.append(orow(f'{esc(label)} &middot; <code>{esc(inst["dir"])}</code>',
                                     "Running for this directory.", btns))
                else:
                    btns = (abox + f'<a class="btn sm sec" href="{href}">Open</a>'
                            f'<button class="btn sm sec" type="submit" form="{fid}">Remove</button>')
                    rows.append(orow(f'{esc(label)} &middot; <code>{esc(inst["dir"])}</code>',
                                     "It exited; Open shows why.", btns))
            aform, abox = autostart_box(f"a-{esc(tid)}-server-new", "server", picker=True)
            aux.append(aform)
            rows.append(orow(f"Start {esc(label)}", esc(server.get("note", "")),
                             abox + '<button class="btn sm sec" type="submit" name="do" '
                             'value="/tools/server">Start</button>'))
        elif server:
            label = server.get("label") or "server"
            href = esc(term_href(st["server_session"]))
            if sstate == "on":
                fid = f"f-{esc(tid)}-server"
                aux.append(f'<form method="post" action="/tools/server" id="{fid}" hidden'
                           + CONFIRM.format(esc(label)) + ">" + hid
                           + '<input type="hidden" name="action" value="stop"></form>')
                aform, abox = autostart_box(f"a-{esc(tid)}-server", "server",
                                            st["servers"][0]["dir"] if st["servers"] else HOME)
                aux.append(aform)
                btns = (abox
                        + f'<button class="btn sm sec" type="submit" form="{fid}">Stop</button>'
                        f'<a class="btn sm sec" href="{href}">Open</a>')
                rows.append(orow(esc(label), esc(server.get("note", "")), btns))
            else:
                aform, abox = autostart_box(f"a-{esc(tid)}-server", "server", picker=True)
                aux.append(aform)
                btns = abox
                if sstate == "exited":
                    btns += f'<a class="btn sm sec" href="{href}">Open</a>'
                btns += ('<button class="btn sm sec" type="submit" name="do" '
                         'value="/tools/server">Start</button>')
                rows.append(orow(esc(label), esc(server.get("note", "")), btns,
                                 hint=("It exited; Open shows why. Start replaces it."
                                       if sstate == "exited" else "")))

        if daemon:
            label = daemon.get("label") or "daemon"
            running = st["daemon_running"]
            act, word = ("stop", "Stop") if running else ("start", "Start")
            fid = f"f-{esc(tid)}-daemon"
            aux.append(f'<form method="post" action="/tools/daemon" id="{fid}" hidden'
                       + (CONFIRM.format(esc(label)) if running else "") + ">" + hid
                       + f'<input type="hidden" name="action" value="{act}"></form>')
            aform, abox = autostart_box(f"a-{esc(tid)}-daemon", "daemon")
            aux.append(aform)
            rows.append(orow(esc(label), esc(daemon.get("note", "")),
                             abox + f'<button class="btn sm sec" type="submit" form="{fid}">'
                             f'{word}</button>'))

        if t.get("login"):
            rows.append(orow("", "", '<button class="btn ghost" type="submit" name="do" '
                                     'value="/tools/login">Log in / switch account</button>',
                             cls=" end"))
        if rows:
            out.append(main_form('<div class="opts">' + "".join(rows) + "</div>"))
        out.extend(aux)

    out.append(docs)
    out.append("</div></details>")
    return "\n".join(x for x in out if x)


def what_option(value, label, checked=False, run_cmd=None):
    """One pill of the Start-a-session segmented choice. The radio is the
    real control (visually hidden, still tabbable); data-run is read by the
    page's JS to word the hint under the command box."""
    run_attr = f' data-run="{esc(run_cmd)}"' if run_cmd else ""
    return (f'<label class="pill"><input type="radio" name="what" value="{esc(value)}"'
            + (" checked" if checked else "") + run_attr + ">" + esc(label) + "</label>")


def wants_agent_card(t, st):
    """Whether a tool earns a row in Agent servers: something to install, log
    into, or a background process to run. A ready tool with nothing else
    going on starts from the Start-a-session picker instead and needs no
    row here."""
    if not st["installed"] or st["logged_in"] is False:
        return True
    return bool(t.get("server") or t.get("daemon") or t.get("actions"))


def render(error=None, dir_custom="", cmd="", label="", name="", sc_label="", sc_cmd="",
           addsc_open=False, save_open=False, open_tool="", what="shell"):
    dirs = dir_options()
    sess = sessions()
    if sess:
        cards = "\n".join(SESSION_CARD.format(
            on=" on" if s["attached"] else "", name=esc(s["name"]), cmd=esc(s["cmd"]),
            path=esc(s["path"]),
            windows=f"{s['windows']} window{'s' if s['windows'] != 1 else ''}",
            ago=ago(s["created"]),
            attached=" &middot; attached" if s["attached"] else "",
            href=esc(term_href(s["name"])),
            dots=I_DOTS, i_here=I_HERE, i_popout=I_POPOUT, i_trash=I_TRASH, i_edit=I_EDIT,
            ssh_items=SSH_ITEMS.format(cmd=esc(ssh_cmd(s["name"])), url=esc("ssh://" + SSH_TARGET),
                                       i_copy=I_COPY, i_link=I_LINK) if SSH_TARGET else "",
        ) for s in sess)
    else:
        cards = '<div class="empty">No sessions running. Start one above.</div>'
    scs = load_shortcuts()
    # The built-in row first, and only when this really is a git checkout --
    # a tarball copy has nothing to pull.
    builtin = (UPDATE_CARD.format(id=esc(UPDATE_ID), cmd=esc(UPDATE_CMD))
               if update_available() else "")
    if scs:
        shortcuts = builtin + "\n" + "\n".join(SHORTCUT_CARD.format(
            id=esc(x["id"]), label=esc(x.get("label") or x["cmd"]), cmd=esc(x["cmd"]),
            trash=I_TRASH,
            dir=esc((x.get("dir") or HOME).replace(HOME, "~", 1))) for x in scs)
    else:
        shortcuts = builtin + '\n<div class="empty">None yet. Tick “Save as a shortcut” above to keep a command here.</div>'

    tools, tools_error = load_tools()
    pairs = list(zip(tools, tool_states(tools))) if tools else []

    # Start-a-session's segmented choice: Shell, then every installed tool
    # with a run command, in registry order -- the same test tool_kinds()
    # uses, but read straight off the states already fetched above instead of
    # a second round of shutil.which() calls.
    what_ids = {"shell"} | {t["id"] for t, st in pairs if st["installed"] and t.get("run")}
    checked = what if what in what_ids else "shell"
    what_opts = [what_option("shell", "Shell", checked=(checked == "shell"))]
    what_opts.extend(what_option(t["id"], t.get("label") or t["id"],
                                 checked=(checked == t["id"]), run_cmd=t["run"])
                     for t, st in pairs if st["installed"] and t.get("run"))

    if not pairs:
        agents = '<div class="empty">No agents configured.</div>'
    else:
        # All rows collapsed, except the one whose button produced this error.
        card_pairs = [(t, st) for t, st in pairs if wants_agent_card(t, st)]
        if card_pairs:
            agents = "\n".join(tool_card(t, st, dirs, open_=(t["id"] == open_tool))
                               for t, st in card_pairs)
        else:
            agents = ('<div class="empty">Nothing to set up: every agent is installed and '
                      'starts from the top of the page.</div>')

    body = "\n".join([
        START_CARD.format(dirs=dirs, dir_custom=esc(dir_custom), cmd=esc(cmd), label=esc(label),
                          name=esc(name), save_open=" open" if save_open else "",
                          what_options="\n".join(what_opts)),
        "<h2>Shortcuts</h2>", shortcuts,
        ADD_SHORTCUT_CARD.format(dirs=dirs, sc_label=esc(sc_label), sc_cmd=esc(sc_cmd),
                                 addsc_open=" open" if addsc_open else ""),
        "<h2>Sessions</h2>", cards,
        "<h2>Agent servers</h2>",
        '<p class="hint">Install, log in, and the background servers the phone apps connect '
        'to. Interactive sessions start at the top of the page.</p>',
        agents,
    ])
    err = "".join(f'<div class="err">{esc(e)}</div>' for e in (error, tools_error) if e)
    return PAGE.format(css=CSS, error=err, body=body, title=esc(TITLE), glyph=I_LOGO,
                       pwa_links=PWA_LINKS,
                       sysline=system_line(), fx_class=FX_CLASS, version=esc(VERSION))


def render_term(name, popout=False):
    return TERM_PAGE.format(
        name=esc(name), src=esc(ttyd_src(name)), dirs=dir_options(), kinds=kind_options(),
        title=esc(TITLE), tokens=TOKENS, pwa_links=PWA_LINKS, logo=logo_svg(28),
        i_dots=I_DOTS, i_plus=I_PLUS, i_keys=I_KEYBOARD, i_popout=I_POPOUT,
        i_close=I_CLOSE, i_send=I_SEND, i_refresh=I_REFRESH,
        fx_css=FX_CSS, fx_css_term=FX_CSS_TERM,
        term_path_json=js(TERM_PATH), name_json=js(name), title_json=js(TITLE),
        body_class=' class="%s"' % " ".join(
            filter(None, ["popout" if popout else "", FX_CLASS])))


TERM_DOWN_PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>Terminal unavailable &middot; {title}</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080f0e">
<style>{css}</style></head><body><main>
<h1>{glyph}serverjack <small>{title}</small></h1>
<div class="err">The terminal isn’t answering.</div>
<p class="tagline">serverjack proxies the terminal to ttyd on a private socket, and
that socket did not accept a connection: <code>{why}</code></p>
<p class="foot">The terminal runs as a second user unit. Check it with
<code>systemctl --user status serverjack-ttyd</code> and
<code>journalctl --user -u serverjack-ttyd -n 50</code>, then reload this page.
Your tmux sessions are untouched — nothing here can kill them.</p>
</main></body></html>
"""


def render_term_down(why):
    # No {pwa_links}: this is an error interstitial, not a page to install as
    # a PWA -- and PWA_LINKS' manifest/icon sub-requests would only add noise.
    return TERM_DOWN_PAGE.format(title=esc(TITLE), css=CSS, glyph=I_LOGO, why=esc(why))


DENY_PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{title}</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080f0e">
<style>{css}</style></head><body><main>
<h1>{glyph}serverjack <small>{title}</small></h1>
<div class="err">Not your serverjack.</div>
<p class="tagline">This serverjack belongs to another tailnet user. You are signed in as {you}.</p>
<p class="foot">Identity comes from Tailscale: <code>tailscale serve</code> adds a
<code>Tailscale-User-Login</code> header for the tailnet user on the other end, and this
instance only answers to the logins its owner listed in <code>SERVERJACK_ALLOW</code>.
Your own account on this machine can run its own serverjack on its own HTTPS port.</p>
</main></body></html>
"""


def render_deny(login):
    # Deliberately does NOT name the logins in SERVERJACK_ALLOW: a stranger who
    # gets this page should learn nothing about who the owner is. No
    # {pwa_links} either: gate() rejects this same client's Host- and
    # identity-checked requests for /manifest.webmanifest, /icon.svg and
    # /icon-180.png before path dispatch, so those links would just 403 on
    # every load, and "Add to Home Screen" makes no sense for a page whose
    # whole point is that this user can't use it.
    return DENY_PAGE.format(title=esc(TITLE), css=CSS, glyph=I_LOGO, you=esc(login or "nobody"))


# --- PWA bits: manifest + icons (so "Add to Home Screen" on iOS / "Install"
# on desktop opens it standalone, with no browser chrome at all).

MANIFEST = {
    "name": f"{TITLE} terminal", "short_name": TITLE,
    "start_url": "/", "scope": "/", "display": "standalone",
    "background_color": "#080f0e", "theme_color": "#080f0e",
    "icons": [{"src": f"/icon.svg?v={ICON_REV}", "sizes": "any", "type": "image/svg+xml"},
              {"src": f"/icon-180.png?v={ICON_REV}", "sizes": "180x180", "type": "image/png"}],
}

ICON_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
            '<rect width="64" height="64" rx="14" fill="#080f0e"/>'
            f'<g fill="#39ff88">{PROMPT_JACK_SVG}</g></svg>')


def icon_png(size=180):
    """Rasterise the shared logo outlines; iOS applies its own background mask."""
    import math
    import struct, zlib
    bg, green = (8, 15, 14), (57, 255, 136)
    # Four samples per axis give smooth edges without a graphics dependency.
    side, scale = size * 4, size * 4 / 64.0
    mask = bytearray(side * side)
    for commands in PROMPT_JACK_PATHS:
        points = []
        for command in commands:
            if command[0] in ("M", "L"):
                points.append(command[1:])
            elif command[0] == "Q":
                x0, y0 = points[-1]
                cx, cy, x1, y1 = command[1:]
                for step in range(1, 17):
                    t = step / 16
                    points.append(((1-t)**2*x0 + 2*(1-t)*t*cx + t*t*x1,
                                   (1-t)**2*y0 + 2*(1-t)*t*cy + t*t*y1))
        edges = list(zip(points, points[1:] + points[:1]))
        for y in range(side):
            sample_y = (y + .5) / scale
            crossings = sorted(x0 + (sample_y-y0)*(x1-x0)/(y1-y0)
                               for (x0, y0), (x1, y1) in edges
                               if min(y0, y1) <= sample_y < max(y0, y1))
            for left, right in zip(crossings[::2], crossings[1::2]):
                start = max(0, math.ceil(left * scale - .5))
                end = min(side, math.ceil(right * scale - .5))
                mask[y*side+start:y*side+end] = b"\x01" * (end-start)
    colors = [bytes(round(b + (g-b)*coverage/16) for b, g in zip(bg, green))
              for coverage in range(17)]
    raw = bytearray()
    for y in range(size):
        raw.append(0)  # PNG filter: none
        for x in range(size):
            offset = y*4*side + x*4
            coverage = sum(sum(mask[offset+dy*side:offset+dy*side+4]) for dy in range(4))
            raw.extend(colors[coverage])
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


ICON_PNG = icon_png()


# --------------------------------------------------------------- server ----

TOOL_ROUTES = ("/tools/install", "/tools/login", "/tools/open",
               "/tools/action", "/tools/server", "/tools/daemon",
               "/tools/autostart")


class Handler(BaseHTTPRequestHandler):
    server_version = "serverjack/1"

    def setup(self):
        # Once per connection, not per request: ThreadingHTTPServer keeps the
        # socket open for keep-alive, and the owner of a socket cannot change.
        BaseHTTPRequestHandler.setup(self)
        self.peer = conn_uid(self.connection)
        self.peer_ok = peer_allowed(self.peer)

    def refuse_peer(self):
        return self.send_bytes(
            b"this serverjack belongs to another user on this machine\n",
            "text/plain; charset=utf-8", 403, cache=False)

    def refuse_host(self):
        """421 Misdirected Request: right socket, wrong name. Plain text, no
        page -- whoever sent this is not a browser we want to render for."""
        return self.send_bytes(b"unknown Host\n", "text/plain; charset=utf-8",
                               421, cache=False)

    def gate(self):
        """Everything every request must pass before it is routed: the owner of
        the connection, the name it thinks it reached, and the tailnet identity
        behind it. Returns (ok, login); ok False means a response was sent."""
        if not self.peer_ok:
            self.refuse_peer()
            return False, ""
        if not host_allowed(self.headers.get("Host")):
            self.refuse_host()
            return False, ""
        path = urlparse(self.path).path
        ok, login = self.identity_ok(path)
        if not ok:
            if path.startswith("/api/"):
                self.send_json({"error": "not your serverjack"}, 403)
            else:
                self.send_html(render_deny(login), 403)
            return False, login
        return True, login

    def address_string(self):
        # On a Unix socket there is no peer address at all (client_address is
        # ""), and the base class would index it. Say where we are instead.
        ca = self.client_address
        return str(ca[0]) if isinstance(ca, tuple) and ca else "unix"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    # ------------------------------------------------------------ identity --
    # SERVERJACK_ALLOW lists tailnet logins. `tailscale serve` authenticates
    # the tailnet user and injects Tailscale-User-Login; we trust that header
    # because nothing else can reach us -- in unix mode the socket is 0600
    # inside a 0700 dir (tailscaled runs as root), and in tcp mode the README
    # says your proxy must set it and strip any client-supplied copy.
    # Exempt from SERVERJACK_ALLOW. /api/status is here for the same reason
    # /healthz is: a dashboard tile polling it is a machine, not a tailnet
    # user, so there is no Tailscale-User-Login header to match and an ALLOW
    # check could only 403 it. Both are still behind the peer-uid check, and
    # /api/status reports counts only -- never session names.
    OPEN_PATHS = ("/healthz", "/api/status")

    def identity_ok(self, path):
        """(ok, login). ok is always True when SERVERJACK_ALLOW is unset.

        The header is only read when the connection's owner is in
        TRUST_IDENTITY_UIDS -- root (tailscaled) by default. Any other peer we
        allow through, including our own account and a plain reverse proxy,
        could have made the header up, so for them it counts as absent."""
        login = ""
        if self.peer is not None and self.peer in TRUST_IDENTITY_UIDS:
            login = (self.headers.get("Tailscale-User-Login") or "").strip()
        # These are read-only machine probes. A POST to the same spelling must
        # still authenticate; otherwise an unauthenticated peer could reach the
        # request-body parser (and future state-changing handlers added here).
        if not ALLOW or (self.command == "GET" and path in self.OPEN_PATHS):
            return True, login
        return login.lower() in ALLOW, login

    def send_html(self, body, status=200):
        data = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        # SAMEORIGIN, not DENY: the terminal wrapper frames /term/, and an
        # error page from this same origin (a 502 when ttyd is down, a 403 from
        # SERVERJACK_ALLOW) has to be readable inside that frame.
        self.send_header("X-Frame-Options", "SAMEORIGIN")
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, location):
        self.send_response(303)
        self.send_header("Location", location)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def send_bytes(self, data, ctype, status=200, cache=True, etag=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "public, max-age=86400" if cache else "no-store")
        if etag:
            self.send_header("ETag", f'"{etag}"')
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, status=200):
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        ok, _login = self.gate()
        if not ok:
            return
        path = urlparse(self.path).path
        # The terminal. Served by this process so that every check above --
        # the peer uid, SERVERJACK_ALLOW, the Host -- covers it too; ttyd
        # itself listens on a Unix socket nothing else can reach.
        if path == TERM_PREFIX or path.startswith(TERM_PATH):
            return self.proxy_term()
        if path == "/":
            return self.send_html(render())
        if path.startswith("/s/"):
            name = unquote(path[3:])
            if not session_exists(name):
                return self.send_html(render(f"No session called “{name}” (it may have exited)."), 404)
            popout = "popout" in parse_qs(urlparse(self.path).query)
            return self.send_html(render_term(name, popout))
        if path == "/app.js":
            return self.send_bytes(APP_JS.encode(), "application/javascript; charset=utf-8", cache=False)
        if path == "/manifest.webmanifest":
            return self.send_bytes(json.dumps(MANIFEST).encode(), "application/manifest+json",
                                   etag=ICON_REV)
        if path == "/icon.svg":
            return self.send_bytes(ICON_SVG.encode(), "image/svg+xml", etag=ICON_REV)
        if path == "/icon-180.png":
            return self.send_bytes(ICON_PNG, "image/png", etag=ICON_REV)
        if path == "/api/sessions":
            return self.send_json(sessions())
        if path == "/api/windows":
            q = parse_qs(urlparse(self.path).query)
            name = (q.get("name") or [""])[0]
            if not session_exists(name):
                return self.send_json([], 404)
            return self.send_json(windows(name))
        if path == "/api/scroll":
            q = parse_qs(urlparse(self.path).query)
            name = (q.get("name") or [""])[0]
            if not session_exists(name):
                return self.send_json({"error": "no such session"}, 404)
            return self.send_json({"mouse": session_mouse(name)})
        if path == "/api/status":
            return self.send_json(status())
        if path == "/api/tools":
            return self.send_json(tool_states(load_tools()[0]))
        if path == "/api/screen":
            q = parse_qs(urlparse(self.path).query)
            name = (q.get("name") or [""])[0]
            if not session_exists(name):
                return self.send_bytes(b"", "text/plain; charset=utf-8", 404, cache=False)
            try:
                lines = int((q.get("lines") or ["300"])[0])
            except (TypeError, ValueError):
                lines = 300                     # a junk ?lines= is not an error
            text = screen_text(name, max(1, min(lines, 5000)))
            return self.send_bytes(text.rstrip("\n").encode(), "text/plain; charset=utf-8", cache=False)
        if path == "/healthz":
            return self.send_html("ok")
        self.send_html("<h1>404</h1>", 404)

    # ---------------------------------------------------------- terminal --
    #
    # ttyd listens on <runtime dir>/ttyd.sock and nothing else: no port, no
    # second HTTP mount, nothing another local account or a tailnet device can
    # open. Everything under TERM_PATH is proxied here instead, so the
    # terminal is behind exactly the same door as the page -- the peer-uid
    # check, SERVERJACK_ALLOW and the Host check all ran before we got here.
    # The prefix is stripped on the way (what `tailscale serve --set-path`
    # used to do), so ttyd needs no -b.

    HOP_HEADERS = {"proxy-connection", "keep-alive", "transfer-encoding", "te",
                   "trailer", "proxy-authenticate", "proxy-authorization"}

    def term_upstream(self):
        """A connection to ttyd, or None (with a 502 already sent)."""
        try:
            up = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            up.settimeout(10)
            up.connect(TTYD_SOCK)
            up.settimeout(None)       # a terminal is idle for hours on purpose
            return up
        except OSError as e:
            self.log_message("ttyd unreachable at %s: %s", TTYD_SOCK, e)
            self.close_connection = True
            self.send_html(render_term_down(e), 502)
            return None

    def proxy_term(self):
        up = self.term_upstream()
        if up is None:
            return
        # Rebuilt from the parsed request, not sliced off self.path: a client
        # may send an absolute-form target ("GET http://host/term/ HTTP/1.1").
        u = urlparse(self.path)
        target = (u.path[len(TERM_PREFIX):] or "/") + (("?" + u.query) if u.query else "")
        upgrade = ((self.headers.get("Upgrade") or "").strip().lower() == "websocket"
                   and "upgrade" in (self.headers.get("Connection") or "").lower())
        # Headers go through verbatim -- Host and Origin because ttyd -O
        # compares them, Sec-WebSocket-* because they are the handshake. Only
        # per-hop headers are dropped, and a non-upgrade request is forced to
        # Connection: close so the response ends at EOF and needs no
        # framing logic here.
        lines = [f"{self.command} {target} HTTP/1.1"]
        for k, v in self.headers.items():
            if k.lower() in self.HOP_HEADERS:
                continue
            if k.lower() == "connection" and not upgrade:
                continue
            lines.append(f"{k}: {v}")
        if not upgrade:
            lines.append("Connection: close")
        try:
            up.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("latin-1", "replace"))
            head, rest = self._read_head(up)
        except OSError as e:
            up.close()
            self.close_connection = True
            return self.send_html(render_term_down(e), 502)
        self.close_connection = True   # we speak to the socket directly now
        if not head:
            # ttyd hung up without answering. On an upgrade that is its origin
            # check (-O) refusing a cross-site WebSocket, and the honest thing
            # is to hang up too -- a 502 page would claim the terminal is down.
            up.close()
            if upgrade:
                return
            return self.send_html(render_term_down("ttyd closed the connection"), 502)
        try:
            self.wfile.write(head)
            if rest:
                self.wfile.write(rest)
            self.wfile.flush()
        except OSError:
            up.close()
            return
        self._relay(up)

    @staticmethod
    def _read_head(up):
        """Status line + headers from ttyd, plus any body bytes that arrived
        with them. Returns (b"", b"") if it closed without answering."""
        buf = b""
        while b"\r\n\r\n" not in buf and len(buf) < 65536:
            chunk = up.recv(65536)
            if not chunk:
                return b"", b""
            buf += chunk
        head, sep, rest = buf.partition(b"\r\n\r\n")
        if not sep:
            return b"", b""                 # no headers in 64K: not an answer
        return head + sep, rest

    def _relay(self, up):
        """Copy bytes both ways until either end closes. This is the WebSocket
        for the life of the terminal, and a plain response body otherwise.
        Reads from self.rfile, not the raw socket: the request parser may have
        buffered bytes that recv() would never see again."""
        def to_ttyd():
            try:
                while True:
                    data = self.rfile.read1(65536)
                    if not data:
                        break
                    up.sendall(data)
            except (OSError, ValueError):
                pass
            finally:
                try:
                    up.shutdown(socket.SHUT_WR)
                except OSError:
                    pass
        t = threading.Thread(target=to_ttyd, name="term-up", daemon=True)
        t.start()
        try:
            while True:
                data = up.recv(65536)
                if not data:
                    break
                self.wfile.write(data)
                self.wfile.flush()
        except (OSError, ValueError):
            pass
        finally:
            try:
                self.connection.shutdown(socket.SHUT_RDWR)   # unblocks the thread
            except OSError:
                pass
            try:
                up.close()
            except OSError:
                pass
        t.join(timeout=5)

    def same_site(self):
        # Cross-site form posts (from a page you happened to open elsewhere)
        # must not be able to create or kill sessions.
        sfs = self.headers.get("Sec-Fetch-Site")
        if sfs:                                   # every current browser sends it
            return sfs in ("same-origin", "none")
        origin = self.headers.get("Origin")       # older browsers: compare hosts
        if origin:
            host = self.headers.get("X-Forwarded-Host") or self.headers.get("Host", "")
            return urlparse(origin).netloc.lower() == host.lower()
        # Neither header: not a browser we recognise. Every current one sends
        # Sec-Fetch-Site, and every one since ~2016 sends Origin on a
        # form POST, so refuse rather than assume. A script driving this on
        # purpose (curl, a test) can say so with Sec-Fetch-Site: same-origin.
        return False

    def form(self):
        """Read one small URL-encoded form, or answer the malformed request.

        Never partially consume an oversized body: bytes left behind can be
        mistaken for another request on a persistent connection. Chunked input
        is unsupported by BaseHTTPRequestHandler and is rejected explicitly.
        """
        if self.headers.get_all("Transfer-Encoding"):
            self.close_connection = True
            self.send_bytes(b"Transfer-Encoding is not supported\n",
                            "text/plain; charset=utf-8", 400, cache=False)
            return None
        lengths = self.headers.get_all("Content-Length") or []
        if len(lengths) > 1 or (lengths and not re.fullmatch(r"[0-9]+", lengths[0])):
            self.close_connection = True
            self.send_bytes(b"invalid Content-Length\n", "text/plain; charset=utf-8",
                            400, cache=False)
            return None
        # Avoid feeding arbitrarily long decimal strings to int(). Any value
        # with more than ten digits is already far beyond this limit.
        if lengths and len(lengths[0]) > 10:
            n = 65537
        else:
            n = int(lengths[0]) if lengths else 0
        if n > 65536:
            self.close_connection = True
            self.send_bytes(b"request body too large\n", "text/plain; charset=utf-8",
                            413, cache=False)
            return None
        raw = self.rfile.read(n).decode(errors="replace")
        return {k: v[0] for k, v in parse_qs(raw).items()}

    def new_from_form(self, f):
        """Validate + create. Returns (name, error)."""
        kind = f.get("kind", "shell")
        if kind not in tool_kinds():
            return None, "Unknown session type."
        cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
        if err:
            return None, err
        cmd = f.get("cmd") if kind == "shell" else None
        name, err = validate_name(f.get("name", ""), required=False,
                                  base=default_session_name(kind, cwd, cmd))
        if err:
            return None, err
        err = create_session(kind, name, cwd, command=cmd)
        return name, err

    def do_start(self, f):
        """The Start a session card: what=shell runs an optional command in
        front of a login shell (exactly /run, plus a plain shell when there is
        no command); any other what is a tool id from tool_kinds() and opens
        it (exactly /tools/open). The name field is optional either way --
        left blank, the session is named for its type and directory (see
        default_session_name()). Any error re-renders the page with the
        form's own state -- what, dir, the typed command, the typed name --
        so the right radio is still checked and nothing typed is lost."""
        what = f.get("what") or "shell"
        cmd = f.get("cmd", "").strip()
        label = f.get("label", "")
        name_in = f.get("name", "")
        save_open = bool(f.get("save"))

        def fail(msg, status=400):
            return self.send_html(render(msg, dir_custom=f.get("dir_custom", ""), cmd=cmd,
                                         label=label, name=name_in, save_open=save_open, what=what), status)

        if what != "shell" and what not in tool_kinds():
            return fail("Unknown session type.")

        cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
        if err:
            return fail(err)

        if what == "shell":
            if cmd:
                name, err = validate_name(name_in, required=False,
                                          base=default_session_name("shell", cwd, cmd))
                if err:
                    return fail(err)
                err = create_session("shell", name, cwd, command=cmd)
                if err:
                    return fail(err, 500)
                if f.get("save"):
                    add_shortcut(label, cmd, cwd)
            else:
                name, err = validate_name(name_in, required=False,
                                          base=default_session_name("shell", cwd))
                if err:
                    return fail(err)
                err = create_session("shell", name, cwd, command=None)
                if err:
                    return fail(err, 500)
            return self.redirect(term_href(name))

        name, err = validate_name(name_in, required=False, base=default_session_name(what, cwd))
        if err:
            return fail(err)
        err = create_session(what, name, cwd)
        clear_tool_cache(what)
        if err:
            return fail(err, 500)
        return self.redirect(term_href(name))

    def do_POST(self):
        ok, _login = self.gate()
        if not ok:
            return
        path = urlparse(self.path).path
        if not self.same_site():
            if path.startswith("/api/"):
                return self.send_json({"error": "cross-site request refused"}, 403)
            return self.send_html("<h1>403</h1>cross-site request refused", 403)
        f = self.form()
        if f is None:
            return

        # An agent card is one form with several submit buttons, so the button
        # carries the route it wants ("/tools/action:0" -> /tools/action, i=0).
        if path == "/tools":
            do, _, arg = f.get("do", "").partition(":")
            if do not in TOOL_ROUTES:
                return self.send_html(render("Unknown action."), 400)
            if arg:
                f["i"] = arg
            path = do

        if path == "/start":                      # the Start a session card
            return self.do_start(f)

        if path == "/new":                        # the terminal page's own new-session form
            name, err = self.new_from_form(f)
            if err:
                return self.send_html(render(err, dir_custom=f.get("dir_custom", ""), cmd=f.get("cmd", "")), 400)
            return self.redirect(term_href(name))

        if path == "/api/new":                   # menu bar
            name, err = self.new_from_form(f)
            if err:
                return self.send_json({"error": err}, 400)
            return self.send_json({"ok": True, "name": name})

        if path in ("/kill", "/api/kill"):
            name = f.get("name", "")
            if name and session_exists(name):
                tmux("kill-session", "-t", f"={name}")
            if path == "/api/kill":
                return self.send_json({"ok": True})
            return self.redirect("/")

        if path in ("/rename", "/api/rename"):
            new, err = rename_session(f.get("name", ""), f.get("new", ""))
            if path == "/api/rename":
                if err:
                    return self.send_json({"error": err}, 400)
                return self.send_json({"ok": True, "name": new})
            if err:
                return self.send_html(render(err), 400)
            return self.redirect("/")

        if path == "/api/window":
            name = f.get("name", "")
            idx = f.get("index", "")
            if not session_exists(name) or not str(idx).isdigit():
                return self.send_json({"error": "no such session or window"}, 404)
            r = tmux("select-window", "-t", f"={name}:{int(idx)}")
            if r.returncode != 0:
                return self.send_json({"error": (r.stderr or r.stdout).strip()}, 400)
            return self.send_json({"ok": True, "index": int(idx)})

        if path == "/api/scroll":
            name = f.get("name", "")
            try:
                lines = int(f.get("lines", "0"))
            except ValueError:
                return self.send_json({"error": "lines must be an integer"}, 400)
            if not session_exists(name):
                return self.send_json({"error": "no such session"}, 404)
            scroll_session(name, lines)
            return self.send_json({"ok": True})

        if path == "/shortcuts/add":
            cmd = f.get("cmd", "").strip()
            if not cmd:
                return self.send_html(render("A shortcut needs a command.", sc_label=f.get("label", ""), addsc_open=True), 400)
            cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
            if err:
                return self.send_html(render(err, sc_label=f.get("label", ""), sc_cmd=cmd, addsc_open=True), 400)
            add_shortcut(f.get("label", ""), cmd, cwd)
            return self.redirect("/")

        if path == "/shortcuts/del":
            sid = f.get("id", "")
            save_shortcuts([x for x in load_shortcuts() if x["id"] != sid])
            return self.redirect("/")

        if path == "/shortcuts/run":
            sid = f.get("id", "")
            if sid == UPDATE_ID:
                if not update_available():
                    return self.send_html(render("This copy of serverjack is neither a git checkout nor a managed release install."), 400)
                # install.sh restarts the unit at the end; KillMode=process
                # keeps the tmux server (and this session) alive, so the
                # result stays on screen and the page reconnects to it.
                return self.launch(auto_name("update"), REPO, UPDATE_CMD)
            sc = next((x for x in load_shortcuts() if x["id"] == sid), None)
            if not sc:
                return self.send_html(render("That shortcut no longer exists."), 404)
            cwd = sc.get("dir") or HOME
            if not os.path.isdir(cwd):
                return self.send_html(render(f"Shortcut directory is gone: {cwd}"), 400)
            name = default_session_name("shell", cwd, sc["cmd"])
            err = create_session("shell", name, cwd, command=sc["cmd"])
            if err:
                return self.send_html(render(err), 500)
            return self.redirect(term_href(name))

        if path == "/run":                       # legacy alias for /start's "shell + cmd" case
            cmd = f.get("cmd", "").strip()
            label = f.get("label", "")
            if not cmd:
                return self.send_html(render("Paste a command to run first."), 400)
            cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
            if err:
                return self.send_html(render(err, cmd=cmd, label=label, save_open=bool(f.get("save"))), 400)
            name = auto_name(cmd.split()[0])
            err = create_session("shell", name, cwd, command=cmd)
            if err:
                return self.send_html(render(err, cmd=cmd, label=label, save_open=bool(f.get("save"))), 500)
            if f.get("save"):
                add_shortcut(label, cmd, cwd)
            return self.redirect(term_href(name))

        if path.startswith("/tools/"):
            return self.do_tool(path, f)

        self.send_html("<h1>404</h1>", 404)

    # ------------------------------------------------------------ agents --
    #
    # Every one of these ends the same way: a command running in a tmux
    # session, and you looking at it. serverjack does not read the output.

    def fail(self, msg, status=400, tid=""):
        return self.send_html(render(msg, open_tool=tid), status)

    def do_tool(self, path, f):
        t = find_tool(f.get("id", ""))
        if not t:
            return self.fail("Unknown tool.", 404)
        tid = t["id"]
        st = tool_state(t)
        # Every failure below re-renders the page with this tool's row open.
        fail = lambda msg, status=400: self.fail(msg, status, tid)      # noqa: E731

        if path == "/tools/install":
            if st["installed"]:
                return fail(f"{t['label']} is already installed.")
            if not st["needs_ok"]:
                return fail(f"{t['label']} needs Node.js (node + npm), which isn’t installed.")
            if not t.get("install"):
                return fail(f"No install command is configured for {t['label']}.")
            return self.launch(auto_name("install-" + tid), HOME, t["install"], tid)

        if path == "/tools/login":
            if not t.get("login"):
                return fail(f"No login command is configured for {t['label']}.")
            return self.launch(auto_name("login-" + tid), HOME, t["login"], tid)

        if path == "/tools/open":
            if tid not in tool_kinds():
                return fail(f"{t['label']} isn’t installed, or has no command to run.")
            cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
            if err:
                return fail(err)
            name, err = validate_name(f.get("name", ""), required=False,
                                      base=default_session_name(tid, cwd))
            if err:
                return fail(err)
            err = create_session(tid, name, cwd)
            clear_tool_cache(tid)
            if err:
                return fail(err, 500)
            return self.redirect(term_href(name))

        if path == "/tools/action":
            actions = t.get("actions") or []
            try:
                a = actions[int(f.get("i", ""))]
            except (ValueError, IndexError):
                return fail("That button no longer exists.")
            cwd = HOME
            if a.get("dir"):
                cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
                if err:
                    return fail(err)
            return self.launch(auto_name(a.get("label") or tid), cwd, a["cmd"], tid)

        if path == "/tools/autostart":
            kind = f.get("kind", "")
            if kind not in ("server", "daemon"):
                return fail("Unknown autostart kind.")
            if kind == "server" and not (t.get("server") or {}).get("cmd"):
                return fail(f"No server is configured for {t['label']}.")
            if kind == "daemon" and not (t.get("daemon") or {}).get("start"):
                return fail(f"No daemon is configured for {t['label']}.")
            cwd = HOME
            if kind == "server":
                cwd, err = resolve_dir(f.get("dir"), "")
                if err:
                    return fail(err)
            set_autostart(tid, kind, cwd, bool(f.get("on")))
            return self.redirect("/")

        if path == "/tools/server":
            server = t.get("server") or {}
            sess = server.get("session")
            if not sess or not server.get("cmd"):
                return fail(f"No server is configured for {t['label']}.")
            if f.get("action") == "stop":
                target = f.get("session") or sess
                # Only ever kill one of this server's own sessions.
                if target == sess or (server.get("per_dir") and target.startswith(sess + "-")):
                    tmux("kill-session", "-t", f"={target}")
                # A deliberate stop must not come back after a restart: drop
                # the autostart entry that would recreate this same session.
                drop_autostart(lambda e: e.get("tool") == tid and e.get("kind") == "server"
                               and server_session_name(server, _auto_dir(e.get("dir"))) == target)
                clear_tool_cache(tid)
                return self.redirect("/")
            # Start in the directory picked on the card: Claude's server opens
            # its sessions there (and never trusts the home directory).
            cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
            if err:
                return fail(err)
            name = server_session_name(server, cwd)
            if session_exists(name):
                if not session_idle(name):
                    return fail(f"“{name}” is already running. Open it from the Sessions list.")
                tmux("kill-session", "-t", f"={name}")     # exited into its shell: replace it
            err = create_command_session(name, cwd, server["cmd"])
            clear_tool_cache(tid)
            if err:
                return fail(err, 500)
            return self.redirect(term_href(name))

        if path == "/tools/daemon":
            daemon = t.get("daemon") or {}
            action = f.get("action", "start")
            cmd = daemon.get(action if action in ("start", "stop") else "start")
            if not cmd:
                return fail(f"No daemon {action} command is configured for {t['label']}.")
            try:
                r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60,
                                   cwd=HOME, env={**os.environ, "PATH": TOOL_PATH})
            except (OSError, subprocess.SubprocessError) as e:
                return fail(f"{cmd}: {e}", 500)
            clear_tool_cache(tid)
            if r.returncode != 0:
                tail = "\n".join(((r.stderr or "") + (r.stdout or "")).strip().splitlines()[-5:])
                return fail(f"“{cmd}” exited with status {r.returncode}. {tail}", 500)
            if action == "stop":
                drop_autostart(lambda e: e.get("tool") == tid and e.get("kind") == "daemon")
            return self.redirect("/")

        return fail("Unknown action.", 404)

    def launch(self, name, cwd, cmd, tid=None):
        """Run one command in a new session and show it."""
        err = create_session("shell", name, cwd, command=cmd)
        if tid:
            clear_tool_cache(tid)
        if err:
            return self.fail(err, 500, tid or "")
        return self.redirect(term_href(name))


class UnixHTTPServer(ThreadingHTTPServer):
    """ThreadingHTTPServer on an AF_UNIX socket. HTTPServer.server_bind wants a
    (host, port) tuple to build server_name from, so it is bypassed here."""
    address_family = socket.AF_UNIX

    def server_bind(self):
        try:
            st = os.lstat(self.server_address)
        except FileNotFoundError:
            pass
        else:
            if not stat.S_ISSOCK(st.st_mode):
                raise OSError(f"refusing to replace non-socket path {self.server_address}")
            os.unlink(self.server_address)     # stale socket from a hard kill
        socketserver.TCPServer.server_bind(self)
        os.chmod(self.server_address, 0o600)   # only this account, belt and braces
        st = os.lstat(self.server_address)
        self._bound_socket_identity = (st.st_dev, st.st_ino)
        self.server_name, self.server_port = "serverjack", 0

    def server_close(self):
        super().server_close()
        try:
            st = os.lstat(self.server_address)
        except FileNotFoundError:
            return
        # Do not unlink a regular file, symlink or a replacement socket placed
        # at this pathname after we bound ours.
        if (stat.S_ISSOCK(st.st_mode)
                and (st.st_dev, st.st_ino) == self._bound_socket_identity):
            os.unlink(self.server_address)


if __name__ == "__main__":
    # No argparse: two flags, neither taking a value, don't earn the import.
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-V"):
        print(f"serverjack {VERSION}")
        raise SystemExit(0)
    if len(sys.argv) > 1 and sys.argv[1] in ("--check", "--doctor"):
        check_lines, check_ok = self_check()
        for level, text in check_lines:
            print(f"{level:<4} {text}")
        raise SystemExit(0 if check_ok else 1)
    if LISTEN == "tcp":
        srv = ThreadingHTTPServer(BIND, Handler)
        where = f"http://{BIND[0]}:{BIND[1]}"
    else:
        try:
            srv = UnixHTTPServer(WEB_SOCK, Handler)
        except OSError as e:
            # AF_UNIX paths max out around 108 bytes -- only ever hit with an
            # unusual XDG_RUNTIME_DIR, and worth naming rather than a bare errno.
            raise SystemExit(f"cannot bind {WEB_SOCK}: {e}"
                             + (" (path too long -- set XDG_RUNTIME_DIR to something shorter,"
                                " or SERVERJACK_LISTEN=tcp)" if "too long" in str(e) else ""))
        where = f"unix:{WEB_SOCK}"
    allow = ",".join(ALLOW) or "(any tailnet device that reaches it)"
    if LISTEN != "tcp":
        peers = "(socket is 0600)"
    elif TRUST_LOCAL:
        peers = "ANY local user (SERVERJACK_TRUST_LOCAL)"
    else:
        peers = ",".join(str(u) for u in sorted(ALLOWED_UIDS))
    sys.stderr.write(f"serverjack listening on {where}  title={TITLE!r} allow={allow} "
                     f"uids={peers} hosts={sorted(ALLOWED_HOSTS)} "
                     f"term={TERM_PATH}->{TTYD_SOCK} dirs={DIR_ROOTS} "
                     f"tools={[t['id'] for t in load_tools()[0]]}\n")
    # autostart.json, in the background: the page must come up now, not in
    # AUTOSTART_DELAY seconds. Daemon thread, so Ctrl-C still exits.
    threading.Thread(target=autostart_boot, name="autostart", daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
