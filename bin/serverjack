                '<path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>')
I_COPY = _svg('<rect x="9" y="9" width="11" height="11" rx="2"/>'
              '<path d="M5 15V5a2 2 0 0 1 2-2h8"/>')
