# The one directory-picker combobox's behaviour, shared the same way as
# DIRPICK_CSS above: a self-contained script that finds every ".dirpick" on
# whichever page includes it and wires it up. Every .dirpick is present in
# the server-rendered HTML from the start, so one pass over the DOM at load
# time is enough -- no MutationObserver. The one exception is an agent card
# the landing page swaps for a fresh copy after a Kill or Rename in place
# (FLOWS_JS): it wires that card's picker with window.sjWireDirpicks(card).
DIRPICK_JS = r"""
(function () {
  'use strict';
  // A bare folder name -- no "/", no leading "~", not "." or ".." -- is a
  // search term: what it submits is one of its matches (see pickFor()). A
  // typed path is taken as typed.
  function isName(v) {
    return !!v && v !== '.' && v !== '..' && v.indexOf('/') < 0 && v.charAt(0) !== '~';
  }
  function leaf(show) { var s = show.replace(/\/+$/, ''); return s.slice(s.lastIndexOf('/') + 1); }
  // The existing folders in dirs whose own name is exactly v, any case.
  function exact(v, dirs) {
    v = v.toLowerCase();
    return dirs.filter(function (d) { return !d.create && leaf(d.show || d.path).toLowerCase() === v; });
  }
  // A press in progress (pointer down, not up yet). The list is in flow, so
  // closing it moves everything under it: a blur's close waits for the
  // press to end, so the button that was under the pointer when it went
  // down is still there when the click lands.
  var pressAt = 0;
  document.addEventListener('pointerdown', function () { pressAt = Date.now(); }, true);
  document.addEventListener('pointerup', function () { pressAt = 0; }, true);
  document.addEventListener('pointercancel', function () { pressAt = 0; }, true);
  function pressing() { return !!pressAt && Date.now() - pressAt < 2000; }
  function row(d) {
    var li = document.createElement('li');
    li.setAttribute('role', 'option');
    li.dataset.path = d.path;
    var show = d.show || d.path, slash = show.lastIndexOf('/');
    li.dataset.show = show;
    li.title = show;
    if (d.create) {
      li.className = 'new';
      li.dataset.create = '1';
      li.setAttribute('aria-label', 'New folder ' + show);
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = '+ New folder';
      li.appendChild(tag);
    }
    var path = document.createElement('span');
    path.className = 'path';
    if (slash >= 0) {
      var rest = document.createElement('span'), bdi = document.createElement('bdi');
      rest.className = 'rest';
      bdi.dir = 'ltr';
      bdi.textContent = show.slice(0, slash + 1);
      rest.appendChild(bdi);
      path.appendChild(rest);
    }
    var b = document.createElement('b');
    b.textContent = slash >= 0 ? show.slice(slash + 1) : show;
    path.appendChild(b);
    li.appendChild(path);
    if (!d.create) {
      var into = document.createElement('span');   // click/tap: show its subfolders (Tab does it from a keyboard)
      into.className = 'into';
      into.setAttribute('aria-hidden', 'true');
      li.appendChild(into);
    }
    return li;
  }
  // The nearest ancestor that scrolls (the terminal's new-session panel),
  // or null when that is the page itself.
  function scroller(el) {
    for (var n = el.parentElement; n && n !== document.body; n = n.parentElement) {
      var o = getComputedStyle(n).overflowY;
      if ((o === 'auto' || o === 'scroll') && n.scrollHeight > n.clientHeight) return n;
    }
    return null;
  }
  function wire(box) {
    var input = box.querySelector('input[name=dir]'), list = box.querySelector('.dirlist');
    if (!input || !list) return;
    var form = input.form, uid = 'dp' + Math.random().toString(36).slice(2);
    var items = [], active = -1, kbd = -1, shown = null, hover = false;
    var seq = 0, gotSeq = 0, got = null, kept = null, qT = null, blurT = null;
    var typed = false, moved = false, enterWait = false, held = false, pass = false;
    var existing = box.hasAttribute('data-existing');   // a form that never creates a folder
    list.id = uid + '-list';
    input.setAttribute('aria-controls', list.id);

    function focused() { return document.activeElement === input; }
    // Closing also cancels whatever lookup is still due or in flight, so a
    // late answer can't reopen the list after a pick, Escape or blur.
    function close() {
      clearTimeout(qT); seq++; enterWait = false;
      list.hidden = true; list.innerHTML = ''; items = []; active = kbd = -1;
      shown = null; hover = false;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    }
    function highlight(i, quiet) {
      items.forEach(function (li) { li.removeAttribute('aria-selected'); });
      active = i;
      if (i >= 0 && items[i]) {
        items[i].setAttribute('aria-selected', 'true');
        if (!quiet) items[i].scrollIntoView({block: 'nearest'});
        input.setAttribute('aria-activedescendant', items[i].id);
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }
    // Scroll the list itself (never the page) so row li shows.
    function reveal(li) {
      var lr = list.getBoundingClientRect(), r = li.getBoundingClientRect();
      if (r.bottom > lr.bottom) list.scrollTop += r.bottom - lr.bottom + 4;
      else if (r.top < lr.top) list.scrollTop -= lr.top - r.top + 4;
    }
    // Scroll the opened list into view, but never the field out of it.
    function place() {
      var vv = window.visualViewport, top = vv ? vv.offsetTop : 0,
          bottom = top + (vv ? vv.height : window.innerHeight),
          ir = input.getBoundingClientRect(), lr = list.getBoundingClientRect(), sc = scroller(box);
      if (sc) {
        var sr = sc.getBoundingClientRect();
        top = Math.max(top, sr.top); bottom = Math.min(bottom, sr.bottom);
      }
      var by = Math.min(lr.bottom + 4 - bottom, ir.top - 4 - top);
      if (by > 0) { if (sc) sc.scrollTop += by; else window.scrollBy(0, by); }
    }
    function open(q, dirs) {
      list.innerHTML = '';
      items = dirs.map(function (d, i) {
        var li = row(d); li.id = uid + '-' + i; list.appendChild(li); return li;
      });
      if (!items.length) { close(); return; }
      shown = q; moved = hover = false;
      list.hidden = false;
      list.scrollTop = 0;
      input.setAttribute('aria-expanded', 'true');
      // A typed name: the folder with exactly that name if there is one
      // (the shallowest), else the top match -- what Enter, Go and Start take.
      kbd = -1;
      if (isName(q)) { var ex = exact(q, dirs); kbd = ex.length ? dirs.indexOf(ex[0]) : 0; }
      highlight(kbd, true);
      if (kbd > 0) reveal(items[kbd]);
      place();
    }
    function query() { clearTimeout(qT); qT = setTimeout(run, 80); }
    // GET /api/dirs for q. The newest answer is kept in got (dirs [] when
    // the lookup failed), then done(dirs) -- null for a failure.
    function lookup(q, mine, done) {
      fetch('/api/dirs?q=' + encodeURIComponent(q), {cache: 'no-store'})
        .then(function (r) { if (!r.ok) throw 0; return r.json(); })
        .then(function (data) {
          var dirs = (data.dirs || []).slice(), c = data.create;
          if (c && !existing) dirs.push({path: c.path, show: c.show, create: true});
          if (mine > gotSeq) { gotSeq = mine; got = {q: q, dirs: dirs}; }
          return dirs;
        }, function () {
          if (mine > gotSeq) { gotSeq = mine; got = {q: q, dirs: []}; }   // no answer: as typed
          return null;
        })
        .then(done);
    }
    function run() {
      if (!focused()) return;
      var q = input.value.trim(), mine = ++seq;
      lookup(q, mine, function (dirs) {
        if (mine !== seq) return;
        if (!dirs) { close(); return; }
        if (!focused()) return;
        var wait = enterWait;
        open(q, dirs);
        if (wait && active >= 0 && items[active]) take(items[active]);
        enterWait = false;
      });
    }
    function take(li) { input.value = li.dataset.show; close(); }
    function drill(li) {
      if (!focused()) input.focus();
      input.value = li.dataset.show.replace(/\/+$/, '') + '/';
      typed = true; moved = false;
      query();
    }
    // What the folder name v in the box stands for when the form is sent:
    // the row the list shows highlighted, or showed when you left the field
    // -- you saw that one. With the list closed, the one folder named
    // exactly v. A string: send that. null: that's for you to choose
    // (several or no folders of that exact name, or just a new one).
    // undefined: no answer for v yet.
    function pickFor(v) {
      if (!list.hidden && shown === v && active >= 0 && items[active]) return items[active].dataset.show;
      if (kept && kept.q === v) return kept.show;
      if (!got || got.q !== v) return undefined;
      if (!got.dirs.length) return v;       // the lookup failed: as typed
      var ex = exact(v, got.dirs);
      return ex.length === 1 ? ex[0].show : null;
    }
    // Show the list for what's in the box, so you can choose.
    function ask() {
      var v = input.value.trim();
      if (!focused()) input.focus();
      if (got && got.q === v && got.dirs.length) { clearTimeout(qT); open(v, got.dirs); }
      else query();
    }
    function resubmit(sub) {
      pass = true;
      try { form.requestSubmit(sub && sub.form === form ? sub : undefined); } finally { pass = false; }
    }
    // A name sent with no answer for it yet -- submitted straight after
    // typing, or put in the box by the page rather than typed: hold the
    // submit, look it up, then send what it stands for. A lookup slower than
    // 3 s, or a failed one, sends it as typed.
    function hold(e, v) {
      e.preventDefault(); e.stopImmediatePropagation();
      if (held) return;
      held = true;
      var sub = e.submitter, finished = false, t = setTimeout(go, 3000);
      function go() {
        if (finished) return;
        finished = true; held = false; clearTimeout(t);
        if (input.value.trim() !== v) return;    // edited meanwhile
        var p = pickFor(v);
        if (p === null) { ask(); return; }
        if (p) input.value = p;
        resubmit(sub);
      }
      lookup(v, ++seq, go);
    }

    input.addEventListener('focus', function () {
      clearTimeout(blurT); typed = false; kept = null; query();
    });
    input.addEventListener('input', function () { typed = true; enterWait = false; query(); });
    // A tap on the field that already has focus fires no focus event: let it
    // bring the list back after a pick or Escape.
    input.addEventListener('click', function () { if (list.hidden) query(); });
    input.addEventListener('keydown', function (e) {
      var k = e.key;
      if (k === 'ArrowDown' || k === 'ArrowUp') {
        if (list.hidden || !items.length) {
          if (k === 'ArrowDown') { e.preventDefault(); query(); }
          return;
        }
        e.preventDefault();
        var n = items.length;
        kbd = k === 'ArrowDown' ? (active + 1) % n : (active - 1 + n) % n;
        moved = true; hover = false;
        highlight(kbd);
      } else if (k === 'Enter') {
        var v = input.value.trim();
        if (!list.hidden && active >= 0 && items[active] && (shown === v || moved || hover)) {
          e.preventDefault();
          take(items[active]);
        } else if (isName(v) && !(got && got.q === v)) {
          // A name the list hasn't caught up with yet (Go pressed right
          // after typing): take its match as soon as the answer lands.
          e.preventDefault();
          enterWait = true; clearTimeout(qT); run();
        }   // else the form submits -- a name still goes as what it stands for (pickFor)
      } else if (k === 'Tab') {
        // Completes only what you typed or arrowed to: an untouched field,
        // and Shift+Tab always, let focus move on.
        if (e.shiftKey || list.hidden || !items.length || !(typed || moved)) return;
        e.preventDefault();
        var li = items[active >= 0 ? active : 0];
        if (li.dataset.create) take(li); else drill(li);
      } else if (k === 'Escape') {
        if (!list.hidden) e.stopPropagation();
        kept = null;
        close();
      }
    });
    // Mouse: any press inside the list (a row, its padding, the scrollbar)
    // keeps focus in the field. Picking waits for the click -- primary
    // button only -- which a tap also sends but a swipe doesn't, so a swipe
    // scrolls the list instead of picking whatever it started on.
    list.addEventListener('mousedown', function (e) { clearTimeout(blurT); e.preventDefault(); });
    list.addEventListener('click', function (e) {
      var li = e.target.closest && e.target.closest('li');
      if (e.button !== 0 || !li || !list.contains(li)) return;
      clearTimeout(blurT);
      if (e.target.closest('.into')) drill(li); else take(li);
    });
    // Hovering moves the one highlight, so Enter takes what the mouse is on;
    // leaving the list puts it back where the keyboard had it.
    list.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      var i = items.indexOf(e.target.closest && e.target.closest('li'));
      if (i >= 0 && i !== active) { hover = true; highlight(i, true); }
    });
    list.addEventListener('pointerleave', function () {
      if (hover) { hover = false; highlight(kbd, true); }
    });
    // Leaving the field closes the list after a beat (a click on a row still
    // lands) and never mid-press. What it showed highlighted is kept for a
    // submit that follows (pickFor).
    input.addEventListener('blur', function () {
      clearTimeout(blurT);
      blurT = setTimeout(function later() {
        if (pressing()) { blurT = setTimeout(later, 40); return; }
        kept = (!list.hidden && shown && active >= 0 && items[active])
          ? {q: shown, show: items[active].dataset.show} : null;
        close();
      }, 150);
    });
    // Submitting -- Start, Save, Start & open, or Enter/Go with no list up --
    // with a folder name in the box sends what it stands for (pickFor), or
    // stops and shows the list when that's for you to choose. Capture phase
    // on document, so this runs before the form's own handlers (the
    // terminal panel's fetch, a confirm) and a dropped submit never reaches
    // them.
    document.addEventListener('submit', function (e) {
      if (!form || e.target !== form) return;
      var v = input.value.trim();
      if (!pass && isName(v)) {
        var p = pickFor(v);
        if (p === undefined && form.requestSubmit && 'submitter' in e) { hold(e, v); return; }
        if (p === null) { e.preventDefault(); e.stopImmediatePropagation(); ask(); return; }
        if (p) input.value = p;
      }
      kept = null;
      close();
    }, true);
    // For a script that sends the field's value without a submit (a tool
    // card's "start at boot" box): the value to send, or null when a folder
    // name still has to be chosen -- the list is shown for that.
    input.dirValue = function () {
      var v = input.value.trim();
      if (!isName(v)) return v;
      var p = pickFor(v);
      if (typeof p === 'string') return p;
      ask();
      return null;
    };
  }
  function wireAll(root) { Array.prototype.forEach.call(root.querySelectorAll('.dirpick'), wire); }
  wireAll(document);
  window.sjWireDirpicks = wireAll;
})();
"""


# Outline icons, 1.5px stroke, currentColor. Inline SVG only -- no icon font.
def _svg(body, size=16, cls="i"):
    return (f'<svg class="{cls}" viewBox="0 0 24 24" width="{size}" height="{size}" fill="none" '
            'stroke="currentColor" stroke-width="1.5" stroke-linecap="round" '
            f'stroke-linejoin="round" aria-hidden="true">{body}</svg>')


# Prompt Jack: the original separate chevron and two-prong J connector.
# Absolute M/L/Q/Z commands are shared by the SVG and the stdlib PNG renderer.
PROMPT_JACK_PATHS = (
    (("M", 35, 15), ("Q", 35, 14, 36, 14), ("L", 38, 14), ("L", 38, 8),
     ("Q", 38, 7, 39, 7), ("L", 41, 7), ("Q", 42, 7, 42, 8), ("L", 42, 14),
     ("L", 45, 14), ("L", 45, 8), ("Q", 45, 7, 46, 7), ("L", 48, 7),
     ("Q", 49, 7, 49, 8), ("L", 49, 14), ("L", 51, 14),
     ("Q", 52, 14, 52, 15), ("L", 52, 23), ("Q", 52, 24, 51, 24),
     ("L", 48, 24), ("L", 48, 42), ("Q", 48, 56, 34, 56), ("L", 23, 56),
     ("Q", 12, 56, 12, 45), ("L", 12, 41), ("Q", 12, 40, 13, 40),
     ("L", 20, 40), ("Q", 21, 40, 21, 41), ("L", 21, 44),
     ("Q", 21, 47, 24, 47), ("L", 34, 47), ("Q", 39, 47, 39, 42),
     ("L", 39, 24), ("L", 36, 24), ("Q", 35, 24, 35, 23), ("Z",)),
    (("M", 21, 22), ("Q", 22.5, 20.5, 24, 22), ("L", 30.5, 28.5),
     ("Q", 32, 30, 30.5, 31.5), ("L", 24, 38), ("Q", 22.5, 39.5, 21, 38),
     ("Q", 19.5, 36.5, 21, 35), ("L", 26, 30), ("L", 21, 25),
     ("Q", 19.5, 23.5, 21, 22), ("Z",)),
)
PROMPT_JACK_SVG = "".join(
    '<path d="' + " ".join(" ".join(map(str, command)) for command in path) + '"/>'
    for path in PROMPT_JACK_PATHS)


def logo_svg(size=32):
    return (f'<svg class="glyph" viewBox="0 0 64 64" width="{size}" height="{size}" '
            f'fill="currentColor" aria-hidden="true" focusable="false">{PROMPT_JACK_SVG}</svg>')


I_LOGO = logo_svg()
# Icons are cached for a day with no ETag, so the URL itself is the cache
# buster. Derived from the artwork and VERSION rather than hand-maintained,
# so any change to either changes the URL and a new URL refreshes existing
# browsers -- nobody has to remember to bump this by hand.
ICON_REV = hashlib.sha1((PROMPT_JACK_SVG + VERSION).encode()).hexdigest()[:8]
PWA_LINKS = (f'<link rel="manifest" href="/manifest.webmanifest?v={ICON_REV}">\n'
             f'<link rel="apple-touch-icon" href="/icon-180.png?v={ICON_REV}">\n'
             f'<link rel="icon" href="/icon.svg?v={ICON_REV}" type="image/svg+xml">')

I_HERE = _svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 10l2.5 2.5L7 15"/>')
