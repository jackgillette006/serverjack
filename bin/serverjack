AUTOSTART_FILE = os.path.join(CONFIG_DIR, "autostart.json")
PREFS_FILE = os.path.join(CONFIG_DIR, "prefs.json")
try:
    AUTOSTART_DELAY = float(os.environ.get("SERVERJACK_AUTOSTART_DELAY") or 15)
except ValueError:
    AUTOSTART_DELAY = 15.0


def _ssh_target():
    """user@host for 'connect over SSH instead' links. SERVERJACK_SSH overrides;
    otherwise the tailnet DNS name if tailscale is up, else the hostname."""
    t = os.environ.get("SERVERJACK_SSH", "").strip()
    if t == "off":
        return ""
    if t:
        return t
    host = ""
    try:
        r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            host = (json.loads(r.stdout).get("Self") or {}).get("DNSName", "").rstrip(".")
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    host = host or socket.getfqdn() or socket.gethostname()
    return f"{getpass.getuser()}@{host}"


SSH_TARGET = _ssh_target()


def ssh_cmd(name):
    return f"ssh -t {SSH_TARGET} tmux attach -t {shlex.quote(name)}" if SSH_TARGET else ""


PATH_ENV = os.environ.get("PATH") or f"{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"


