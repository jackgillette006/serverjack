PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{title}</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080f0e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
{pwa_links}
<style>{css}</style></head><body class="{fx_class}">
<div id="crt" aria-hidden="true"></div><main>
<h1>{glyph}serverjack <small>{title}</small></h1>
<p class="tagline">Jack into your server.</p>
<p class="sysline">{sysline}</p>
{error}
{body}
<p class="foot">Opening a session puts you in a terminal attached to that tmux session. Use the browser's back button to return here (the session keeps running).
<button class="fxt" id="fxt" type="button">CRT fx: on</button> &middot; <span class="ver">serverjack v{version}</span></p>
<script>
(function(){{
  // Desktop: "Open" pops the session out in its own window and this page
  // stays put. Phones: same tab (a pile of browser tabs is worse there).
  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
  if (touch) document.body.classList.add('touch');
  // CRT effects: the server put .fx on <body> (so the power-on plays before any
  // script runs); localStorage overrides it either way and the toggle writes it.
  var fxb = document.getElementById('fxt'), ls = null;
  try {{ ls = localStorage.getItem('sj-fx'); }} catch (e) {{}}
  function fxSet(on, save) {{
    document.body.classList.toggle('fx', on);
    fxb.textContent = 'CRT fx: ' + (on ? 'on' : 'off');
    if (save) try {{ localStorage.setItem('sj-fx', on ? '1' : '0'); }} catch (e) {{}}
  }}
  fxSet(ls === '0' ? false : ls === '1' || document.body.classList.contains('fx'), false);
  fxb.onclick = function () {{ fxSet(!document.body.classList.contains('fx'), true); }};
  // Leaving through one of our own links: play the power-off, then navigate.
  function powerOff(go) {{
    if (!document.body.classList.contains('fx')) return go();
    var done = false, fire = function () {{ if (!done) {{ done = true; go(); }} }};
    document.body.classList.add('off');
    document.body.addEventListener('animationend', fire, {{once: true}});
    setTimeout(fire, 130);
  }}
  function popout(href, name) {{
    var w = window.open(href, 'serverjack-' + name, 'popup=yes,width=1000,height=650');
    if (w) {{ w.focus(); return true; }} return false;   // blocked => caller falls back to navigating
  }}
  // Confirmations live in data-confirm, never in an inline onsubmit built
  // from a session/shortcut name. Listening on the document catches forms a
  // button reaches through form="..." too, since submit bubbles.
  document.addEventListener('submit', function (e) {{
    var f = e.target, m = f && f.dataset && f.dataset.confirm;
    if (m && !confirm(m)) e.preventDefault();
  }});
  document.addEventListener('click', function (e) {{
    var a = e.target.closest('a.open, a[data-open=popout]'); var menu = e.target.closest('details.menu');
    if (a) {{
      var name = a.dataset.name || a.closest('.sess').querySelector('a.open').dataset.name;
      var wantPop = a.dataset.open === 'popout' || (!touch && !a.dataset.open);
      if (wantPop && popout('/s/' + encodeURIComponent(name) + '?popout=1', name)) e.preventDefault();
      else if (a.href) {{ e.preventDefault(); powerOff(function () {{ location.href = a.href; }}); }}
      if (menu) menu.removeAttribute('open');
      return;
    }}
    var c = e.target.closest('[data-copy]');
    if (c) {{
      var t = c.dataset.copy, l = c.querySelector('.lbl') || c, old = l.textContent;
      var done = function () {{ l.textContent = 'Copied'; setTimeout(function () {{ l.textContent = old; }}, 1200); }};
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, function () {{ prompt('Copy this:', t); }});
      else prompt('Copy this:', t);
      return;
    }}
    if (!menu) document.querySelectorAll('details.menu[open]').forEach(function (d) {{ d.removeAttribute('open'); }});
  }});
  // "start at boot": the checkbox lives in an option row but belongs (form=)
  // to a hidden form of its own, because the row is already inside the card's
  // big form and forms don't nest. Ticking it posts immediately; the Start
  // row's checkbox first copies whatever the directory picker says.
  document.addEventListener('change', function (e) {{
    var cb = e.target.closest && e.target.closest('input.autostart');
    if (!cb || !cb.form) return;
    if (cb.dataset.picker && cb.form.elements.dir) {{
      var card = cb.closest('details.tool');
      var sel = card && card.querySelector('.dirline select');
      var typed = card && card.querySelector('.dirline input[name=dir_custom]');
      cb.form.elements.dir.value = (typed && typed.value.trim()) || (sel && sel.value) || '';
    }}
    cb.form.submit();
  }});
  // Start a session: Shell shows the command box; an agent hides it and
  // explains what it runs instead (its own command, fixed, in the directory
  // above). Delegated so the one radio checked on load is synced too.
  var cmdwrap = document.getElementById('cmdwrap'), toolhint = document.getElementById('toolhint');
  function syncStart() {{
    var checked = document.querySelector('input[name=what]:checked');
    document.querySelectorAll('.seg .pill').forEach(function (p) {{
      p.classList.toggle('on', p.querySelector('input').checked);
    }});
    if (!checked || checked.value === 'shell') {{
      cmdwrap.hidden = false;
      toolhint.hidden = true;
    }} else {{
      cmdwrap.hidden = true;
      toolhint.textContent = 'Runs ';
      var code = document.createElement('code');
      code.textContent = checked.dataset.run || '';
      toolhint.appendChild(code);
      toolhint.appendChild(document.createTextNode(' in the directory above.'));
      toolhint.hidden = false;
    }}
  }}
  document.addEventListener('change', function (e) {{
    if (e.target.name === 'what') syncStart();
  }});
  syncStart();
}})();
</script>
</main></body></html>
"""

