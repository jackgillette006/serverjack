              '<path d="M13.5 10.5a4 4 0 0 0-5.7 0L5 13.3a4 4 0 0 0 5.7 5.7l1.4-1.4"/>')
I_TRASH = _svg('<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/>'
               '<path d="M6.5 7l.9 12.1A1 1 0 0 0 8.4 20h7.2a1 1 0 0 0 1-.9L17.5 7"/>'
