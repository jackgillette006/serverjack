I_DOTS = ('<svg class="i" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" '
          'aria-hidden="true"><circle cx="5.5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/>'
          '<circle cx="18.5" cy="12" r="1.6"/></svg>')

CSS = TOKENS + FX_CSS + FX_CSS_LAND + DIRPICK_CSS + """
*{box-sizing:border-box}
/* Dark-only UI: native scrollbars, checkboxes and form chrome draw dark too.
   Here, not in TOKENS: the terminal page shares TOKENS, and an iframe whose
   embedder is dark but whose document (ttyd's) is not gets an opaque WHITE
   canvas -- a white terminal every time a session loads or reconnects. */
