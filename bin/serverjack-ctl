#!/usr/bin/env bash
# serverjack-ctl: lifecycle helper for a managed (bootstrap-installed)
# serverjack, and a thin wrapper for a git-checkout one. Installed into
# ~/.local/bin/serverjack-ctl by install.sh. Works from the terminal even if
# the web UI is unhealthy -- that's the point of it.
#
# Usage:
#   serverjack-ctl status              channel, versions, unit/health state
#   serverjack-ctl versions            release directories, which is current
#   serverjack-ctl update [--version X] [--yes]
#                                       stage + activate a release; auto-rolls
#                                       back on a failed health check
#   serverjack-ctl rollback [--yes]    swap back to the previous release
#   serverjack-ctl uninstall [--yes]   remove the managed install (keeps
#                                       ~/.config/serverjack and tmux)
#   serverjack-ctl prune [--yes]       delete releases other than current/previous
#
# `update` and `rollback` on a release-channel install: stage the new release
# without touching the running one, back up the current unit files and env,
# swap ~/.local/share/serverjack/current, run its install.sh, and wait up to
# 30s for /healthz (and /term/) to answer. On failure they restore the prior
# units/env and symlink and report. tmux is never restarted -- the units are
# KillMode=process, so an in-flight session survives either way.
#
# On a git-checkout install, `update` is just `git pull --ff-only && bash
# install.sh`, same as the built-in shortcut on the page; every other
# subcommand requires a release-channel install (../local/share/serverjack).
#
# All state-changing subcommands ask for confirmation on /dev/tty unless
# --yes, and serialize against each other with flock on
# ~/.local/share/serverjack/.lock.
set -Eeuo pipefail
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

SHARE=$HOME/.local/share/serverjack
RELEASES=$SHARE/releases
CURRENT=$SHARE/current
INSTALL_JSON=$SHARE/install.json
LOCK=$SHARE/.lock
BACKUP_ROOT=$SHARE/backup
UNIT_DIR=$HOME/.config/systemd/user
ENV_FILE=$HOME/.config/serverjack/env
GITHUB_API="https://api.github.com/repos/jackgillette006/serverjack/releases/latest"
DEFAULT_BASE_URL="https://github.com/jackgillette006/serverjack/releases/download"

YES=0

say() { printf '\033[1m%s\033[0m\n' "$*"; }

usage() {
  sed -n '2,26p' "${BASH_SOURCE[0]}" 2>/dev/null | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

fetch() {
  if [[ -n ${SERVERJACK_RELEASE_BASE_URL:-} ]]; then
    curl -fsSL "$@"
  else
    curl -fsSL --proto '=https' --proto-redir '=https' "$@"
  fi
}

ask_confirm() {  # $1 = prompt text (without trailing "[y/N]")
  if (( YES )); then
    return 0
  fi
  # /dev/tty as a path always "exists" (-e) even with no controlling
  # terminal -- opening it is what fails (ENXIO), so open it (read+write, on
  # a private fd) to actually test that, not just stat it. The braces (not a
  # subshell) are load-bearing: `exec 8<>/dev/tty 2>/dev/null` on its own
  # line prints bash's own "No such device or address" to the real stderr
  # anyway (the failing redirection is set up before that 2>/dev/null would
  # apply); wrapping it in a group command applies the 2>/dev/null first.
  if ! { exec 8<>/dev/tty; } 2>/dev/null; then
    {
      echo "no controlling terminal to confirm on, and --yes was not given."
      echo "Remaining: $1"
    } >&2
    exit 2
  fi
  local reply=
  printf '%s [y/N] ' "$1" >&8
  if ! IFS= read -r reply <&8; then
    exec 8>&-
    echo "could not read a confirmation from /dev/tty" >&2
    exit 2
  fi
  exec 8>&-
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) echo "aborted." >&2; exit 1 ;;
  esac
}

with_lock() {  # $@ = command to run under the lock
  mkdir -p "$SHARE"
  exec 9>"$LOCK"
  if ! flock -n 9; then
    say "Waiting for another serverjack-ctl run to finish..."
    flock 9
  fi
  "$@"
}

# Reads $ENV_FILE the same way install.sh's cfg() does: last matching KEY=
# line wins, optional surrounding quotes stripped. Never `source`d (unquoted
# spaces like a --title value would break that).
env_get() {
  local key=$1 fallback=${2-} line v=
  [[ -f $ENV_FILE ]] || { printf '%s' "$fallback"; return; }
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == "$key="* ]] && v=${line#*=}
  done < "$ENV_FILE"
  v=${v#\"}; v=${v%\"}
  printf '%s' "${v:-$fallback}"
}

# Sets CHANNEL to "release", "git" or "unknown", and GIT_REPO when "git".
detect_channel() {
  CHANNEL=unknown
  GIT_REPO=""
  if [[ -f $INSTALL_JSON ]]; then
    local ch
    ch=$(python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("channel",""))
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null || true)
    if [[ $ch == release ]]; then CHANNEL=release; return; fi
  fi
  local unit="$UNIT_DIR/serverjack.service" exec_line repo
  if [[ -f $unit ]]; then
    exec_line=$(grep -m1 '^ExecStart=' "$unit" || true)
    repo=$(sed -n 's#.*python3 "\(.*\)/bin/serverjack".*#\1#p' <<< "$exec_line")
    if [[ -n $repo && -d "$repo/.git" ]]; then
      CHANNEL=git
      GIT_REPO=$repo
    fi
  fi
}

require_release_channel() {  # $1 = command name, for the error message
  detect_channel
  [[ $CHANNEL == release ]] || {
    echo "'$1' needs a managed release install (channel=$CHANNEL, no $INSTALL_JSON)." >&2
    if [[ $CHANNEL == git ]]; then
      echo "This is a git checkout ($GIT_REPO) -- use: cd $GIT_REPO && git pull --ff-only && bash install.sh" >&2
    fi
    exit 1
  }
}

installed_version() {
  if [[ -f $INSTALL_JSON ]]; then
    python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("version") or "")
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null
  elif [[ -f "$CURRENT/RELEASE" ]]; then
    sed -n 's/^version=//p' "$CURRENT/RELEASE"
  fi
}

previous_version() {
  [[ -f $INSTALL_JSON ]] || return 0
  python3 -c 'import json,sys
try:
    v = json.load(sys.stdin).get("previous")
    print(v or "")
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null
}

write_install_json() {  # $1 version, $2 previous (may be empty)
  local version=$1 previous=$2 tmp
  mkdir -p "$SHARE"
  tmp=$(mktemp "$SHARE/.install.json.XXXXXX")
  python3 - "$version" "$previous" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp" <<'PY'
import json
import sys

version, previous, installed_at = sys.argv[1], sys.argv[2], sys.argv[3]
json.dump({"channel": "release", "version": version, "installed_at": installed_at,
           "previous": previous or None}, sys.stdout, indent=2)
print()
PY
  mv -f "$tmp" "$INSTALL_JSON"
}

# Atomic symlink swap: $1 is what "current" should point at, either a path
# relative to $SHARE ("releases/1.4.0") or an absolute one already read back
# with readlink.
swap_current() {
  local target=$1 tmp_link="$SHARE/.current.$$"
  mkdir -p "$SHARE"
  ln -s "$target" "$tmp_link"
  mv -T "$tmp_link" "$CURRENT"
}

healthz_code() {
  local listen port sock
  listen=$(env_get SERVERJACK_LISTEN tcp)
  if [[ $listen == unix ]]; then
    sock="${XDG_RUNTIME_DIR}/serverjack/web.sock"
    curl -s -o /dev/null -w '%{http_code}' --unix-socket "$sock" http://serverjack/healthz 2>/dev/null || echo 000
  else
    port=$(env_get SERVERJACK_PORT 7680)
    curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/healthz" 2>/dev/null || echo 000
  fi
}

term_code() {
  local listen port sock term
  term=$(env_get SERVERJACK_TERM /term/)
  listen=$(env_get SERVERJACK_LISTEN tcp)
  if [[ $listen == unix ]]; then
    sock="${XDG_RUNTIME_DIR}/serverjack/web.sock"
    curl -s -o /dev/null -w '%{http_code}' --unix-socket "$sock" "http://serverjack$term" 2>/dev/null || echo 000
  else
    port=$(env_get SERVERJACK_PORT 7680)
    curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port$term" 2>/dev/null || echo 000
  fi
}

wait_healthy() {  # $1 = timeout seconds
  local timeout=$1 deadline code
  deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    code=$(healthz_code)
    if [[ $code == 200 ]]; then
      code=$(term_code)
      [[ $code == 200 ]] && return 0
    fi
    sleep 1
  done
  return 1
}

backup_current_state() {  # prints the backup dir it created
  local ts backup_dir
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  backup_dir="$BACKUP_ROOT/$ts"
  mkdir -p "$backup_dir"
  [[ -f "$UNIT_DIR/serverjack.service" ]] && cp -a "$UNIT_DIR/serverjack.service" "$backup_dir/"
  [[ -f "$UNIT_DIR/serverjack-ttyd.service" ]] && cp -a "$UNIT_DIR/serverjack-ttyd.service" "$backup_dir/"
  [[ -f $ENV_FILE ]] && cp -a "$ENV_FILE" "$backup_dir/env"
  printf '%s' "$backup_dir"
}

# Restores units/env from a backup_current_state() dir, points "current" back
# at $2 (a symlink target, e.g. "releases/1.3.0"), restarts the units, and
# waits for health -- best effort, used both by the auto-rollback inside
# `update` and by the explicit `rollback` subcommand's own failure path.
restore_from_backup() {  # $1 version being restored, $2 symlink target, $3 backup dir
  local version=$1 target=$2 backup_dir=$3
  swap_current "$target"
  [[ -f "$backup_dir/serverjack.service" ]] && cp -a "$backup_dir/serverjack.service" "$UNIT_DIR/"
  [[ -f "$backup_dir/serverjack-ttyd.service" ]] && cp -a "$backup_dir/serverjack-ttyd.service" "$UNIT_DIR/"
  if [[ -f "$backup_dir/env" ]]; then
    cp -a "$backup_dir/env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
  systemctl --user daemon-reload
  # A broken release that just crash-looped (Restart=on-failure, RestartSec=3)
  # can trip systemd's own StartLimitBurst within seconds -- found by this
  # test failing the very rollback meant to recover from it. Without this,
  # the GOOD release we are restoring to would also be refused with "start
  # of the service was attempted too often", for a unit that was never
  # itself the problem.
  systemctl --user reset-failed serverjack serverjack-ttyd 2>/dev/null || true
  # Never restart tmux -- only the two units. KillMode=process on both keeps
  # every tmux session (and the terminal a browser has attached to) alive.
  systemctl --user restart serverjack serverjack-ttyd || true
  if wait_healthy 15; then
    echo "restored $version, healthy." >&2
  else
    echo "restored $version, but it did not answer healthy within 15s -- check: journalctl --user -u serverjack -n 50" >&2
  fi
}

# ------------------------------------------------------------------ status
cmd_status() {
  detect_channel
  case $CHANNEL in
    release)
      local prev; prev=$(previous_version)
      echo "channel:  release"
      echo "current:  $(installed_version)"
      echo "previous: ${prev:-none}"
      ;;
    git)
      local v
      v=$(sed -n 's/^VERSION = "\(.*\)"/\1/p' "$GIT_REPO/bin/serverjack" 2>/dev/null)
      echo "channel:  git checkout ($GIT_REPO)"
      echo "current:  ${v:-unknown}"
      ;;
    *)
      echo "channel:  unknown (no $INSTALL_JSON, no recognizable git-checkout unit)"
      ;;
  esac
  local active
  active=$(systemctl --user is-active serverjack serverjack-ttyd 2>/dev/null | paste -sd' ' -)
  echo "units:    serverjack=${active%% *} serverjack-ttyd=${active#* }"
  local listen; listen=$(env_get SERVERJACK_LISTEN tcp)
  if [[ $listen == unix ]]; then
    echo "listen:   unix ${XDG_RUNTIME_DIR}/serverjack/web.sock"
  else
    echo "listen:   tcp 127.0.0.1:$(env_get SERVERJACK_PORT 7680)"
  fi
  echo "healthz:  $(healthz_code)"
}

# ----------------------------------------------------------------- versions
cmd_versions() {
  require_release_channel versions
  [[ -d $RELEASES ]] || { echo "no releases staged yet"; return; }
  local cur_target d v marker
  cur_target=$(readlink -f "$CURRENT" 2>/dev/null || true)
  for d in "$RELEASES"/*/; do
    [[ -d $d ]] || continue
    v=$(basename "$d")
    marker=" "
    [[ $(readlink -f "$d" 2>/dev/null || true) == "$cur_target" ]] && marker="*"
    echo "$marker $v"
  done
}

# ------------------------------------------------------------------ update
resolve_release() {  # sets REL_VERSION REL_BOOTSTRAP_URL REL_SUMS_URL
  local base_url=${SERVERJACK_RELEASE_BASE_URL:-$DEFAULT_BASE_URL}
  base_url=${base_url%/}
  if [[ -n $OPT_VERSION ]]; then
    REL_VERSION=$OPT_VERSION
    REL_BOOTSTRAP_URL="$base_url/v$REL_VERSION/serverjack-bootstrap.sh"
    REL_SUMS_URL="$base_url/v$REL_VERSION/SHA256SUMS"
    return
  fi
  [[ -z ${SERVERJACK_RELEASE_BASE_URL:-} ]] || {
    echo "SERVERJACK_RELEASE_BASE_URL is set but --version was not -- there is no \"latest\" to resolve on a mirror; pass --version explicitly" >&2
    exit 1
  }
  say "Checking github.com for the latest release"
  local json
  json=$(curl -fsSL --proto '=https' --proto-redir '=https' "$GITHUB_API") \
    || { echo "could not reach $GITHUB_API" >&2; exit 1; }
  REL_VERSION=$(python3 -c '
import json, sys
tag = json.load(sys.stdin).get("tag_name", "")
print(tag[1:] if tag.startswith("v") else tag)
' <<< "$json")
  [[ -n $REL_VERSION ]] || { echo "could not parse tag_name from the GitHub API response" >&2; exit 1; }
  REL_BOOTSTRAP_URL=$(python3 -c '
import json, sys
for a in json.load(sys.stdin).get("assets", []):
    if a.get("name") == "serverjack-bootstrap.sh":
        print(a["browser_download_url"]); break
' <<< "$json")
  REL_SUMS_URL=$(python3 -c '
import json, sys
for a in json.load(sys.stdin).get("assets", []):
    if a.get("name") == "SHA256SUMS":
        print(a["browser_download_url"]); break
' <<< "$json")
  [[ -n $REL_BOOTSTRAP_URL && -n $REL_SUMS_URL ]] \
    || { echo "latest release ($REL_VERSION) is missing the serverjack-bootstrap.sh or SHA256SUMS asset" >&2; exit 1; }
}

# Downloads the resolved release's bootstrap script + SHA256SUMS, parses the
# archive URL and pinned sha256 back out of the bootstrap (it is the one
# place that pairing is defined -- see bootstrap/serverjack-bootstrap.sh.in),
# downloads and verifies the archive, and extracts it to
# $RELEASES/<version>/ WITHOUT touching "current". Sets STAGED_DIR.
stage_release() {
  resolve_release
  local tmp; tmp=$(mktemp -d)
  say "Fetching release metadata for $REL_VERSION"
  fetch -o "$tmp/serverjack-bootstrap.sh" "$REL_BOOTSTRAP_URL" \
    || { echo "download failed: $REL_BOOTSTRAP_URL" >&2; rm -rf "$tmp"; exit 1; }
  fetch -o "$tmp/SHA256SUMS" "$REL_SUMS_URL" \
    || { echo "download failed: $REL_SUMS_URL" >&2; rm -rf "$tmp"; exit 1; }

  local archive_url archive_sha
  archive_url=$(sed -n 's/^EMBEDDED_ARCHIVE_URL="\(.*\)"$/\1/p' "$tmp/serverjack-bootstrap.sh" | head -1)
  archive_sha=$(sed -n 's/^EMBEDDED_ARCHIVE_SHA256="\(.*\)"$/\1/p' "$tmp/serverjack-bootstrap.sh" | head -1)
  [[ -n $archive_url && -n $archive_sha ]] \
    || { echo "could not parse the archive URL/sha256 out of the downloaded bootstrap script" >&2; rm -rf "$tmp"; exit 1; }
  if [[ -n ${SERVERJACK_RELEASE_BASE_URL:-} && $archive_url == "$DEFAULT_BASE_URL"* ]]; then
    archive_url="${SERVERJACK_RELEASE_BASE_URL%/}${archive_url#"$DEFAULT_BASE_URL"}"
  fi

  local archive="$tmp/serverjack-$REL_VERSION.tar.gz"
  fetch -o "$archive" "$archive_url" \
    || { echo "download failed: $archive_url" >&2; rm -rf "$tmp"; exit 1; }
  [[ -s $archive ]] || { echo "downloaded archive is empty: $archive_url" >&2; rm -rf "$tmp"; exit 1; }
  local got; got=$(sha256sum "$archive" | awk '{print $1}')
  if [[ $got != "$archive_sha" ]]; then
    echo "checksum mismatch for $(basename "$archive"): got $got, want $archive_sha -- refusing to stage a corrupted or tampered archive" >&2
    rm -rf "$tmp"
    exit 1
  fi
  if grep -q " $(basename "$archive")\$" "$tmp/SHA256SUMS" 2>/dev/null; then
    grep -q "^$archive_sha  $(basename "$archive")\$" "$tmp/SHA256SUMS" \
      || echo "  note: archive matches the bootstrap's pinned hash but not SHA256SUMS (release re-cut?)" >&2
  fi
  say "Checksum OK for serverjack $REL_VERSION ($got)"

  local staged="$RELEASES/$REL_VERSION"
  rm -rf "$staged"
  mkdir -p "$staged"
  tar -xzf "$archive" -C "$staged" --strip-components=1
  rm -rf "$tmp"
  STAGED_DIR=$staged
}

cmd_update() {
  OPT_VERSION=
  while (( $# )); do
    case "$1" in
      --version)  OPT_VERSION=${2:?--version needs X.Y.Z}; shift ;;
      --version=*) OPT_VERSION=${1#*=} ;;
      --yes)      YES=1 ;;
      *) echo "unknown option to update: $1" >&2; exit 1 ;;
    esac
    shift
  done
  if [[ -n $OPT_VERSION && ! $OPT_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]; then
    echo "--version must look like X.Y.Z, got: $OPT_VERSION" >&2
    exit 1
  fi

  detect_channel
  if [[ $CHANNEL == git ]]; then
    [[ -z $OPT_VERSION ]] || echo "note: --version is ignored for a git checkout; that's a git operation (git checkout v$OPT_VERSION)" >&2
    ask_confirm "Run: cd $GIT_REPO && git pull --ff-only && bash install.sh ?"
    ( cd "$GIT_REPO" && git pull --ff-only && bash install.sh )
    return
  fi
  [[ $CHANNEL == release ]] || {
    echo "not a recognized serverjack install here (no $INSTALL_JSON, no git checkout)" >&2
    exit 1
  }

  stage_release
  local new_version=$REL_VERSION
  local current_version; current_version=$(installed_version)
  if [[ $new_version == "$current_version" ]]; then
    say "serverjack $current_version is already current (re-staged $STAGED_DIR, not reactivating)."
    return
  fi
  ask_confirm "Activate serverjack $new_version (currently $current_version)?"

  local prev_target; prev_target=$(readlink "$CURRENT" 2>/dev/null || true)
  local backup_dir; backup_dir=$(backup_current_state)

  swap_current "releases/$new_version"
  # See the matching comment in restore_from_backup(): a prior crash-looping
  # release can leave the units rate-limited well after IT is gone.
  systemctl --user reset-failed serverjack serverjack-ttyd 2>/dev/null || true
  if bash "$CURRENT/install.sh" && wait_healthy 30; then
    write_install_json "$new_version" "$current_version"
    say "Activated serverjack $new_version"
    return
  fi
  echo "update to $new_version failed (install.sh or the health check) -- rolling back to $current_version" >&2
  restore_from_backup "$current_version" "${prev_target:-releases/$current_version}" "$backup_dir"
  exit 1
}

# ---------------------------------------------------------------- rollback
cmd_rollback() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to rollback: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel rollback
  local prev; prev=$(previous_version)
  [[ -n $prev ]] || { echo "no previous version recorded in $INSTALL_JSON -- nothing to roll back to" >&2; exit 1; }
  [[ -d "$RELEASES/$prev" ]] || { echo "previous version $prev is not staged in $RELEASES (pruned?) -- cannot roll back" >&2; exit 1; }

  local cur; cur=$(installed_version)
  ask_confirm "Roll back serverjack from $cur to $prev?"

  local backup_dir; backup_dir=$(backup_current_state)
  swap_current "releases/$prev"
  systemctl --user reset-failed serverjack serverjack-ttyd 2>/dev/null || true
  if bash "$CURRENT/install.sh" && wait_healthy 30; then
    write_install_json "$prev" "$cur"
    say "Rolled back to $prev"
    return
  fi
  echo "rollback to $prev failed (install.sh or the health check) -- restoring $cur" >&2
  restore_from_backup "$cur" "releases/$cur" "$backup_dir"
  exit 1
}

# --------------------------------------------------------------- uninstall
cmd_uninstall() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to uninstall: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel uninstall
  local v; v=$(installed_version)
  ask_confirm "Uninstall serverjack $v? This removes the systemd units, the tailscale serve route it owns, and $SHARE. ~/.config/serverjack and your tmux sessions are kept."
  if [[ -x "$CURRENT/uninstall.sh" ]]; then
    bash "$CURRENT/uninstall.sh" || echo "warning: $CURRENT/uninstall.sh exited non-zero; continuing to remove $SHARE" >&2
  else
    echo "warning: $CURRENT/uninstall.sh not found; removing $SHARE without running it" >&2
  fi
  rm -rf "$SHARE"
  echo "removed: serverjack/serverjack-ttyd units, their tailscale serve route, $SHARE"
  echo "kept: ~/.config/serverjack, ~/.local/bin/serverjack-ctl, ~/.local/bin/ttyd and fzf, your tmux sessions"
}

# -------------------------------------------------------------------- prune
cmd_prune() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to prune: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel prune
  local cur_target prev d v
  cur_target=$(readlink -f "$CURRENT" 2>/dev/null || true)
  prev=$(previous_version)
  local -a doomed=()
  for d in "$RELEASES"/*/; do
    [[ -d $d ]] || continue
    v=$(basename "$d")
    [[ $(readlink -f "$d" 2>/dev/null || true) == "$cur_target" ]] && continue
    [[ -n $prev && $v == "$prev" ]] && continue
    doomed+=("$v")
  done
  if (( ${#doomed[@]} == 0 )); then
    say "Nothing to prune."
    return
  fi
  say "Will delete: ${doomed[*]}"
  ask_confirm "Delete ${#doomed[@]} release director$( [[ ${#doomed[@]} -eq 1 ]] && echo y || echo ies )?"
  for v in "${doomed[@]}"; do
    rm -rf "${RELEASES:?}/$v"
    echo "removed $RELEASES/$v"
  done
}

main() {
  local cmd=${1:-}
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    status)    cmd_status "$@" ;;
    versions)  cmd_versions "$@" ;;
    update)    with_lock cmd_update "$@" ;;
    rollback)  with_lock cmd_rollback "$@" ;;
    uninstall) with_lock cmd_uninstall "$@" ;;
    prune)     with_lock cmd_prune "$@" ;;
    -h|--help|"") usage 0 ;;
    *) echo "unknown subcommand: $cmd" >&2; usage 1 >&2 ;;
  esac
}

main "$@"
