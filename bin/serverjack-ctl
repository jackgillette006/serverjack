#!/usr/bin/env bash
# serverjack-ctl: lifecycle helper for a managed (bootstrap-installed)
# serverjack, and a thin wrapper for a git-checkout one. Installed into
# ~/.local/bin/serverjack-ctl by install.sh. Works from the terminal even if
# the web UI is unhealthy -- that's the point of it.
#
# Usage:
#   serverjack-ctl status              channel, versions, unit/health state
#   serverjack-ctl versions            release directories, which is current
#   serverjack-ctl update [--version X] [--yes]
#                                       stage + activate a release; auto-rolls
#                                       back on a failed health check
#   serverjack-ctl rollback [--yes]    swap back to the previous release
#   serverjack-ctl uninstall [--yes]   remove the managed install (keeps
#                                       ~/.config/serverjack and tmux)
#   serverjack-ctl prune [--yes]       delete releases other than current/previous
#   serverjack-ctl setup               re-run the guided prerequisites/Tailscale/
#                                       allow-list flow (bin/serverjack-setup) --
#                                       works for either channel
#
# `update` and `rollback` on a release-channel install: stage the new release
# without touching the running one, back up the current unit files, env and
# serverjack-ctl itself, swap ~/.local/share/serverjack/current, run its
# install.sh, and wait up to 30s for /healthz plus both units being active.
# On failure they restore the prior units/env/serverjack-ctl and symlink and
# report. tmux is never restarted -- the units are KillMode=process, so an
# in-flight session survives either way.
#
# On a git-checkout install, `update` is just `git pull --ff-only && bash
# install.sh`, same as the built-in shortcut on the page; every other
# subcommand requires a release-channel install (../local/share/serverjack).
#
# All state-changing subcommands ask for confirmation on /dev/tty unless
# --yes, and serialize against each other with flock on
# ~/.local/share/serverjack/.lock.
set -Eeuo pipefail
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
# Tells install.sh/uninstall.sh they were invoked BY this lifecycle helper,
# not run by hand from inside a release directory -- see the matching check
# in install.sh (UNIT_REPO) and uninstall.sh (both refuse a direct, by-hand
# invocation from a managed release dir otherwise, on purpose).
export SERVERJACK_CTL_MANAGED=1

SHARE=$HOME/.local/share/serverjack
RELEASES=$SHARE/releases
CURRENT=$SHARE/current
INSTALL_JSON=$SHARE/install.json
LOCK=$SHARE/.lock
BACKUP_ROOT=$SHARE/backup
UNIT_DIR=$HOME/.config/systemd/user
ENV_FILE=$HOME/.config/serverjack/env
GITHUB_API="https://api.github.com/repos/jackgillette006/serverjack/releases/latest"
DEFAULT_BASE_URL="https://github.com/jackgillette006/serverjack/releases/download"

YES=0

# install.sh always installs this FLAT at ~/.local/bin/serverjack-ctl (both
# channels), with no bin/serverjack-lib.sh beside it, so "next to this
# script" only resolves when serverjack-ctl is run straight from a checkout
# or release directory (dev use, or the tests). The two real installed
# cases fall back to the same places bin/serverjack-setup's resolve_self()
# already uses: the managed "current" symlink, then a git checkout's own
# recorded path. Sourced for local_http_code()/wait_local_healthz() (A8: no
# more separately hand-rolled "000000" curl fallback) and the tailscale-
# serve helpers (A11: one remove_owned_mapping, not a third drifting copy).
resolve_lib() {
  local src=${BASH_SOURCE[0]}
  local self; self=$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")
  local candidate; candidate=$(dirname "$self")
  if [[ -f "$candidate/serverjack-lib.sh" ]]; then
    # shellcheck source=bin/serverjack-lib.sh
    source "$candidate/serverjack-lib.sh"; return 0
  fi
  if [[ -f "$CURRENT/bin/serverjack-lib.sh" ]]; then
    # shellcheck source=bin/serverjack-lib.sh
    source "$CURRENT/bin/serverjack-lib.sh"; return 0
  fi
  local install_path="$HOME/.config/serverjack/install-path" repo=""
  [[ -f $install_path ]] && repo=$(<"$install_path")
  if [[ -n $repo && -f "$repo/bin/serverjack-lib.sh" ]]; then
    # shellcheck source=bin/serverjack-lib.sh
    source "$repo/bin/serverjack-lib.sh"; return 0
  fi
  return 1
}
resolve_lib || {
  echo "warning: could not find bin/serverjack-lib.sh -- some checks will be degraded" >&2
}

say() { printf '\033[1m%s\033[0m\n' "$*"; }

usage() {
  # Prints the header comment block (everything from line 2 up to the
  # first non-"#" line -- `set -Eeuo pipefail` below) rather than a
  # hardcoded line range: a fixed `sed -n '2,Np'` silently truncates by
  # however many lines the header grows past N, with nothing to catch it
  # (found by exactly that happening here -- it had drifted one line short
  # of the real end, quietly cutting the last sentence off `--help`).
  awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' \
    "${BASH_SOURCE[0]}" 2>/dev/null
  exit "${1:-0}"
}

# See the matching comment in bootstrap/serverjack-bootstrap.sh.in: the pin
# is dropped only when SERVERJACK_RELEASE_BASE_URL literally starts with
# "http://", never merely because it is set -- an https:// mirror keeps the
# pin, so a 302 down to plain http from it is refused, not followed.
fetch() {
  if [[ ${SERVERJACK_RELEASE_BASE_URL:-} == http://* ]]; then
    curl -fsSL "$@"
  else
    curl -fsSL --proto '=https' --proto-redir '=https' "$@"
  fi
}

ask_confirm() {  # $1 = prompt text (without trailing "[y/N]")
  if (( YES )); then
    return 0
  fi
  # /dev/tty as a path always "exists" (-e) even with no controlling
  # terminal -- opening it is what fails (ENXIO), so open it (read+write, on
  # a private fd) to actually test that, not just stat it. The braces (not a
  # subshell) are load-bearing: `exec 8<>/dev/tty 2>/dev/null` on its own
  # line prints bash's own "No such device or address" to the real stderr
  # anyway (the failing redirection is set up before that 2>/dev/null would
  # apply); wrapping it in a group command applies the 2>/dev/null first.
  if ! { exec 8<>/dev/tty; } 2>/dev/null; then
    {
      echo "no controlling terminal to confirm on, and --yes was not given."
      echo "Remaining: $1"
    } >&2
    exit 2
  fi
  local reply=
  printf '%s [y/N] ' "$1" >&8
  if ! IFS= read -r reply <&8; then
    exec 8>&-
    echo "could not read a confirmation from /dev/tty" >&2
    exit 2
  fi
  exec 8>&-
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) echo "aborted." >&2; exit 1 ;;
  esac
}

with_lock() {  # $@ = command to run under the lock
  mkdir -p "$SHARE"
  exec 9>"$LOCK"
  if ! flock -n 9; then
    say "Waiting for another serverjack-ctl run to finish..."
    flock 9
  fi
  "$@"
}

# Reads $ENV_FILE the same way install.sh's cfg() does: last matching KEY=
# line wins, optional surrounding quotes stripped. Never `source`d (unquoted
# spaces like a --title value would break that).
env_get() {
  local key=$1 fallback=${2-} line v=
  [[ -f $ENV_FILE ]] || { printf '%s' "$fallback"; return; }
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == "$key="* ]] && v=${line#*=}
  done < "$ENV_FILE"
  v=${v#\"}; v=${v%\"}
  printf '%s' "${v:-$fallback}"
}

# Sets CHANNEL to "release", "git" or "unknown", and GIT_REPO when "git".
#
# Decided by a PHYSICAL signal first, install.json only as a fallback --
# same precedence as bin/serverjack's _install_channel(), and for the same
# reason: install.json existing says nothing about what THIS unit's
# ExecStart= actually points at (a stale install.json from a since-removed
# managed install must not shadow a real git-checkout unit that replaced it).
#
# For "release": install.sh always bakes the STABLE ".../current/bin/..."
# path into ExecStart= for a managed install (never the physical release
# dir -- that's the whole point of the symlink), so a plain substring match
# against $CURRENT is exact and needs no parsing.
#
# For "git": install.sh additionally writes the checkout's absolute path,
# in plain text, to $HOME/.config/serverjack/install-path (only for a
# git-checkout install -- see install.sh). Reading that avoids parsing
# ExecStart= at all, which used to need undoing systemd's own %/\/" quoting
# of the path baked in there and didn't -- a repo path containing a literal
# "%" came back from that regex still doubled ("%%"), so -d "$repo/.git"
# silently failed and a real git checkout could misreport as "unknown".
detect_channel() {
  CHANNEL=unknown
  GIT_REPO=""
  local unit="$UNIT_DIR/serverjack.service" exec_line
  if [[ -f $unit ]]; then
    exec_line=$(grep -m1 '^ExecStart=' "$unit" || true)
    if [[ $exec_line == *"\"$CURRENT/bin/serverjack\""* ]]; then
      CHANNEL=release
    fi
  fi
  if [[ $CHANNEL != release ]]; then
    local install_path="$HOME/.config/serverjack/install-path" repo
    if [[ -f $install_path ]]; then
      repo=$(<"$install_path")
      if [[ -n $repo && -d "$repo/.git" ]]; then
        CHANNEL=git
        GIT_REPO=$repo
      fi
    fi
  fi
  if [[ $CHANNEL == unknown && -f $INSTALL_JSON ]]; then
    local ch
    ch=$(python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("channel",""))
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null || true)
    [[ $ch == release ]] && CHANNEL=release
  fi
}

require_release_channel() {  # $1 = command name, for the error message
  detect_channel
  [[ $CHANNEL == release ]] || {
    echo "'$1' needs a managed release install (channel=$CHANNEL, no $INSTALL_JSON)." >&2
    if [[ $CHANNEL == git ]]; then
      echo "This is a git checkout ($GIT_REPO) -- use: cd $GIT_REPO && git pull --ff-only && bash install.sh" >&2
    fi
    exit 1
  }
}

installed_version() {
  if [[ -f $INSTALL_JSON ]]; then
    python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("version") or "")
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null
  elif [[ -f "$CURRENT/RELEASE" ]]; then
    sed -n 's/^version=//p' "$CURRENT/RELEASE"
  fi
}

previous_version() {
  [[ -f $INSTALL_JSON ]] || return 0
  python3 -c 'import json,sys
try:
    v = json.load(sys.stdin).get("previous")
    print(v or "")
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null
}

# "activating" while an update/rollback has swapped "current" and started
# install.sh but has not yet confirmed the health check; empty once
# confirmed (write_install_json omits the field entirely on success) or for
# an install.json written before this existed. See cmd_update's own comment
# on why "previous"/"version" are written BEFORE the swap, which is what
# makes this record (and `rollback`) trustworthy even after an interrupt.
installed_state() {
  [[ -f $INSTALL_JSON ]] || return 0
  python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("state") or "")
except Exception:
    print("")' < "$INSTALL_JSON" 2>/dev/null
}

# Prints, one per line, the install_args (e.g. --no-serve) the bootstrap was
# first run with -- see bootstrap/serverjack-bootstrap.sh.in. These are
# run-time-only install.sh flags with nothing in the env file to remember
# them, so `update`/`rollback` must read them back and pass them to
# install.sh again, or a flag deliberately chosen at install time (most
# importantly --no-serve) silently stops applying on the very next update.
# An install.json written before this field existed has none -- prints
# nothing, matching that install's original (flag-less) behavior exactly.
installed_args() {
  [[ -f $INSTALL_JSON ]] || return 0
  python3 -c 'import json,sys
try:
    for a in json.load(sys.stdin).get("install_args") or []:
        print(a)
except Exception:
    pass' < "$INSTALL_JSON" 2>/dev/null
}

write_install_json() {  # $1 version, $2 previous (may be empty), $3 state ("" or "activating"), $4.. install_args
  local version=$1 previous=$2 state=$3 tmp
  shift 3
  mkdir -p "$SHARE"
  tmp=$(mktemp "$SHARE/.install.json.XXXXXX")
  python3 - "$version" "$previous" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$state" "$@" > "$tmp" <<'PY'
import json
import sys

version, previous, installed_at, state = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
install_args = sys.argv[5:]
doc = {"channel": "release", "version": version, "installed_at": installed_at,
       "previous": previous or None, "install_args": install_args}
if state:
    doc["state"] = state
json.dump(doc, sys.stdout, indent=2)
print()
PY
  mv -f "$tmp" "$INSTALL_JSON"
}

# Atomic symlink swap: $1 is what "current" should point at, either a path
# relative to $SHARE ("releases/1.4.0") or an absolute one already read back
# with readlink.
swap_current() {
  local target=$1 tmp_link="$SHARE/.current.$$"
  mkdir -p "$SHARE"
  ln -s "$target" "$tmp_link"
  mv -T "$tmp_link" "$CURRENT"
}

healthz_code() {
  local listen port sock
  listen=$(env_get SERVERJACK_LISTEN tcp)
  # local_http_code() (bin/serverjack-lib.sh) already handles the connection-
  # failure case cleanly -- printing curl's own "000" once, not twice (A8:
  # `curl ... || echo 000` after curl's OWN -w output had already printed
  # "000" produced the six-character string "000000").
  if [[ $listen == unix ]]; then
    sock="${XDG_RUNTIME_DIR}/serverjack/web.sock"
    local_http_code -m 5 --connect-timeout 5 --unix-socket "$sock" http://serverjack/healthz
  else
    port=$(env_get SERVERJACK_PORT 7680)
    local_http_code -m 5 --connect-timeout 5 "http://127.0.0.1:$port/healthz"
  fi
}

# True only when BOTH units are active. B4 (Codex): `systemctl is-active
# PATTERN...` with MULTIPLE unit names is a logical OR, not AND -- per
# systemctl(1): "Returns an exit code 0 if at least one is active". A single
# `is-active --quiet serverjack serverjack-ttyd` call here used to pass this
# health gate with ttyd stopped (or crash-looping) as long as serverjack
# itself was up, so `update`/`rollback` could confirm a release "healthy"
# with the terminal completely unreachable. Two separate calls, ANDed by the
# shell, actually require both. (Every OTHER `is-active unit1 unit2` in this
# codebase is display-only -- it prints each unit's own state to stdout via
# `paste` and only ever uses `|| true` to stop `set -e` from aborting on a
# non-zero it doesn't otherwise act on -- so this is the one call whose
# exit code was actually being trusted as a real AND.)
units_active() {
  systemctl --user is-active --quiet serverjack \
    && systemctl --user is-active --quiet serverjack-ttyd
}

wait_healthy() {  # $1 = timeout seconds
  # Health is /healthz (always open, even under SERVERJACK_ALLOW -- see
  # bin/serverjack's OPEN_PATHS) plus both units being active. It used to
  # also probe SERVERJACK_TERM (/term/), but that path is NOT in OPEN_PATHS:
  # with SERVERJACK_ALLOW set, a plain loopback probe with no
  # Tailscale-User-Login identity gets 403 forever, so every update and
  # rollback on an ALLOW-restricted install auto-rolled-back even though the
  # new release was perfectly healthy. This process has no way to send an
  # identity tailscaled itself would trust (that header is only honored from
  # tailscaled's own uid), so /term/ is not a probe this helper can use.
  local timeout=$1 deadline code
  deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    code=$(healthz_code)
    if [[ $code == 200 ]] && units_active; then
      return 0
    fi
    sleep 1
  done
  return 1
}

backup_current_state() {  # prints the backup dir it created
  local ts backup_dir
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  backup_dir="$BACKUP_ROOT/$ts"
  mkdir -p "$backup_dir"
  [[ -f "$UNIT_DIR/serverjack.service" ]] && cp -a "$UNIT_DIR/serverjack.service" "$backup_dir/"
  [[ -f "$UNIT_DIR/serverjack-ttyd.service" ]] && cp -a "$UNIT_DIR/serverjack-ttyd.service" "$backup_dir/"
  [[ -f $ENV_FILE ]] && cp -a "$ENV_FILE" "$backup_dir/env"
  # The release being activated already replaced ~/.local/bin/serverjack-ctl
  # AND ~/.local/bin/serverjack-setup with its own copies before install.sh
  # even runs (that install happens inside THIS call, below) -- back both up,
  # or a failed release leaves its (possibly broken) copy of either in place
  # even after everything else is rolled back.
  [[ -f "$HOME/.local/bin/serverjack-ctl" ]] && cp -a "$HOME/.local/bin/serverjack-ctl" "$backup_dir/serverjack-ctl"
  [[ -f "$HOME/.local/bin/serverjack-setup" ]] && cp -a "$HOME/.local/bin/serverjack-setup" "$backup_dir/serverjack-setup"
  printf '%s' "$backup_dir"
}

# Restores units/env/serverjack-ctl from a backup_current_state() dir, points
# "current" back at $2 (a symlink target, e.g. "releases/1.3.0"), restarts
# the units, and waits for health -- best effort, used both by the
# auto-rollback inside `update` and by the explicit `rollback` subcommand's
# own failure path.
restore_from_backup() {  # $1 version being restored, $2 symlink target, $3 backup dir
  local version=$1 target=$2 backup_dir=$3
  swap_current "$target"
  [[ -f "$backup_dir/serverjack.service" ]] && cp -a "$backup_dir/serverjack.service" "$UNIT_DIR/"
  [[ -f "$backup_dir/serverjack-ttyd.service" ]] && cp -a "$backup_dir/serverjack-ttyd.service" "$UNIT_DIR/"
  if [[ -f "$backup_dir/env" ]]; then
    cp -a "$backup_dir/env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
  if [[ -f "$backup_dir/serverjack-ctl" ]]; then
    # `install`, not `cp`: this file may be the very one bash is currently
    # executing (a plain rollback run by hand, not just the auto-rollback
    # inside `update`). `install` replaces the directory entry with a fresh
    # inode instead of overwriting the existing one in place, so a process
    # already reading the old inode (this one) is unaffected.
    install -m 755 "$backup_dir/serverjack-ctl" "$HOME/.local/bin/serverjack-ctl"
  fi
  [[ -f "$backup_dir/serverjack-setup" ]] \
    && install -m 755 "$backup_dir/serverjack-setup" "$HOME/.local/bin/serverjack-setup"
  systemctl --user daemon-reload
  # Never restart tmux -- only the two units. KillMode=process on both keeps
  # every tmux session (and the terminal a browser has attached to) alive.
  systemctl --user restart serverjack serverjack-ttyd || true
  if wait_healthy 15; then
    echo "restored $version, healthy." >&2
  else
    echo "restored $version, but it did not answer healthy within 15s -- check: journalctl --user -u serverjack -n 50" >&2
  fi
}

# Removes serverjack's user units, its runtime sockets and any tailscale
# serve route it owns -- the SAME operations $CURRENT/uninstall.sh performs
# (see that file), reimplemented here so cmd_uninstall can still fully
# remove a managed install when $CURRENT/uninstall.sh is missing or fails --
# a dangling "current" symlink (its release directory pruned or deleted by
# hand), a corrupted release, or an uninstall.sh that errors partway. This
# process cannot rely on anything living under $CURRENT to do that job,
# since $CURRENT is exactly what might be gone.
#
# Prints what it did/left, the same way uninstall.sh does. Returns non-zero
# if either unit FILE is still present afterward -- that is the one thing
# cmd_uninstall actually gates on (whether $SHARE is safe to remove and
# whether to exit non-zero); the tailscale serve route stays best-effort/
# advisory, same as uninstall.sh: leaving a foreign or ambiguous mapping
# alone is correct behavior, not a failure of this function's job.
remove_units_and_serve_route() {
  systemctl --user disable --now serverjack serverjack-ttyd 2>/dev/null
  rm -f "$UNIT_DIR/serverjack.service" "$UNIT_DIR/serverjack-ttyd.service"
  systemctl --user daemon-reload

  local runtime="${XDG_RUNTIME_DIR}/serverjack"
  rm -f "$runtime/web.sock" "$runtime/ttyd.sock" "$runtime/secret"

  if command -v tailscale >/dev/null 2>&1; then
    local mount https port legacy_port config_ok=1
    mount=$(env_get SERVERJACK_TERM /term/); mount=${mount%/}
    https=$(env_get SERVERJACK_HTTPS_PORT 443)
    port=$(env_get SERVERJACK_PORT 7680)
    legacy_port=$(env_get TTYD_PORT)

    [[ $https =~ ^(443|8443|10000)$ ]] || config_ok=0
    [[ $port =~ ^[0-9]{1,5}$ ]] \
      && (( 10#$port >= 1 && 10#$port <= 65535 )) || config_ok=0
    [[ $mount =~ ^/[A-Za-z0-9._~/-]+$ && $mount != / ]] || config_ok=0
    if [[ -n $legacy_port ]]; then
      if [[ $legacy_port =~ ^[0-9]{1,5}$ ]] \
          && (( 10#$legacy_port >= 1 && 10#$legacy_port <= 65535 )); then
        legacy_port=$((10#$legacy_port))
      else
        legacy_port=
      fi
    fi

    local serve_status
    if (( ! config_ok )); then
      echo "tailscale serve routes left unchanged: serverjack's saved port, HTTPS port or terminal path is invalid" >&2
    elif ! serve_status=$(tailscale serve status 2>/dev/null); then
      echo "tailscale serve routes left unchanged: could not inspect the current serve status" >&2
    else
      port=$((10#$port))
      local -a own_backends=("http://127.0.0.1:$port" "unix:$runtime/web.sock" "unix:$runtime/ttyd.sock")
      [[ -n $legacy_port ]] && own_backends+=("http://127.0.0.1:$legacy_port")
      # remove_owned_mapping/serve_backends_for/backend_is_ours: bin/serverjack-lib.sh
      # (A11) -- was three drifting copies of the same parsing and removal
      # logic (here, uninstall.sh, and no equivalent at all in serverjack-setup).
      remove_owned_mapping "https=$https path=/" "$serve_status" "$https" / "${own_backends[@]}"
      remove_owned_mapping "https=$https path=$mount" "$serve_status" "$https" "$mount" "${own_backends[@]}"
    fi
  fi

  [[ ! -f "$UNIT_DIR/serverjack.service" && ! -f "$UNIT_DIR/serverjack-ttyd.service" ]]
}

# ------------------------------------------------------------------ status
cmd_status() {
  detect_channel
  case $CHANNEL in
    release)
      local prev state; prev=$(previous_version); state=$(installed_state)
      echo "channel:  release"
      echo "current:  $(installed_version)"
      echo "previous: ${prev:-none}"
      if [[ $state == activating ]]; then
        echo "state:    activating -- an update/rollback was interrupted before it could"
        echo "          confirm health. \"current\" above is already correct; run"
        echo "          \`serverjack-ctl update\` to resume it, or \`serverjack-ctl rollback\`"
        echo "          to go back to $prev directly."
      fi
      ;;
    git)
      local v
      # `|| true`: sed itself exits non-zero when its input file is simply
      # missing (a moved/deleted checkout, or -- found by the test for
      # finding 9 -- a fabricated GIT_REPO with no bin/serverjack at all),
      # and 2>/dev/null only silences the message, not the exit status --
      # same class of bug as finding 6, just a different command.
      v=$(sed -n 's/^VERSION = "\(.*\)"/\1/p' "$GIT_REPO/bin/serverjack" 2>/dev/null || true)
      echo "channel:  git checkout ($GIT_REPO)"
      echo "current:  ${v:-unknown}"
      ;;
    *)
      echo "channel:  unknown (no $INSTALL_JSON, no recognizable git-checkout unit)"
      ;;
  esac
  local active
  # `systemctl --user is-active` exits non-zero (under pipefail, so this
  # whole pipeline) whenever EITHER unit isn't active -- which is the normal
  # case right after a stop or a crash, not a script bug. Without the
  # `|| true`, `set -e` aborted the entire `status` subcommand on exactly
  # the situation someone runs `status` to look at.
  active=$( { systemctl --user is-active serverjack serverjack-ttyd 2>/dev/null || true; } | paste -sd' ' -)
  echo "units:    serverjack=${active%% *} serverjack-ttyd=${active#* }"
  local listen; listen=$(env_get SERVERJACK_LISTEN tcp)
  if [[ $listen == unix ]]; then
    echo "listen:   unix ${XDG_RUNTIME_DIR}/serverjack/web.sock"
  else
    echo "listen:   tcp 127.0.0.1:$(env_get SERVERJACK_PORT 7680)"
  fi
  echo "healthz:  $(healthz_code)"
}

# ----------------------------------------------------------------- versions
cmd_versions() {
  require_release_channel versions
  [[ -d $RELEASES ]] || { echo "no releases staged yet"; return; }
  local cur_target d v marker
  cur_target=$(readlink -f "$CURRENT" 2>/dev/null || true)
  for d in "$RELEASES"/*/; do
    [[ -d $d ]] || continue
    v=$(basename "$d")
    marker=" "
    [[ $(readlink -f "$d" 2>/dev/null || true) == "$cur_target" ]] && marker="*"
    echo "$marker $v"
  done
}

# ------------------------------------------------------------------ update
resolve_release() {  # sets REL_VERSION REL_BOOTSTRAP_URL REL_SUMS_URL
  local base_url=${SERVERJACK_RELEASE_BASE_URL:-$DEFAULT_BASE_URL}
  base_url=${base_url%/}
  if [[ -n $OPT_VERSION ]]; then
    REL_VERSION=$OPT_VERSION
    REL_BOOTSTRAP_URL="$base_url/v$REL_VERSION/serverjack-bootstrap.sh"
    REL_SUMS_URL="$base_url/v$REL_VERSION/SHA256SUMS"
    return
  fi
  [[ -z ${SERVERJACK_RELEASE_BASE_URL:-} ]] || {
    echo "SERVERJACK_RELEASE_BASE_URL is set but --version was not -- there is no \"latest\" to resolve on a mirror; pass --version explicitly" >&2
    exit 1
  }
  say "Checking github.com for the latest release"
  local json
  json=$(curl -fsSL --proto '=https' --proto-redir '=https' "$GITHUB_API") \
    || { echo "could not reach $GITHUB_API" >&2; exit 1; }
  REL_VERSION=$(python3 -c '
import json, sys
tag = json.load(sys.stdin).get("tag_name", "")
print(tag[1:] if tag.startswith("v") else tag)
' <<< "$json")
  [[ -n $REL_VERSION ]] || { echo "could not parse tag_name from the GitHub API response" >&2; exit 1; }
  REL_BOOTSTRAP_URL=$(python3 -c '
import json, sys
for a in json.load(sys.stdin).get("assets", []):
    if a.get("name") == "serverjack-bootstrap.sh":
        print(a["browser_download_url"]); break
' <<< "$json")
  REL_SUMS_URL=$(python3 -c '
import json, sys
for a in json.load(sys.stdin).get("assets", []):
    if a.get("name") == "SHA256SUMS":
        print(a["browser_download_url"]); break
' <<< "$json")
  [[ -n $REL_BOOTSTRAP_URL && -n $REL_SUMS_URL ]] \
    || { echo "latest release ($REL_VERSION) is missing the serverjack-bootstrap.sh or SHA256SUMS asset" >&2; exit 1; }
}

# Downloads the resolved release's bootstrap script + SHA256SUMS, parses the
# archive URL and pinned sha256 back out of the bootstrap (it is the one
# place that pairing is defined -- see bootstrap/serverjack-bootstrap.sh.in),
# downloads and verifies the archive, and extracts it into $RELEASES/<version>/
# WITHOUT TOUCHING "current". Sets STAGED_DIR. Caller must have already
# called resolve_release() (cmd_update does this itself, before staging, so
# it can compare the resolved version against the installed one -- see
# there for why that order matters).
#
# The extraction lands in a scratch directory first and is only mv'd to its
# final $RELEASES/$REL_VERSION name once it is a complete, checksum-verified
# release -- that name is never rm -rf'd to make room first. It used to be:
# stage a fresh copy by deleting and re-extracting straight into
# $RELEASES/$REL_VERSION. For an ordinary new version that is merely
# wasteful (nothing was there yet); for a NO-OP re-stage of the version
# that is already current, $RELEASES/$REL_VERSION IS the live release
# directory "current" resolves to, and that rm -rf deleted it out from under
# the running install for the length of the extraction. cmd_update now
# compares versions and returns before ever calling this for that case, but
# the guard below stays anyway -- a live directory should never be removed
# by this function, full stop, however it ends up being called.
stage_release() {
  local tmp; tmp=$(mktemp -d)
  # Double-quoted so $tmp is substituted NOW, not when the trap eventually
  # fires: $tmp is `local` to this function, so a deferred (single-quoted)
  # expansion would see an unbound variable by the time the script actually
  # exits, well after this function has returned.
  # shellcheck disable=SC2064  # immediate expansion is the point, see above
  trap "rm -rf '$tmp'" EXIT
  say "Fetching release metadata for $REL_VERSION"
  fetch -o "$tmp/serverjack-bootstrap.sh" "$REL_BOOTSTRAP_URL" \
    || { echo "download failed: $REL_BOOTSTRAP_URL" >&2; exit 1; }
  fetch -o "$tmp/SHA256SUMS" "$REL_SUMS_URL" \
    || { echo "download failed: $REL_SUMS_URL" >&2; exit 1; }

  local archive_url archive_sha
  archive_url=$(sed -n 's/^EMBEDDED_ARCHIVE_URL="\(.*\)"$/\1/p' "$tmp/serverjack-bootstrap.sh" | head -1)
  archive_sha=$(sed -n 's/^EMBEDDED_ARCHIVE_SHA256="\(.*\)"$/\1/p' "$tmp/serverjack-bootstrap.sh" | head -1)
  [[ -n $archive_url && -n $archive_sha ]] \
    || { echo "could not parse the archive URL/sha256 out of the downloaded bootstrap script" >&2; exit 1; }
  if [[ -n ${SERVERJACK_RELEASE_BASE_URL:-} && $archive_url == "$DEFAULT_BASE_URL"* ]]; then
    archive_url="${SERVERJACK_RELEASE_BASE_URL%/}${archive_url#"$DEFAULT_BASE_URL"}"
  fi

  local archive="$tmp/serverjack-$REL_VERSION.tar.gz"
  fetch -o "$archive" "$archive_url" \
    || { echo "download failed: $archive_url" >&2; exit 1; }
  [[ -s $archive ]] || { echo "downloaded archive is empty: $archive_url" >&2; exit 1; }
  local got; got=$(sha256sum "$archive" | awk '{print $1}')
  if [[ $got != "$archive_sha" ]]; then
    echo "checksum mismatch for $(basename "$archive"): got $got, want $archive_sha -- refusing to stage a corrupted or tampered archive" >&2
    exit 1
  fi
  if grep -q " $(basename "$archive")\$" "$tmp/SHA256SUMS" 2>/dev/null; then
    grep -q "^$archive_sha  $(basename "$archive")\$" "$tmp/SHA256SUMS" \
      || echo "  note: archive matches the bootstrap's pinned hash but not SHA256SUMS (release re-cut?)" >&2
  fi
  say "Checksum OK for serverjack $REL_VERSION ($got)"

  mkdir -p "$RELEASES"
  local scratch; scratch=$(mktemp -d "$RELEASES/.stage.XXXXXX")
  tar -xzf "$archive" -C "$scratch" --strip-components=1
  # $tmp (the downloaded bootstrap script, SHA256SUMS and the archive
  # itself) is done being needed the moment extraction succeeds -- clean it
  # up explicitly here rather than leaving it to the EXIT trap alone.
  # cmd_update registers its OWN EXIT/INT/TERM/HUP trap right after this
  # function returns (for the activation-interrupt record), which REPLACES
  # this one -- bash allows only one handler per signal -- so relying solely
  # on the trap would silently stop cleaning up $tmp on every successful
  # `update` from that point on. The trap stays in place for every earlier,
  # abnormal exit in this function (checksum mismatch, download failure,
  # ...); this just also handles the ordinary success path explicitly.
  rm -rf "$tmp"
  trap - EXIT

  local final="$RELEASES/$REL_VERSION" live_target
  live_target=$(readlink -f "$CURRENT" 2>/dev/null || true)
  if [[ -n $live_target && $(readlink -f "$final" 2>/dev/null || true) == "$live_target" ]]; then
    echo "internal error: refusing to replace $final -- \"current\" resolves to it" >&2
    rm -rf "$scratch"
    exit 1
  fi
  rm -rf "$final"
  mv -T "$scratch" "$final"
  STAGED_DIR=$final
}

# Trap target for the window between write_install_json(...,"activating",...)
# and the finalize-or-rollback that follows it in cmd_update -- see the
# comment there. Registered as a bare function name (not an inline string)
# for EXIT INT TERM HUP; ACTIVATING_* are plain globals, not locals, so they
# stay reachable regardless of exactly where in that window the interrupt
# lands. Guarded by ACTIVATING_FINISHED so it prints at most once even
# though its own `exit` re-fires the EXIT half of the same trap.
_activation_interrupted() {
  local rc=$?
  if (( ! ACTIVATING_FINISHED )); then
    ACTIVATING_FINISHED=1
    echo "update to $ACTIVATING_NEW_VERSION was interrupted while activating -- \"current\" already points at it and install.json already reflects that (see \`serverjack-ctl status\`). Run \`serverjack-ctl rollback\` to go back to $ACTIVATING_OLD_VERSION, or \`serverjack-ctl update\` again to resume." >&2
  fi
  exit "$rc"
}

cmd_update() {
  OPT_VERSION=
  while (( $# )); do
    case "$1" in
      --version)  OPT_VERSION=${2:?--version needs X.Y.Z}; shift ;;
      --version=*) OPT_VERSION=${1#*=} ;;
      --yes)      YES=1 ;;
      *) echo "unknown option to update: $1" >&2; exit 1 ;;
    esac
    shift
  done
  if [[ -n $OPT_VERSION && ! $OPT_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]; then
    echo "--version must look like X.Y.Z, got: $OPT_VERSION" >&2
    exit 1
  fi

  detect_channel
  if [[ $CHANNEL == git ]]; then
    # detect_channel() only looks at $CFG_DIR/install-path plus that path
    # having a .git dir -- neither says the install is actually still
    # THERE. uninstall.sh removes the units but (deliberately) keeps
    # ~/.config/serverjack, install-path included, so a checkout that was
    # already uninstalled still reports channel=git here, and `update`
    # would happily resurrect it with a fresh `git pull && bash install.sh`
    # instead of refusing. Require the unit that a real, current install
    # would have.
    [[ -f "$UNIT_DIR/serverjack.service" ]] || {
      echo "no serverjack units found here ($UNIT_DIR/serverjack.service) -- this looks like a checkout that was already uninstalled, not a live install to update." >&2
      echo "To reinstall: cd $GIT_REPO && bash install.sh (or: serverjack-ctl setup)" >&2
      exit 1
    }
    [[ -z $OPT_VERSION ]] || echo "note: --version is ignored for a git checkout; that's a git operation (git checkout v$OPT_VERSION)" >&2
    ask_confirm "Run: cd $GIT_REPO && git pull --ff-only && bash install.sh ?"
    ( cd "$GIT_REPO" && git pull --ff-only && bash install.sh )
    return
  fi
  [[ $CHANNEL == release ]] || {
    echo "not a recognized serverjack install here (no $INSTALL_JSON, no git checkout)" >&2
    exit 1
  }

  # Resume an update that was interrupted before it could confirm success
  # (Ctrl-C, SIGHUP from a closed terminal, a reboot mid-install.sh or
  # mid-health-wait): install.json still says "state": "activating", which
  # only ever happens between the pre-swap write below and this command's
  # own finalize/rollback -- a normal, completed update or rollback always
  # clears it. "current" already points at the interrupted version (the
  # write always immediately precedes the swap), so there is nothing to
  # re-stage or re-swap; just retry install.sh + the health wait for what
  # is already there, matching what would have happened if nothing had
  # interrupted it.
  local resume_state; resume_state=$(installed_state)
  if [[ $resume_state == activating ]]; then
    local resume_version resume_previous
    resume_version=$(installed_version)
    resume_previous=$(previous_version)
    echo "note: a previous update to $resume_version was interrupted before it finished (\"current\" already points at it) -- resuming it." >&2
    local -a resume_args=()
    mapfile -t resume_args < <(installed_args)
    if bash "$CURRENT/install.sh" ${resume_args[@]+"${resume_args[@]}"} && wait_healthy 30; then
      write_install_json "$resume_version" "$resume_previous" "" ${resume_args[@]+"${resume_args[@]}"}
      say "Resumed and activated serverjack $resume_version"
      return
    fi
    echo "resuming $resume_version failed (install.sh or the health check) -- rolling back to $resume_previous" >&2
    if [[ -n $resume_previous && -d "$RELEASES/$resume_previous" ]]; then
      swap_current "releases/$resume_previous"
      if bash "$CURRENT/install.sh" ${resume_args[@]+"${resume_args[@]}"} && wait_healthy 30; then
        write_install_json "$resume_previous" "$resume_version" "" ${resume_args[@]+"${resume_args[@]}"}
        say "Rolled back to $resume_previous"
        return
      fi
    fi
    echo "automatic rollback also failed -- run \`serverjack-ctl status\` to see where things stand, or fix the release and try \`serverjack-ctl update\`/\`rollback\` again." >&2
    exit 1
  fi

  # Resolve BEFORE staging: a no-op update (the resolved version is already
  # current) must never touch $RELEASES at all, let alone the live release
  # directory "current" points at -- see stage_release()'s own comment.
  resolve_release
  local new_version=$REL_VERSION
  local current_version; current_version=$(installed_version)
  if [[ $new_version == "$current_version" ]]; then
    say "serverjack $current_version is already current."
    return
  fi
  ask_confirm "Activate serverjack $new_version (currently $current_version)?"

  # install_args persist across every update/rollback until changed on
  # purpose -- a flag chosen at bootstrap time (most importantly --no-serve)
  # has nothing in the env file to remember it by, so without replaying it
  # here install.sh would run with its defaults on the very next update.
  local -a persisted_args=()
  mapfile -t persisted_args < <(installed_args)

  stage_release
  say "Staged serverjack $new_version -> $STAGED_DIR"

  local prev_target; prev_target=$(readlink "$CURRENT" 2>/dev/null || true)
  local backup_dir; backup_dir=$(backup_current_state)
  # Captured BEFORE the pre-swap write below overwrites install.json's
  # "previous" field: a NORMAL failure (install.sh/health, not an
  # interrupt) restores install.json to exactly what it said before this
  # attempt, and this is the one piece restore_from_backup() itself doesn't
  # know (it restores units/env/serverjack-ctl, never install.json).
  local orig_previous; orig_previous=$(previous_version)

  # Record the activation BEFORE the swap: from here to the finalize/
  # rollback below, an interrupt must not leave install.json still saying
  # $current_version while "current" already points at $new_version -- that
  # desync is exactly what made `status` misreport and `rollback` refuse
  # after an interrupted update. Writing "previous" here (not only on
  # success) is what makes `rollback` correct even if this process never
  # gets back here to finish; "state": "activating" is what tells a later
  # `update`/`status` that this record isn't confirmed yet.
  write_install_json "$new_version" "$current_version" "activating" ${persisted_args[@]+"${persisted_args[@]}"}
  ACTIVATING_NEW_VERSION=$new_version
  ACTIVATING_OLD_VERSION=$current_version
  ACTIVATING_FINISHED=0
  trap _activation_interrupted EXIT INT TERM HUP

  swap_current "releases/$new_version"
  if bash "$CURRENT/install.sh" ${persisted_args[@]+"${persisted_args[@]}"} && wait_healthy 30; then
    ACTIVATING_FINISHED=1
    trap - EXIT INT TERM HUP
    unset ACTIVATING_FINISHED ACTIVATING_NEW_VERSION ACTIVATING_OLD_VERSION
    write_install_json "$new_version" "$current_version" "" ${persisted_args[@]+"${persisted_args[@]}"}
    say "Activated serverjack $new_version"
    return
  fi
  ACTIVATING_FINISHED=1
  trap - EXIT INT TERM HUP
  unset ACTIVATING_FINISHED ACTIVATING_NEW_VERSION ACTIVATING_OLD_VERSION
  echo "update to $new_version failed (install.sh or the health check) -- rolling back to $current_version" >&2
  restore_from_backup "$current_version" "${prev_target:-releases/$current_version}" "$backup_dir"
  # This is a handled failure, not an interrupt: install.json must go back
  # to exactly what it said before this attempt (still "activating" would
  # be stale/wrong, and "version" must NOT be left naming the release that
  # just failed and was rolled back away from).
  write_install_json "$current_version" "$orig_previous" "" ${persisted_args[@]+"${persisted_args[@]}"}
  exit 1
}

# ---------------------------------------------------------------- rollback
cmd_rollback() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to rollback: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel rollback
  local prev; prev=$(previous_version)
  [[ -n $prev ]] || { echo "no previous version recorded in $INSTALL_JSON -- nothing to roll back to" >&2; exit 1; }
  [[ -d "$RELEASES/$prev" ]] || { echo "previous version $prev is not staged in $RELEASES (pruned?) -- cannot roll back" >&2; exit 1; }

  local cur; cur=$(installed_version)
  ask_confirm "Roll back serverjack from $cur to $prev?"

  local -a persisted_args=()
  mapfile -t persisted_args < <(installed_args)

  local backup_dir; backup_dir=$(backup_current_state)

  # Same reasoning as cmd_update: record the swap BEFORE it happens, so an
  # interrupt here can't leave install.json out of sync with "current".
  write_install_json "$prev" "$cur" "activating" ${persisted_args[@]+"${persisted_args[@]}"}
  ACTIVATING_NEW_VERSION=$prev
  ACTIVATING_OLD_VERSION=$cur
  ACTIVATING_FINISHED=0
  trap _activation_interrupted EXIT INT TERM HUP

  swap_current "releases/$prev"
  if bash "$CURRENT/install.sh" ${persisted_args[@]+"${persisted_args[@]}"} && wait_healthy 30; then
    ACTIVATING_FINISHED=1
    trap - EXIT INT TERM HUP
    unset ACTIVATING_FINISHED ACTIVATING_NEW_VERSION ACTIVATING_OLD_VERSION
    write_install_json "$prev" "$cur" "" ${persisted_args[@]+"${persisted_args[@]}"}
    say "Rolled back to $prev"
    return
  fi
  ACTIVATING_FINISHED=1
  trap - EXIT INT TERM HUP
  unset ACTIVATING_FINISHED ACTIVATING_NEW_VERSION ACTIVATING_OLD_VERSION
  echo "rollback to $prev failed (install.sh or the health check) -- restoring $cur" >&2
  restore_from_backup "$cur" "releases/$cur" "$backup_dir"
  # Handled failure, not an interrupt: install.json goes back to exactly
  # what it said before this attempt (version=$cur, previous=$prev is
  # literally the pre-attempt state here, no separate capture needed).
  write_install_json "$cur" "$prev" "" ${persisted_args[@]+"${persisted_args[@]}"}
  exit 1
}

# --------------------------------------------------------------- uninstall
cmd_uninstall() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to uninstall: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel uninstall
  local v; v=$(installed_version)
  ask_confirm "Uninstall serverjack $v? This removes the systemd units, the tailscale serve route it owns, and $SHARE. ~/.config/serverjack and your tmux sessions are kept."

  # $CURRENT/uninstall.sh is preferred when it works, but its success is
  # never assumed: a dangling "current" (release pruned or deleted by hand),
  # a corrupted release, or an uninstall.sh that errors partway must not
  # still report full success and delete $SHARE regardless -- that used to
  # happen unconditionally. remove_units_and_serve_route() re-runs the same,
  # idempotent removal either way and is what actually gates $SHARE and the
  # exit status below, so the reported outcome matches what is really true
  # on disk.
  local units_gone=0
  if [[ -x "$CURRENT/uninstall.sh" ]]; then
    if bash "$CURRENT/uninstall.sh"; then
      units_gone=1
    else
      echo "warning: $CURRENT/uninstall.sh exited non-zero -- removing the units and serve route directly instead" >&2
    fi
  else
    echo "warning: $CURRENT/uninstall.sh not found (dangling or corrupted \"current\"?) -- removing the units and serve route directly instead" >&2
  fi
  if (( ! units_gone )) && remove_units_and_serve_route; then
    units_gone=1
  fi

  if (( units_gone )); then
    rm -rf "$SHARE"
    echo "removed: serverjack/serverjack-ttyd units, their tailscale serve route, $SHARE"
    echo "kept: ~/.config/serverjack, ~/.local/bin/serverjack-ctl, ~/.local/bin/ttyd and fzf, your tmux sessions"
  else
    echo "the units could not be fully removed -- $SHARE was left in place (nothing lost, and \`serverjack-ctl status\`/a retry still has something to look at)." >&2
    echo "kept (removal incomplete): serverjack/serverjack-ttyd units, $SHARE" >&2
    echo "kept (untouched): ~/.config/serverjack, ~/.local/bin/serverjack-ctl, ~/.local/bin/ttyd and fzf, your tmux sessions" >&2
    exit 1
  fi
}

# -------------------------------------------------------------------- setup
# Just an exec of the installed guided-setup script -- always
# ~/.local/bin/serverjack-setup, since install.sh puts it there for both
# channels (same as this file). It re-runs its own detect-an-existing-install
# logic (which recognizes THIS install, git or release, and offers the rerun
# menu instead of refusing) rather than duplicating any of that here.
cmd_setup() {
  local setup_bin="$HOME/.local/bin/serverjack-setup"
  [[ -x $setup_bin ]] || {
    echo "serverjack-setup is not installed (expected $setup_bin) -- run install.sh first, or from a checkout: bash bin/serverjack-setup" >&2
    exit 1
  }
  # Close fd 9 (with_lock's flock) before handing off: `exec` replaces this
  # process's image but keeps its open file descriptors, including
  # non-close-on-exec ones like fd 9 -- so without this, serverjack-setup
  # (and anything IT spawns, like the rerun menu's "1) update" running
  # `serverjack-ctl update`) would inherit it already locked. That child
  # then blocks in ITS OWN with_lock waiting for a lock only this same
  # process tree can release, while serverjack-setup waits on the child:
  # a guaranteed deadlock. serverjack-setup is expected to take the lock
  # itself, narrowly, around its own writes -- see its own comment.
  exec 9>&-
  exec "$setup_bin" "$@"
}

# -------------------------------------------------------------------- prune
cmd_prune() {
  while (( $# )); do
    case "$1" in
      --yes) YES=1 ;;
      *) echo "unknown option to prune: $1" >&2; exit 1 ;;
    esac
    shift
  done
  require_release_channel prune
  local cur_target prev d v
  cur_target=$(readlink -f "$CURRENT" 2>/dev/null || true)
  prev=$(previous_version)
  local -a doomed=()
  for d in "$RELEASES"/*/; do
    [[ -d $d ]] || continue
    v=$(basename "$d")
    [[ $(readlink -f "$d" 2>/dev/null || true) == "$cur_target" ]] && continue
    [[ -n $prev && $v == "$prev" ]] && continue
    doomed+=("$v")
  done
  if (( ${#doomed[@]} == 0 )); then
    say "Nothing to prune."
    return
  fi
  say "Will delete: ${doomed[*]}"
  ask_confirm "Delete ${#doomed[@]} release director$( [[ ${#doomed[@]} -eq 1 ]] && echo y || echo ies )?"
  for v in "${doomed[@]}"; do
    rm -rf "${RELEASES:?}/$v"
    echo "removed $RELEASES/$v"
  done
}

main() {
  local cmd=${1:-}
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    status)    cmd_status "$@" ;;
    versions)  cmd_versions "$@" ;;
    update)    with_lock cmd_update "$@" ;;
    rollback)  with_lock cmd_rollback "$@" ;;
    uninstall) with_lock cmd_uninstall "$@" ;;
    prune)     with_lock cmd_prune "$@" ;;
    setup)     with_lock cmd_setup "$@" ;;
    -h|--help|"") usage 0 ;;
    *) echo "unknown subcommand: $cmd" >&2; usage 1 >&2 ;;
  esac
}

# Guarded (not a bare `main "$@"`) so tests/ctl-health.sh can `source` this
# file -- with a fake systemctl/curl on PATH -- to call units_active()/
# wait_healthy() directly, without running the real subcommand dispatcher.
# Ordinary invocation (`bash serverjack-ctl ...` or the installed
# `serverjack-ctl ...`) is completely unaffected: $0 IS this file then.
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  main "$@"
fi
