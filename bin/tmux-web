APP_JS = r"""
(function () {
  'use strict';
  var TERM = window.SJ.term, cur = window.SJ.name, TITLE = window.SJ.title;
  var body = document.body, POP = body.classList.contains('popout');
  var frame = document.getElementById('frame'), tabs = document.getElementById('tabs');
  var pop = document.getElementById('pop'), err = document.getElementById('err');
  var isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || '') || /Mac OS X/.test(navigator.userAgent);
  var touch = matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

  // ---- terminal helpers (same-origin frame, so we can reach into ttyd's page)
  function tdoc() { try { return frame.contentDocument; } catch (e) { return null; } }
  function textarea() { var d = tdoc(); return d && d.querySelector('.xterm-helper-textarea'); }
  function focusTerm() {
    var tries = 0;
    (function f() { var ta = textarea(); if (ta) { ta.focus(); } else if (tries++ < 40) setTimeout(f, 100); })();
  }
  var KEYS = { Escape: 27, Tab: 9, ArrowUp: 38, ArrowDown: 40, ArrowLeft: 37, ArrowRight: 39,
               PageUp: 33, PageDown: 34, Enter: 13, Backspace: 8, Delete: 46, Home: 36, End: 35 };
  function sendKey(key, mods) {
    var ta = textarea(); if (!ta) return;
    mods = mods || {};
    var code = KEYS[key] || key.toUpperCase().charCodeAt(0);
    var init = { key: key, keyCode: code, which: code, bubbles: true, cancelable: true,
                 ctrlKey: !!mods.ctrl, shiftKey: !!mods.shift, altKey: !!mods.alt };
    var ev = new frame.contentWindow.KeyboardEvent('keydown', init);
    if (ev.keyCode !== code) {           // Safari ignores keyCode in the init dict
      Object.defineProperty(ev, 'keyCode', { get: function () { return code; } });
      Object.defineProperty(ev, 'which', { get: function () { return code; } });
    }
    ta.dispatchEvent(ev);
  }

  // ---- inside the frame: clipboard shortcuts + Ctrl-armed soft keys
  var ctrlArmed = false, swallowInput = false;
  function hook() {
    var d = tdoc(); if (!d || d.__sj) return; d.__sj = true;
    d.addEventListener('keydown', function (e) {
      if (!e.isTrusted) return;
      // Ctrl armed from the soft key row: next character goes as Ctrl+<char>
      if (ctrlArmed && e.key && e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
        e.preventDefault(); e.stopPropagation(); swallowInput = true;
        disarm(); sendKey(e.key.toLowerCase(), { ctrl: true }); return;
      }
      if (isMac || !e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
      // Windows/Linux: xterm.js only offers Ctrl+Shift+C/V. Make Ctrl+V paste
      // (stop xterm seeing it, so the browser's native paste fires xterm's
      // paste handler) and Ctrl+C copy when there is a selection, else SIGINT.
      if (e.key === 'v' || e.key === 'V') { e.stopPropagation(); return; }
      if (e.key === 'c' || e.key === 'C') {
        var copied = false;
        function seen(ev) { copied = ev.defaultPrevented; }   // xterm preventDefaults only when it copied a selection
        d.addEventListener('copy', seen);
        try { d.execCommand('copy'); } catch (_) {}
        d.removeEventListener('copy', seen);
        if (copied) { e.preventDefault(); e.stopPropagation(); }
      }
    }, true);
    // WebKit also fires keypress for Ctrl+V; xterm would turn it into ^V.
    d.addEventListener('keypress', function (e) {
      if (!isMac && e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey && (e.key === 'v' || e.key === 'V')) e.stopPropagation();
    }, true);
    d.addEventListener('beforeinput', function (e) {
      if (swallowInput) { e.preventDefault(); swallowInput = false; return; }
      if (ctrlArmed && e.inputType === 'insertText' && e.data && e.data.length === 1) {
        e.preventDefault(); disarm(); sendKey(e.data.toLowerCase(), { ctrl: true });
      }
    }, true);
  }
  // Feed text to the terminal exactly as a paste (xterm applies bracketed
  // paste when the app asked for it, so multi-line text is safe).
  function sendText(text) {
    var ta = textarea(), w = frame.contentWindow; if (!ta || !text) return false;
    try {
      var dt = new w.DataTransfer(); dt.setData('text/plain', text);
      var ev = new w.ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true });
      if (!ev.clipboardData) throw new Error('no clipboardData');
      ta.dispatchEvent(ev); return true;
    } catch (e) {
      // Older WebKit: InputEvent path (no bracketed paste, but text arrives)
      try { ta.dispatchEvent(new w.InputEvent('input', { data: text, inputType: 'insertText', bubbles: true })); return true; }
      catch (e2) { return false; }
    }
  }
  // Touch devices: stretch xterm's invisible textarea over the whole terminal
  // so touch-and-hold brings up the native Paste callout, and taps focus it.
  function touchCss() {
    var d = tdoc(); if (!d || !touch || d.getElementById('sj-touch')) return;
    var st = d.createElement('style'); st.id = 'sj-touch';
    // fixed + viewport units: the textarea's parent (.xterm-helpers) has no size, so % would collapse to 0
    st.textContent = '.xterm-helper-textarea{position:fixed!important;left:0!important;top:0!important;width:100vw!important;height:100vh!important;opacity:0!important;z-index:20!important;-webkit-user-select:text!important;user-select:text!important;caret-color:transparent}';
    (d.head || d.documentElement).appendChild(st);
  }
  frame.addEventListener('load', function () { hook(); touchCss(); focusTerm(); });

  // ---- soft key row
  var ctrlBtn = document.getElementById('ctrl');
  function disarm() { ctrlArmed = false; ctrlBtn.classList.remove('armed'); }
  function setKeys(on) { body.classList.toggle('keys', on); document.getElementById('keysbtn').classList.toggle('on', on);
    try { localStorage.setItem('sj-keys', on ? '1' : '0'); } catch (_) {} }
  var saved = null; try { saved = localStorage.getItem('sj-keys'); } catch (_) {}
  setKeys(saved === null ? touch : saved === '1');
  document.getElementById('keysbtn').onclick = function () { setKeys(!body.classList.contains('keys')); focusTerm(); };
  Array.prototype.forEach.call(document.querySelectorAll('#keys .k[data-k], #ctrl'), function (b) {
    b.addEventListener('pointerdown', function (e) {
      e.preventDefault();                       // keep focus (and the soft keyboard) on the terminal
      if (b.id === 'ctrl') { ctrlArmed = !ctrlArmed; ctrlBtn.classList.toggle('armed', ctrlArmed); return; }
      var mods = { ctrl: !!b.dataset.ctrl || ctrlArmed, shift: !!b.dataset.shift };
      if (ctrlArmed) disarm();
      sendKey(b.dataset.k, mods);
    });
  });

  // ---- Paste / Copy buttons and the compose bar
  var msg = document.getElementById('msg'), compose = document.getElementById('compose');
  function flash(btn, text) { var old = btn.textContent; btn.textContent = text; setTimeout(function () { btn.textContent = old; }, 1200); }
  document.getElementById('paste').addEventListener('pointerdown', function (e) { e.preventDefault(); });
  document.getElementById('paste').addEventListener('click', function () {
    var btn = this;
    if (!navigator.clipboard || !navigator.clipboard.readText) { msg.focus(); flash(btn, 'use box ↓'); return; }
    navigator.clipboard.readText().then(function (t) {
      if (!t) { flash(btn, 'empty'); return; }
      sendText(t); focusTerm();
    }).catch(function () { msg.focus(); flash(btn, 'use box ↓'); });   // denied: paste into the compose box instead
  });
  var screen = document.getElementById('screen'), screenText = document.getElementById('screen-text');
  function loadScreen() {
    return fetch('/api/screen?name=' + encodeURIComponent(cur) + '&lines=400', { cache: 'no-store' })
      .then(function (r) { return r.text(); })
      .then(function (t) {
        screenText.innerHTML = '';
        t.split('\n').forEach(function (line) {
          var d = document.createElement('div'); d.className = 'ln'; d.textContent = line || ' ';
          d.title = 'tap to copy this line';
          d.onclick = function () {
            var txt = line.trim(); if (!txt) return;
            var done = function () { d.classList.add('copied'); setTimeout(function () { d.classList.remove('copied'); }, 900); };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(done, function () {});
            else { var r = document.createRange(); r.selectNodeContents(d); var sel = getSelection(); sel.removeAllRanges(); sel.addRange(r); try { document.execCommand('copy'); done(); } catch (e) {} }
          };
          screenText.appendChild(d);
        });
        screenText.scrollTop = screenText.scrollHeight;
      });
  }
  document.getElementById('copy').addEventListener('pointerdown', function (e) { e.preventDefault(); });
  document.getElementById('copy').addEventListener('click', function () { screen.hidden = false; loadScreen(); });
  document.getElementById('screen-refresh').onclick = loadScreen;
  document.getElementById('screen-close').onclick = function () { screen.hidden = true; focusTerm(); };
  document.getElementById('screen-copy').onclick = function () {
    var btn = this;
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(screenText.textContent).then(function () { flash(btn, 'Copied'); }, function () { flash(btn, 'select text'); });
    else flash(btn, 'select text');
  };
  compose.onsubmit = function (e) {
    e.preventDefault();
    var t = msg.value;
    if (t) sendText(t);
    setTimeout(function () { sendKey('Enter'); }, t ? 60 : 0);   // let the paste land first
    msg.value = ''; msg.style.height = '';
    msg.focus();                                                 // keep chatting
  };
  msg.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); compose.requestSubmit ? compose.requestSubmit() : compose.onsubmit(e); }
  });
  msg.addEventListener('input', function () { msg.style.height = ''; msg.style.height = Math.min(msg.scrollHeight, 120) + 'px'; });

  // ---- iOS: the soft keyboard doesn't shrink the layout viewport, so track
  // the visual viewport and size the page to it (keeps the key row visible).
  if (window.visualViewport) {
    var vv = window.visualViewport;
    function fit() {
      if (Math.abs(window.innerHeight - vv.height) < 2 && vv.offsetTop === 0) { body.style.height = ''; body.style.top = ''; return; }
      body.style.height = vv.height + 'px'; body.style.top = vv.offsetTop + 'px';
    }
    vv.addEventListener('resize', fit); vv.addEventListener('scroll', fit);
  }

  // ---- session tabs
  function pageUrl(name) { return '/s/' + encodeURIComponent(name) + (POP ? '?popout=1' : ''); }
  function setUrl(name) { history.replaceState(null, '', pageUrl(name)); document.title = name + ' · ' + TITLE; }
  function switchTo(name) {
    if (name === cur) { focusTerm(); return; }
    cur = name;
    frame.src = TERM + '?arg=' + encodeURIComponent(name);
    setUrl(name); refresh();
  }
  function render(list) {
    tabs.innerHTML = '';
    var present = false;
    list.forEach(function (s) {
      if (s.name === cur) present = true;
      var b = document.createElement('button');
      b.className = 'tab' + (s.name === cur ? ' on' : '');
      b.textContent = s.name;
      b.title = s.cmd + ' · ' + s.path;
      b.onclick = function () { switchTo(s.name); };
      tabs.appendChild(b);
    });
    var on = tabs.querySelector('.on'); if (on) on.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    // current session gone (exited / killed elsewhere): move on instead of
    // sitting on a dead terminal
    if (!present && cur !== null) { if (list.length) { cur = null; switchTo(list[0].name); } else location.href = '/'; }
  }
  function refresh() {
    return fetch('/api/sessions', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(render).catch(function () {});
  }
  function syncKind() {
    var k = (pop.querySelector('input[name=kind]:checked') || {}).value || 'shell';
    pop.elements.name.required = (k !== 'shell');
    pop.elements.name.placeholder = (k === 'shell') ? 'auto (shell, shell-2, …)' : 'e.g. fit-app';
  }
  pop.addEventListener('change', syncKind); syncKind();
  document.getElementById('add').onclick = function () {
    pop.classList.toggle('open'); err.classList.remove('on');
    if (pop.classList.contains('open')) pop.elements.name.focus();
  };
  document.getElementById('kill').onclick = function () {
    if (!confirm('Kill session “' + cur + '”? Anything running in it is lost.')) return;
    var dead = cur; cur = null;
    fetch('/api/kill', { method: 'POST', body: new URLSearchParams({ name: dead }) })
      .then(function () { return fetch('/api/sessions', { cache: 'no-store' }); })
      .then(function (r) { return r.json(); })
      .then(function (list) { if (!list.length) { location.href = '/'; return; } switchTo(list[0].name); });
  };
  pop.onsubmit = function (e) {
    e.preventDefault(); err.classList.remove('on');
    fetch('/api/new', { method: 'POST', body: new URLSearchParams(new FormData(pop)) })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.error) { err.textContent = j.error; err.classList.add('on'); return; }
        pop.classList.remove('open'); pop.reset(); switchTo(j.name);
      })
      .catch(function () { err.textContent = 'request failed'; err.classList.add('on'); });
  };
  document.getElementById('popout').onclick = function () {
    // "popup" asks for a window without tabs/address bar (desktop browsers
    // honour it; phones open a tab). Named so a second click refocuses it.
    var w = window.open('/s/' + encodeURIComponent(cur) + '?popout=1', TITLE + '-' + cur, 'popup=yes,width=960,height=620');
    if (w) w.focus();
  };
  document.getElementById('handle').onclick = function () {
    body.classList.toggle('showbar');
    if (!body.classList.contains('showbar')) { pop.classList.remove('open'); focusTerm(); }
  };
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') pop.classList.remove('open'); });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
  setInterval(refresh, 15000);
  refresh(); hook(); touchCss(); focusTerm();
})();
"""


def esc(s):
    return html.escape(str(s), quote=True)


def term_href(name):                 # the wrapper page with the menu bar
    return f"/s/{quote(name, safe='')}"


def ttyd_src(name):                  # what the wrapper's frame loads
    return f"{TERM_PATH}?arg={quote(name, safe='')}"


def kind_options():
    return "\n".join(
        f'<label><input type="radio" name="kind" value="{esc(k)}"{" checked" if i == 0 else ""}><span>{esc(label)}</span></label>'
        for i, (k, (_, label)) in enumerate(TOOLS.items()))


def dir_options():
    return "\n".join(
        f'<option value="{esc(d)}">{esc(d.replace(HOME, "~", 1))}</option>'
        for d in dir_choices())


def render(error=None, name="", dir_custom="", cmd="", sc_label="", sc_cmd="", addsc_open=False):
    sess = sessions()
    if sess:
        cards = "\n".join(SESSION_CARD.format(
            on=" on" if s["attached"] else "", name=esc(s["name"]), cmd=esc(s["cmd"]),
            path=esc(s["path"]),
            windows=f"{s['windows']} window{'s' if s['windows'] != 1 else ''}",
            ago=ago(s["created"]),
            attached=" &middot; attached" if s["attached"] else "",
            href=esc(term_href(s["name"])),
        ) for s in sess)
    else:
        cards = '<div class="empty">No sessions running. Start one below.</div>'
    scs = load_shortcuts()
    if scs:
        shortcuts = "\n".join(SHORTCUT_CARD.format(
            id=esc(x["id"]), label=esc(x.get("label") or x["cmd"]), cmd=esc(x["cmd"]),
            dir=esc((x.get("dir") or HOME).replace(HOME, "~", 1))) for x in scs)
    else:
        shortcuts = '<div class="empty">None yet. A shortcut starts a new session and runs a command in one tap.</div>'
    err = f'<div class="err">{esc(error)}</div>' if error else ""
    return PAGE.format(css=CSS, error=err, sessions=cards, shortcuts=shortcuts, dirs=dir_options(),
                       kinds=kind_options(), title=esc(TITLE), name=esc(name), dir_custom=esc(dir_custom),
                       cmd=esc(cmd), sc_label=esc(sc_label), sc_cmd=esc(sc_cmd),
                       addsc_open=" open" if addsc_open else "")


def render_term(name, popout=False):
    return TERM_PAGE.format(
        name=esc(name), src=esc(ttyd_src(name)), dirs=dir_options(), kinds=kind_options(),
        title=esc(TITLE),
        term_path_json=json.dumps(TERM_PATH), name_json=json.dumps(name), title_json=json.dumps(TITLE),
        body_class=' class="popout"' if popout else "")


# --- PWA bits: manifest + icons (so "Add to Home Screen" on iOS / "Install"
# on desktop opens it standalone, with no browser chrome at all).

MANIFEST = {
    "name": f"{TITLE} terminal", "short_name": TITLE,
    "start_url": "/", "scope": "/", "display": "standalone",
    "background_color": "#0f1115", "theme_color": "#0f1115",
    "icons": [{"src": "/icon.svg", "sizes": "any", "type": "image/svg+xml"},
              {"src": "/icon-180.png", "sizes": "180x180", "type": "image/png"}],
}

ICON_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
            '<rect width="64" height="64" rx="12" fill="#0f1115"/>'
            '<path d="M16 20l14 12-14 12" fill="none" stroke="#3fb950" stroke-width="6" '
            'stroke-linecap="round" stroke-linejoin="round"/>'
            '<rect x="34" y="40" width="16" height="6" rx="3" fill="#e6e6e6"/></svg>')


def icon_png(size=180):
    """Same glyph as ICON_SVG, rasterised with stdlib only (iOS wants PNG)."""
    import struct, zlib
    bg, green, white = (15, 17, 21), (63, 185, 80), (230, 230, 230)
    px = [[bg] * size for _ in range(size)]
    u = size / 64.0
    # chevron: two thick strokes from (16,20)->(30,32)->(16,44), width ~6
    def seg(x0, y0, x1, y1, w, col):
        w *= u
        for y in range(size):
            for x in range(size):
                X, Y = x / u, y / u
                dx, dy = x1 - x0, y1 - y0
                t = max(0.0, min(1.0, ((X - x0) * dx + (Y - y0) * dy) / (dx * dx + dy * dy)))
                d = ((X - (x0 + t * dx)) ** 2 + (Y - (y0 + t * dy)) ** 2) ** 0.5
                if d * u <= w / 2:
                    px[y][x] = col
    seg(16, 20, 30, 32, 6, green)
    seg(30, 32, 16, 44, 6, green)
    for y in range(int(40 * u), int(46 * u)):
        for x in range(int(34 * u), int(50 * u)):
            px[y][x] = white
    raw = b"".join(b"\x00" + bytes(c for p in row for c in p) for row in px)
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


ICON_PNG = icon_png()


# --------------------------------------------------------------- server ----

class Handler(BaseHTTPRequestHandler):
    server_version = "tmux-web/1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def send_html(self, body, status=200):
        data = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, location):
        self.send_response(303)
        self.send_header("Location", location)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def send_bytes(self, data, ctype, status=200, cache=True):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "public, max-age=86400" if cache else "no-store")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, status=200):
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            return self.send_html(render())
        if path.startswith("/s/"):
            name = unquote(path[3:])
            if not session_exists(name):
                return self.send_html(render(f"No session called “{name}” (it may have exited)."), 404)
            popout = "popout" in parse_qs(urlparse(self.path).query)
            return self.send_html(render_term(name, popout))
        if path == "/app.js":
            return self.send_bytes(APP_JS.encode(), "application/javascript; charset=utf-8", cache=False)
        if path == "/manifest.webmanifest":
            return self.send_bytes(json.dumps(MANIFEST).encode(), "application/manifest+json")
        if path == "/icon.svg":
            return self.send_bytes(ICON_SVG.encode(), "image/svg+xml")
        if path == "/icon-180.png":
            return self.send_bytes(ICON_PNG, "image/png")
        if path == "/api/sessions":
            return self.send_json(sessions())
        if path == "/api/screen":
            q = parse_qs(urlparse(self.path).query)
            name = (q.get("name") or [""])[0]
            if not session_exists(name):
                return self.send_bytes(b"", "text/plain; charset=utf-8", 404, cache=False)
            text = screen_text(name, min(int((q.get("lines") or ["300"])[0]), 5000))
            return self.send_bytes(text.rstrip("\n").encode(), "text/plain; charset=utf-8", cache=False)
        if path == "/healthz":
            return self.send_html("ok")
        self.send_html("<h1>404</h1>", 404)

    def same_site(self):
        # Cross-site form posts (from a page you happened to open elsewhere)
        # must not be able to create or kill sessions.
        sfs = self.headers.get("Sec-Fetch-Site")
        if sfs:                                   # every current browser sends it
            return sfs in ("same-origin", "none")
        origin = self.headers.get("Origin")       # older browsers: compare hosts
        if origin:
            host = self.headers.get("X-Forwarded-Host") or self.headers.get("Host", "")
            return urlparse(origin).netloc.lower() == host.lower()
        return True

    def form(self):
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(min(n, 65536)).decode(errors="replace")
        return {k: v[0] for k, v in parse_qs(raw).items()}

    def new_from_form(self, f):
        """Validate + create. Returns (name, error)."""
        kind = f.get("kind", "shell")
        if kind not in TOOLS:
            return None, "Unknown session type."
        name, err = validate_name(f.get("name", ""), required=(kind != "shell"), base="shell")
        if err:
            return None, err
        cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
        if err:
            return name, err
        err = create_session(kind, name, cwd, command=f.get("cmd") if kind == "shell" else None)
        return name, err

    def do_POST(self):
        path = urlparse(self.path).path
        if not self.same_site():
            if path.startswith("/api/"):
                return self.send_json({"error": "cross-site request refused"}, 403)
            return self.send_html("<h1>403</h1>cross-site request refused", 403)
        f = self.form()

        if path == "/new":                       # landing-page form
            name, err = self.new_from_form(f)
            if err:
                return self.send_html(render(err, f.get("name", ""), f.get("dir_custom", ""), f.get("cmd", "")), 400)
            return self.redirect(term_href(name))

        if path == "/api/new":                   # menu bar
            name, err = self.new_from_form(f)
            if err:
                return self.send_json({"error": err}, 400)
            return self.send_json({"ok": True, "name": name})

        if path in ("/kill", "/api/kill"):
            name = f.get("name", "")
            if name and session_exists(name):
                tmux("kill-session", "-t", f"={name}")
            if path == "/api/kill":
                return self.send_json({"ok": True})
            return self.redirect("/")

        if path == "/shortcuts/add":
            cmd = f.get("cmd", "").strip()
            if not cmd:
                return self.send_html(render("A shortcut needs a command.", sc_label=f.get("label", ""), addsc_open=True), 400)
            cwd, err = resolve_dir(f.get("dir"), f.get("dir_custom"))
            if err:
                return self.send_html(render(err, sc_label=f.get("label", ""), sc_cmd=cmd, addsc_open=True), 400)
            add_shortcut(f.get("label", ""), cmd, cwd)
            return self.redirect("/")

        if path == "/shortcuts/del":
            sid = f.get("id", "")
            save_shortcuts([x for x in load_shortcuts() if x["id"] != sid])
            return self.redirect("/")

        if path == "/shortcuts/run":
            sid = f.get("id", "")
            sc = next((x for x in load_shortcuts() if x["id"] == sid), None)
            if not sc:
                return self.send_html(render("That shortcut no longer exists."), 404)
            cwd = sc.get("dir") or HOME
            if not os.path.isdir(cwd):
                return self.send_html(render(f"Shortcut directory is gone: {cwd}"), 400)
            name = auto_name(sc.get("label") or "shortcut")
            err = create_session("shell", name, cwd, command=sc["cmd"])
            if err:
                return self.send_html(render(err), 500)
            return self.redirect(term_href(name))

        self.send_html("<h1>404</h1>", 404)


if __name__ == "__main__":
    srv = ThreadingHTTPServer(BIND, Handler)
    sys.stderr.write(f"tmux-web listening on http://{BIND[0]}:{BIND[1]}  title={TITLE!r} dirs={DIR_ROOTS} tools={list(TOOLS)}\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
