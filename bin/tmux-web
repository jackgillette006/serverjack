/* pop-out mode: bar hidden behind a corner handle */
#handle{{display:none;position:absolute;top:6px;right:6px;z-index:10;width:28px;height:22px;border:0;
  border-radius:6px;background:rgba(23,26,33,.75);color:var(--mut);font:inherit;cursor:pointer}}
#handle:hover{{color:var(--fg)}}
