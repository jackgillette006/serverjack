"""tmux-web: a phone-friendly web front end for your tmux sessions.

    https://<host>/        -> this app (default 127.0.0.1:7680)
    https://<host>/term/   -> ttyd      (default 127.0.0.1:7681)

The landing page lists tmux sessions with an Open button each, and a form to
start a plain shell or a coding tool (Claude Code, Codex, ... configurable)
in a chosen directory. Opening a session goes to /s/<name>: a slim menu bar
(session tabs, + new, x close, pop-out, soft keys for phones) over ttyd in a
frame at /term/?arg=<name>; ttyd runs bin/tmux-attach.sh with that argument,
which attaches. The terminal only ever appears once you are inside a session.

Stdlib only, no dependencies. Runs as your user and talks to your normal tmux
server, so it sees the same sessions as any other login.

Configuration is by environment variables (see install.sh / README):
    TMUX_WEB_PORT   listen port (127.0.0.1 only)          default 7680
    TMUX_WEB_TITLE  page title                             default hostname
    TMUX_WEB_DIRS   colon-separated dirs offered for new sessions
    TMUX_WEB_TOOLS  "cmd=Label,cmd=Label" coding tools     default claude,codex
    TMUX_WEB_TERM   URL path where ttyd is mounted         default /term/

Security: NO authentication of its own. Anyone who can reach it gets a shell
as the user it runs as. Only expose it through something that authenticates
(tailscale serve, an SSO reverse proxy, a VPN). State-changing POSTs are
refused when the browser says they came from another site (Sec-Fetch-Site /
Origin), so a random web page can't drive it from a logged-in browser.
"""

import html
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, unquote, urlparse

HOME = os.path.expanduser("~")
BIND = ("127.0.0.1", int(os.environ.get("TMUX_WEB_PORT", "7680")))
TITLE = os.environ.get("TMUX_WEB_TITLE") or socket.gethostname().split(".")[0]
TERM_PATH = os.environ.get("TMUX_WEB_TERM", "/term/")
if not TERM_PATH.endswith("/"):
    TERM_PATH += "/"          # ttyd builds its ws URL relative to the page path


def _dirs():
    raw = os.environ.get("TMUX_WEB_DIRS") or "~/projects:~/src:~/workspace:~"
    out = []
    for d in raw.split(":"):
        d = os.path.expanduser(d.strip())
        if d and os.path.isdir(d) and d not in out:
            out.append(d)
    if HOME not in out:
        out.insert(0, HOME)
    return out


def _tools():
    raw = os.environ.get("TMUX_WEB_TOOLS", "claude=Claude Code,codex=Codex")
    tools = {"shell": (None, "Shell")}
    for item in raw.split(","):
        if "=" in item:
            cmd, label = item.split("=", 1)
        else:
            cmd, label = item, item
        cmd = cmd.strip()
        if cmd and cmd != "shell":
            tools[cmd] = (cmd, label.strip() or cmd)
    return tools


DIR_ROOTS = _dirs()
TOOLS = _tools()
CONFIG_DIR = os.environ.get("TMUX_WEB_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config", "tmux-web")
SHORTCUTS_FILE = os.path.join(CONFIG_DIR, "shortcuts.json")               # kind -> (command, label); kind is also the form value
PATH_ENV = os.environ.get("PATH") or f"{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"


# ----------------------------------------------------------------- tmux ----

def tmux(*args, check=False):
    return subprocess.run(
        ["tmux", *args], capture_output=True, text=True, check=check,
        env={**os.environ, "PATH": PATH_ENV},
    )


def sessions():
    fmt = "\t".join([
        "#{session_name}", "#{session_windows}", "#{session_attached}",
        "#{session_created}", "#{pane_current_command}", "#{pane_current_path}",
    ])
    r = tmux("list-sessions", "-F", fmt)
    out = []
    if r.returncode != 0:
        return out                       # no server running: no sessions
    for line in r.stdout.splitlines():
        name, windows, attached, created, cmd, path = (line.split("\t") + [""] * 6)[:6]
        out.append({
            "name": name, "windows": int(windows or 0),
            "attached": attached not in ("", "0"),
            "created": int(created or 0), "cmd": cmd,
            "path": path.replace(HOME, "~", 1),
        })
    return out


def screen_text(name, lines=300):
    """Plain text of the session's active pane, last <lines> lines, wrapped
    lines joined. Used by the phone 'Copy' view where native selection works."""
    r = tmux("capture-pane", "-p", "-J", "-t", f"={name}:", "-S", f"-{int(lines)}")  # "=name:" = exact session, its current pane
    return r.stdout if r.returncode == 0 else ""


def session_exists(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


def auto_name(base="shell"):
    """First free name: base, base-2, base-3 ..."""
    base = re.sub(r"[^A-Za-z0-9_-]+", "-", base).strip("-") or "shell"
    if not session_exists(base):
        return base
    n = 2
    while session_exists(f"{base}-{n}"):
        n += 1
    return f"{base}-{n}"


def validate_name(name, required=True, base="shell"):
    name = name.strip()
    if not name:
        if required:
            return None, "Give the session a name."
        return auto_name(base), None
    if any(c in name for c in ":.\t\n") or len(name) > 60:
        return None, "Session names can't contain ':' or '.' (tmux rule) or be longer than 60 chars."
    if session_exists(name):
        return None, f"A session called “{name}” already exists. Open it instead."
    return name, None


def resolve_dir(dir_choice, dir_custom):
    d = (dir_custom or "").strip() or (dir_choice or "").strip() or HOME
    d = os.path.expanduser(d)
    if not os.path.isabs(d):
        d = os.path.join(HOME, d)
    d = os.path.realpath(d)
    if not os.path.isdir(d):
        return None, f"No such directory: {d}"
    return d, None


def create_session(kind, name, cwd, command=None):
    """kind: 'shell' or a tool key from TOOLS. command: for shells, a command
    line to run first (the user typed it; it IS meant to be executed)."""
    cmd, label = TOOLS[kind]
    args = ["new-session", "-d", "-s", name, "-c", cwd, "-e", f"PATH={PATH_ENV}"]
    if cmd:
        # Tool first, then a login shell in the same dir, so a missing or
        # logged-out tool leaves its error on screen instead of the session
        # vanishing before you can read it.
        q = shlex.quote(cmd)
        args += ["-n", cmd,
                 f'{q}; rc=$?; echo; echo "[{cmd} exited with status $rc]"; exec bash -l']
    elif command and command.strip():
        # Passed via the environment, not interpolated: no quoting games.
        args += ["-e", "TMUX_WEB_CMD=" + command.strip(),
                 'printf "\\$ %s\\n" "$TMUX_WEB_CMD"; bash -lc "$TMUX_WEB_CMD"; rc=$?; echo; echo "[exited with status $rc]"; exec bash -l']
    r = tmux(*args)
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip() or "tmux new-session failed"
    return None


# ---------- shortcuts: user-defined one-click commands, stored as JSON

def load_shortcuts():
    try:
        with open(SHORTCUTS_FILE) as f:
            data = json.load(f)
        return [x for x in data if isinstance(x, dict) and x.get("id") and x.get("cmd")]
    except (OSError, ValueError):
        return []


def save_shortcuts(items):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = SHORTCUTS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(items, f, indent=2)
    os.replace(tmp, SHORTCUTS_FILE)


def add_shortcut(label, cmd, cwd):
    label = label.strip() or cmd.strip().split()[0]
    items = load_shortcuts()
    sid = f"{int(time.time())}-{len(items)}"
    items.append({"id": sid, "label": label[:60], "cmd": cmd.strip(), "dir": cwd})
    save_shortcuts(items)


def dir_choices():
    seen = []
    for root in DIR_ROOTS:
        if os.path.isdir(root) and root not in seen:
            seen.append(root)
        try:
            for e in sorted(os.scandir(root), key=lambda e: e.name.lower()):
                if e.is_dir() and not e.name.startswith(".") and e.path not in seen:
                    seen.append(e.path)
        except OSError:
            pass
    return seen


def ago(ts):
    if not ts:
        return ""
    s = int(time.time()) - ts
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit} ago"
    return "just now"


