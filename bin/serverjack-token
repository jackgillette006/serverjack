#!/usr/bin/env python3
"""Terminal-token helper for bin/tmux-attach.sh.

The token for a tmux session is HMAC-SHA256(secret, name)[:32], where the
secret is the 32 random bytes bin/serverjack wrote to <runtime dir>/secret on
its first start. The runtime dir is derived exactly as it is in shell:

    ${XDG_RUNTIME_DIR:-/tmp/serverjack-$(id -u)}/serverjack

bin/tmux-attach.sh requires a valid token for every attach, with or without
SERVERJACK_ALLOW: ttyd cannot tell who is on the other end of its socket, so
this is what separates a URL the page handed out from one somebody typed.

Usage:
    serverjack-token <name>            print the token for <name>
    serverjack-token <name> <token>    exit 0 if it matches, 1 if it does not

No secret file means no token can be valid, so verification fails closed.
"""
import hashlib
import hmac
import os
import sys


def token(name):
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp/serverjack-%d" % os.getuid()
    with open(os.path.join(base, "serverjack", "secret"), "rb") as f:
        secret = f.read().strip()
    if not secret:
        raise OSError("empty secret")
    return hmac.new(secret, name.encode(), hashlib.sha256).hexdigest()[:32]


if __name__ == "__main__":
    if not 2 <= len(sys.argv) <= 3:
        sys.exit(__doc__)
    try:
        want = token(sys.argv[1])
    except OSError:
        sys.exit(1)
    if len(sys.argv) == 2:
        print(want)
        sys.exit(0)
    sys.exit(0 if hmac.compare_digest(want, sys.argv[2]) else 1)
