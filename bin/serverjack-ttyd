#!/usr/bin/env bash
# What the serverjack-ttyd user unit runs. It only exists to prepare the socket
# before exec'ing ttyd; the unit supplies the environment
# (EnvironmentFile=~/.config/serverjack/env).
#
# ttyd ALWAYS listens on <runtime dir>/ttyd.sock and nothing else. It has no
# notion of a user and cannot tell who is on the other end of its socket, so it
# is never exposed directly: the socket lives inside a 0700 directory only this
# account can enter, and bin/serverjack reverse-proxies SERVERJACK_TERM
# (default /term/) to it -- after its own peer-uid, Host and SERVERJACK_ALLOW
# checks. SERVERJACK_LISTEN describes how bin/serverjack listens; it has
# nothing to say about this file.
#
# ttyd flags, unchanged from when they lived in the unit file:
#   -W  writable (ttyd >= 1.7 is read-only by default)
#   -a  pass ?arg=... from the URL to tmux-attach.sh -- serverjack sends one,
#       the session name
#   -O  refuse WebSockets from other origins (cross-site hijack guard). The
#       proxy forwards Host and Origin verbatim so this still compares the
#       names the browser used.
# reconnect stays ON: phones drop the socket on screen lock; ttyd re-attaches.
#
# The terminal's color theme is NOT set here. bin/serverjack builds it from
# its own TOKENS (_term_theme()) and passes it as ?theme=<json> on the iframe
# URL it points at this ttyd (ttyd_src()) -- the client applies a URL
# query's theme last, after anything -t sent it, so it would otherwise
# always win over a -t theme=... in TTYD_EXTRA_ARGS below. bin/serverjack
# detects one there (_ttyd_extra_args_has_theme()) and skips its own theme
# in that case, so this file's -t theme=... is what actually applies.
# Keeping the default theme out of this file means there is exactly one
# place the colors are written down. SERVERJACK_TERM_THEME (README's config
# table) opts out, read in bin/serverjack, not here.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")

# A directory that must be ours before a shell-granting socket goes in it: a
# real directory, not a symlink, owned by us, mode 0700. Same rule as
# bin/serverjack's safe_dir(). Fails closed -- another account owning this path
# means it owns the socket.
check_dir() {
  local d=$1 what=$2 owner mode
  [[ -L $d ]] && { echo "serverjack-ttyd: $what $d is a symlink -- refusing" >&2; exit 1; }
  [[ -d $d ]] || { echo "serverjack-ttyd: $what $d is not a directory -- refusing" >&2; exit 1; }
  read -r owner mode < <(stat -c '%u %a' "$d") || {
    echo "serverjack-ttyd: cannot stat $what $d" >&2; exit 1; }
  [[ $owner == "$(id -u)" ]] || {
    echo "serverjack-ttyd: $what $d is owned by uid $owner, not $(id -u) -- refusing" >&2; exit 1; }
  if [[ $mode != 700 ]]; then
    chmod 700 "$d" || { echo "serverjack-ttyd: $what $d is mode $mode, not 0700" >&2; exit 1; }
    read -r owner mode < <(stat -c '%u %a' "$d")
    [[ $mode == 700 ]] || { echo "serverjack-ttyd: $what $d is mode $mode, not 0700" >&2; exit 1; }
  fi
}

# Same expression as bin/serverjack's runtime_dir() and tmux-attach.sh. NOT a
# systemd RuntimeDirectory=: that would delete the directory (and the landing
# page's socket) whenever this unit stops.
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
  base=$XDG_RUNTIME_DIR
else
  # /tmp is world-writable, so the fallback parent is checked too: whoever wins
  # the race to create /tmp/serverjack-<uid> would own the socket directory.
  base=/tmp/serverjack-$(id -u)
  # -m on `mkdir -p` only applies to the deepest directory it creates
  # (SC2174) -- irrelevant here since /tmp already exists and only $base
  # itself is new, but chmod after is explicit instead of relying on that.
  mkdir -p "$base" && chmod 700 "$base"
  check_dir "$base" "runtime dir parent"
fi
RUNTIME=$base/serverjack
mkdir -p "$RUNTIME" && chmod 700 "$RUNTIME"
check_dir "$RUNTIME" "runtime dir"

sock=$RUNTIME/ttyd.sock
if [[ -e $sock || -L $sock ]]; then
  # Never let a path substitution turn startup into an arbitrary-file unlink.
  # A symlink is refused even when it happens to resolve to a socket.
  [[ -S $sock && ! -L $sock ]] || {
    echo "serverjack-ttyd: $sock exists and is not a socket -- refusing to remove it" >&2
    exit 1
  }
  rm -f -- "$sock"                   # stale socket from a hard kill
fi

# fontSize was tried too (ttyd's built-in default of 13 is smaller than
# xterm.js's own default of 15, and reads small on a phone) but a bigger
# font shrinks the terminal's row/column grid, and that broke mouse-drag
# text selection (tests/pwtest.py's "Ctrl+C with selection copies" started
# failing at 15px -- passed again with the override removed): a real
# regression, not just a cosmetic risk, so it's left at ttyd's default.

# TTYD_EXTRA_ARGS is a convenience string in the systemd EnvironmentFile, not
# shell code. Parse shell-style quoting without eval or expansion, then accept
# only display/resource options which cannot replace the private listener,
# authentication, origin check, writable mode or command. Keep every parsed
# word as one argv element.
extra=()
if [[ -n ${TTYD_EXTRA_ARGS:-} ]]; then
  args_file=$(mktemp "$RUNTIME/.ttyd-args.XXXXXX")
  if ! TTYD_EXTRA_ARGS=$TTYD_EXTRA_ARGS python3 -c \
      'import os, shlex, sys
try:
    words = shlex.split(os.environ["TTYD_EXTRA_ARGS"], posix=True)
except ValueError as exc:
    print(f"serverjack-ttyd: malformed TTYD_EXTRA_ARGS: {exc}", file=sys.stderr)
    raise SystemExit(2)
for word in words:
    sys.stdout.buffer.write(word.encode() + b"\0")' > "$args_file"; then
    rm -f -- "$args_file"
    exit 1
  fi
  mapfile -d '' -t words < "$args_file"
  rm -f -- "$args_file"

  i=0
  while (( i < ${#words[@]} )); do
    option=${words[i]}
    case $option in
      -t|--client-option|-T|--terminal-type|-m|--max-clients|-P|--ping-interval)
        (( i + 1 < ${#words[@]} )) || {
          echo "serverjack-ttyd: $option in TTYD_EXTRA_ARGS needs a value" >&2
          exit 1
        }
        value=${words[i+1]}
        [[ $value != -* ]] || {
          echo "serverjack-ttyd: $option in TTYD_EXTRA_ARGS needs a value" >&2
          exit 1
        }
        extra+=("$option" "$value")
        i=$((i + 2))
        ;;
      --client-option=*|--terminal-type=*|--max-clients=*|--ping-interval=*)
        value=${option#*=}
        [[ -n $value ]] || {
          echo "serverjack-ttyd: ${option%%=*} in TTYD_EXTRA_ARGS needs a value" >&2
          exit 1
        }
        extra+=("$option")
        i=$((i + 1))
        ;;
      *)
        echo "serverjack-ttyd: unsafe or unsupported TTYD_EXTRA_ARGS option: $option" >&2
        echo "serverjack-ttyd: allowed: -t/--client-option, -T/--terminal-type, -m/--max-clients, -P/--ping-interval" >&2
        exit 1
        ;;
    esac
  done
fi

exec ttyd -i "$sock" -W -a -O \
  -t "titleFixed=${SERVERJACK_TITLE:-serverjack}" -t disableLeaveAlert=true \
  "${extra[@]}" "$here/tmux-attach.sh"
