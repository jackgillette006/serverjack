[Unit]
Description=serverjack terminal (ttyd on a private Unix socket; attaches to the tmux session named in the URL)
Documentation=https://github.com/jackgillette006/serverjack
After=network.target

[Service]
EnvironmentFile=%h/.config/serverjack/env
# The wrapper picks the Unix socket (default) or 127.0.0.1:$TTYD_PORT from
# SERVERJACK_LISTEN and keeps the ttyd flags; see bin/serverjack-ttyd. It also
# creates the runtime dir 0700 -- deliberately NOT systemd's RuntimeDirectory=,
# which would delete the directory, and the landing page's socket in it,
# whenever this unit stops.
ExecStart=@REPO@/bin/serverjack-ttyd
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
KillMode=process

[Install]
WantedBy=default.target
