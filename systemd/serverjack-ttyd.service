[Unit]
Description=serverjack terminal (ttyd on a private Unix socket; attaches to the tmux session named in the URL)
Documentation=https://github.com/jackgillette006/serverjack
After=network.target
# See the matching comment in serverjack.service: no start-limit window, so
# a crash-looping broken release never leaves this unit rate-limited once a
# good release is restored.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/serverjack/env
# The wrapper binds ttyd to <runtime dir>/ttyd.sock -- always, never a port --
# and keeps the ttyd flags; see bin/serverjack-ttyd. bin/serverjack proxies
# SERVERJACK_TERM to that socket. The wrapper also creates the runtime dir 0700
# (and refuses an unsafe one) -- deliberately NOT systemd's RuntimeDirectory=,
# which would delete the directory, and the landing page's socket in it,
# whenever this unit stops.
ExecStart="@REPO@/bin/serverjack-ttyd"
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
KillMode=process
# The page process shares this cgroup with every tmux session and coding
# agent started through it (KillMode=process keeps them alive on restart).
# Those agents can be memory-hungry; the systemd default OOMPolicy=stop would
# tear down this whole unit -- cleanly, so Restart=on-failure would NOT bring
# it back -- the moment the kernel OOM-killed any one of them. Keep the front
# door up when a child is OOM-killed; if this unit's own main process is the
# one killed, that is still a failure and Restart handles it.
OOMPolicy=continue

[Install]
WantedBy=default.target
