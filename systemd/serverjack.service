[Unit]
Description=serverjack: tmux sessions, shortcuts, coding agents and the terminal itself (private socket or localhost port; publish via tailscale serve or an authenticating proxy)
Documentation=https://github.com/jackgillette006/serverjack
# autostart.json can bring up agent servers that want the network the moment
# they start (they phone home for a pairing QR), so wait for it at boot. The
# page itself needs nothing but tmux; the autostart run is delayed on top of
# this by SERVERJACK_AUTOSTART_DELAY (15s).
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/serverjack/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 "@REPO@/bin/serverjack"
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
# If the browser is the first thing to create a tmux session after boot, the
# tmux server is spawned inside this unit's cgroup. Only ever kill our own
# process on stop/restart, never the tmux server and every session in it.
KillMode=process

[Install]
WantedBy=default.target
