[Unit]
Description=serverjack: tmux sessions, shortcuts, coding agents and the terminal itself (private socket or localhost port; publish via tailscale serve or an authenticating proxy)
Documentation=https://github.com/jackgillette006/serverjack
# autostart.json can bring up agent servers that want the network the moment
# they start (they phone home for a pairing QR), so wait for it at boot. The
# page itself needs nothing but tmux; the autostart run is delayed on top of
# this by SERVERJACK_AUTOSTART_DELAY (15s).
After=network-online.target
Wants=network-online.target
# No start-limit window: a broken release that crash-loops on activation
# (Restart=on-failure, RestartSec=3) must not leave this unit refusing to
# start ("start of the service was attempted too often") once a GOOD
# release is swapped back in by serverjack-ctl's auto-rollback. serverjack-ctl
# used to work around systemd's default StartLimitBurst with `systemctl
# --user reset-failed` after every restore; this removes the need for that.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/serverjack/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 "@REPO@/bin/serverjack"
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
# If the browser is the first thing to create a tmux session after boot, the
# tmux server is spawned inside this unit's cgroup. Only ever kill our own
# process on stop/restart, never the tmux server and every session in it.
KillMode=process
# The page process shares this cgroup with every tmux session and coding
# agent started through it (KillMode=process keeps them alive on restart).
# Those agents can be memory-hungry; the systemd default OOMPolicy=stop would
# tear down this whole unit -- cleanly, so Restart=on-failure would NOT bring
# it back -- the moment the kernel OOM-killed any one of them. Keep the front
# door up when a child is OOM-killed; if this unit's own main process is the
# one killed, that is still a failure and Restart handles it.
OOMPolicy=continue

[Install]
WantedBy=default.target
